<div class="zd-cart-drawer" data-cart-drawer aria-hidden="true">
  <div class="zd-cart-drawer__overlay" data-cart-close></div>

  <aside class="zd-cart-drawer__panel">
    <div class="zd-cart-drawer__header">
      <h2>Your Cart</h2>
      <button type="button" data-cart-close>×</button>
    </div>

    <div class="zd-cart-drawer__body" data-cart-drawer-body>
      {% assign real_cart_count = 0 %}

{% for item in cart.items %}
  {% if item.product.handle == 'custom-goal-grower-support' %}
    {% assign real_cart_count = real_cart_count | plus: 1 %}
  {% else %}
    {% assign real_cart_count = real_cart_count | plus: item.quantity %}
  {% endif %}
{% endfor %}

{{ real_cart_count }}
      {% else %}
        <div class="zd-cart-drawer__empty">
          <h3>Your cart is empty.</h3>
          <p>Explore curated tools for focus, growth, and intentional living.</p>
        </div>
      {% endif %}
    </div>

    <div class="zd-cart-drawer__footer">
      <div class="zd-cart-drawer__subtotal">
        <span>Subtotal</span>
        <strong>{{ cart.total_price | money }}</strong>
      </div>

      <a href="{{ routes.cart_url }}" class="zd-cart-drawer__view">View Cart</a>
      <a href="/checkout" class="zd-cart-drawer__checkout">Checkout</a>
      <a href="/collections/all" class="zd-cart-drawer__continue">Continue Shopping</a>
    </div>
  </aside>
</div>