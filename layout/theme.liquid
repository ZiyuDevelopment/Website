<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">

  {{ content_for_header }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap" rel="stylesheet">

  {{ 'base.css' | asset_url | stylesheet_tag }}
</head>

<body class="bg-surface text-on-surface font-body-md overflow-x-hidden">

  {% render 'site-header' %}

  <main>
    {{ content_for_layout }}
  </main>

  {% render 'site-footer' %}

</body>
</html>