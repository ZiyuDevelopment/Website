    {{ 'page-beta.css' | asset_url | stylesheet_tag }}
    {{ 'page-about.css' | asset_url | stylesheet_tag }}
    {{ 'page-build-in-public.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}

    <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>

  <body>
    {% section 'header' %}

    <main id="MainContent">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}
    <script src="{{ 'header.js' | asset_url }}" defer></script>
    <script src="{{ 'faq.js' | asset_url }}" defer></script>
  </body>
</html>