    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page_title }}{% if shop.name %} | {{ shop.name }}{% endif %}</title>

    {{ 'header.css' | asset_url | stylesheet_tag }}
    {{ 'footer.css' | asset_url | stylesheet_tag }}
    {{ 'home.css' | asset_url | stylesheet_tag }}
    {{ 'page-start-here.css' | asset_url | stylesheet_tag }}
    {{ 'page-projects.css' | asset_url | stylesheet_tag }}
    {{ 'page-goal-grower.css' | asset_url | stylesheet_tag }}
    {{ 'page-myjourney.css' | asset_url | stylesheet_tag }}
    {{ 'page-blokkr.css' | asset_url | stylesheet_tag }}
    {{ 'page-kindlitt.css' | asset_url | stylesheet_tag }}
    {{ 'page-support.css' | asset_url | stylesheet_tag }}
    {{ 'page-philosophy.css' | asset_url | stylesheet_tag }}
    {{ 'page-roadmap.css' | asset_url | stylesheet_tag }}
    {{ 'page-community.css' | asset_url | stylesheet_tag }}
    {{ 'page-founder-journey.css' | asset_url | stylesheet_tag }}
    {{ 'collection.css' | asset_url | stylesheet_tag }}
    {{ 'product.css' | asset_url | stylesheet_tag }}
