<section class="px-margin-mobile md:px-margin-desktop py-24 md:py-36 bg-surface">
  <div class="max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-gutter">

    <aside class="hidden lg:block sticky top-32 h-fit">
      <nav class="flex flex-col gap-5 border-l border-outline-variant/30 pl-6 text-label-md uppercase tracking-[0.15em]">
        <a href="#acceptance">Acceptance</a>
        <a href="#membership">Membership</a>
        <a href="#community">Community</a>
        <a href="#intellectual">Intellectual Property</a>
        <a href="#liability">Liability</a>
        <a href="#governance">Governance</a>
      </nav>
    </aside>

    <article>
      <header class="mb-24">
        <span class="block uppercase tracking-[0.2em] text-label-md text-secondary mb-8">
          Legal Framework
        </span>

        <h1 class="font-headline-xl text-headline-xl md:text-[88px] leading-[0.95] tracking-[-0.04em] mb-8">
          Terms of Service
        </h1>

        <p class="text-body-lg text-on-surface-variant max-w-3xl italic">
          Built on the foundation of intentionality, these terms govern your relationship with Ziyu Development.
        </p>
      </header>

      <div class="space-y-24">

        <section id="acceptance" class="scroll-mt-32">
          <h2 class="font-headline-lg text-headline-lg mb-6">01. Acceptance of Terms</h2>
          <div class="space-y-6 text-body-lg text-on-surface-variant max-w-4xl">
            <p>By accessing Ziyu Development, the Archive, or any associated digital properties, you acknowledge that you have read, understood, and agree to be bound by these Terms of Service.</p>
            <p>If you do not agree with any part of these terms, you should not use our services.</p>
          </div>
        </section>

        <section id="membership" class="scroll-mt-32">
          <h2 class="font-headline-lg text-headline-lg mb-6">02. Membership & Archive Access</h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
            <div class="bg-surface-container-low p-8 rounded-xl border border-outline-variant">
              <h3 class="text-label-md uppercase tracking-[0.2em] mb-4">Archive Access</h3>
              <p class="text-on-surface-variant">Access is granted on a per-member basis. You are responsible for your account credentials.</p>
            </div>

            <div class="bg-surface-container-low p-8 rounded-xl border border-outline-variant">
              <h3 class="text-label-md uppercase tracking-[0.2em] mb-4">Intentional Usage</h3>
              <p class="text-on-surface-variant">We may limit access for automated scraping, abuse, or disruption of the platform.</p>
            </div>
          </div>
        </section>

        <section id="community" class="scroll-mt-32">
          <h2 class="font-headline-lg text-headline-lg mb-6">03. Community Guidelines</h2>

          <ul class="space-y-6 text-body-lg text-on-surface-variant max-w-4xl">
            <li><strong>Non-Disruption:</strong> No harassment, spam, or aggressive behavior.</li>
            <li><strong>Constructive Growth:</strong> Feedback should help improve the work and community.</li>
            <li><strong>Privacy Respect:</strong> Private reflections and member content must remain confidential.</li>
          </ul>
        </section>

        <section id="intellectual" class="scroll-mt-32">
          <h2 class="font-headline-lg text-headline-lg mb-6">04. Intellectual Property</h2>
          <div class="space-y-6 text-body-lg text-on-surface-variant max-w-4xl">
            <p>All content, graphics, logos, images, software, and written materials are owned by Ziyu Development or its suppliers unless otherwise stated.</p>
            <p>You are granted a limited, non-exclusive license for personal, non-commercial use.</p>
          </div>
        </section>

        <section id="liability" class="scroll-mt-32">
          <h2 class="font-headline-lg text-headline-lg mb-6">05. Limitation of Liability</h2>
          <div class="bg-surface-container-high p-10 rounded-xl text-body-lg text-on-surface-variant max-w-4xl">
            <p>Ziyu Development provides its services on an “as is” and “as available” basis. We are not liable for indirect, incidental, special, consequential, or punitive damages.</p>
          </div>
        </section>

        <section id="governance" class="scroll-mt-32">
          <h2 class="font-headline-lg text-headline-lg mb-6">06. Governance</h2>
          <p class="text-body-lg text-on-surface-variant max-w-4xl">
            These terms may be updated as the Ziyu ecosystem evolves. Continued use of the service means you accept the updated terms.
          </p>
        </section>

      </div>
    </article>

  </div>
</section>

{% schema %}
{
  "name": "Terms",
  "settings": [],
  "presets": [
    {
      "name": "Terms"
    }
  ]
}
{% endschema %}