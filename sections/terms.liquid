<section class="ziyu-section">
  <div class="ziyu-container">
    <div class="ziyu-legal-hero">
      <span class="ziyu-label">Terms of Service</span>

      <h1 class="ziyu-h1">
        Terms for the Ziyu archive.
      </h1>

      <p class="ziyu-body-lg">
        These terms govern your use of Ziyu Development, the archive, community spaces, products, and associated digital properties.
      </p>
    </div>

    <div class="ziyu-legal-layout">

      <aside class="ziyu-legal-sidebar">
        <a href="#acceptance">Acceptance</a>
        <a href="#membership">Membership</a>
        <a href="#community">Community</a>
        <a href="#property">Property</a>
        <a href="#liability">Liability</a>
        <a href="#updates">Updates</a>
      </aside>

      <div class="ziyu-legal-content">

        <section id="acceptance" class="ziyu-legal-block">
          <span class="ziyu-label">01 Acceptance</span>

          <h2 class="ziyu-h3">
            Acceptance of Terms
          </h2>

          <p class="ziyu-body-lg">
            By accessing Ziyu Development or any associated digital properties, you agree to these Terms of Service.
          </p>

          <p class="ziyu-body-lg">
            If you do not agree with these terms, please do not use the services.
          </p>
        </section>

        <section id="membership" class="ziyu-legal-block">
          <span class="ziyu-label">02 Membership</span>

          <h2 class="ziyu-h3">
            Membership & Archive Access
          </h2>

          <p class="ziyu-body-lg">
            Access to private archive areas, member spaces, or early product updates may be granted on a per-member basis. You are responsible for maintaining your account credentials.
          </p>
        </section>

        <section id="community" class="ziyu-legal-block">
          <span class="ziyu-label">03 Community</span>

          <h2 class="ziyu-h3">
            Community Guidelines
          </h2>

          <p class="ziyu-body-lg">
            Members should avoid harassment, spam, abuse, privacy violations, or behavior that disrupts the calm and intentional nature of the community.
          </p>
        </section>

        <section id="property" class="ziyu-legal-block">
          <span class="ziyu-label">04 Property</span>

          <h2 class="ziyu-h3">
            Intellectual Property
          </h2>

          <p class="ziyu-body-lg">
            Content, graphics, logos, software, written materials, and brand assets are owned by Ziyu Development unless otherwise stated.
          </p>

          <p class="ziyu-body-lg">
            You are granted a limited, non-exclusive license for personal, non-commercial use.
          </p>
        </section>

        <section id="liability" class="ziyu-legal-block">
          <span class="ziyu-label">05 Liability</span>

          <h2 class="ziyu-h3">
            Limitation of Liability
          </h2>

          <p class="ziyu-body-lg">
            Services are provided on an “as is” and “as available” basis. Ziyu Development is not liable for indirect, incidental, special, consequential, or punitive damages.
          </p>
        </section>

        <section id="updates" class="ziyu-legal-block">
          <span class="ziyu-label">06 Updates</span>

          <h2 class="ziyu-h3">
            Changes to These Terms
          </h2>

          <p class="ziyu-body-lg">
            These terms may be updated as the Ziyu ecosystem evolves. Continued use of the services means you accept the updated terms.
          </p>
        </section>

      </div>
    </div>
  </div>
</section>

<section class="ziyu-section ziyu-section--dark">
  <div class="ziyu-manifesto">
    <span class="ziyu-label" style="color: rgba(255,255,255,.7);">
      Legal Framework
    </span>

    <h2 class="ziyu-h2">
      The archive is built on trust, clarity, and responsible use.
    </h2>
  </div>
</section>

{% schema %}
{
  "name": "Terms",
  "settings": [],
  "presets": [
    {
      "name": "Terms"
    }
  ]
}
{% endschema %}