<section class="ziyu-section">
  <div class="ziyu-container ziyu-grid-12">
    <div style="grid-column: span 8;">
      <span class="ziyu-label">Our Shared Philosophy</span>
      <h1 class="ziyu-h1">Investing in technology that honors the human spirit.</h1>
      <p class="ziyu-body-lg" style="margin-top: 28px; max-width: 680px;">Support keeps the ecosystem independent, transparent, and focused on human flourishing instead of engagement metrics.</p>
    </div>
  </div>
</section>

<section class="ziyu-section ziyu-section--soft">
  <div class="ziyu-container">
    <div class="ziyu-grid-3">
      <div class="ziyu-card" style="padding: 40px;">
        <span class="ziyu-label">Tier 01</span>
        <h2 class="ziyu-h3">Reader</h2>
        <p class="ziyu-body" style="margin-top: 16px;">Follow field notes and early project updates.</p>
      </div>

      <div class="ziyu-card" style="padding: 40px;">
        <span class="ziyu-label">Tier 02</span>
        <h2 class="ziyu-h3">Builder</h2>
        <p class="ziyu-body" style="margin-top: 16px;">Support active development and prototype refinement.</p>
      </div>

      <div class="ziyu-card" style="padding: 40px;">
        <span class="ziyu-label">Tier 03</span>
        <h2 class="ziyu-h3">Patron</h2>
        <p class="ziyu-body" style="margin-top: 16px;">Help shape the archive and future product direction.</p>
      </div>
    </div>
  </div>
</section>

<section class="ziyu-section ziyu-section--dark">
  <div class="ziyu-manifesto">
    <span class="ziyu-label" style="color: rgba(255,255,255,.7);">Support the Future</span>
    <h2 class="ziyu-h2">Help fund intentional technology.</h2>
    <p style="margin-top: 24px; color: rgba(255,255,255,.78);">Every contribution helps fund development, infrastructure, writing, research, and long-term experimentation.</p>
    <a href="/pages/store" class="ziyu-button ziyu-button--light" style="margin-top: 36px;">Explore Store</a>
  </div>
</section>

{% schema %}
