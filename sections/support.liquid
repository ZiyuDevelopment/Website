<section class="px-margin-mobile md:px-margin-desktop py-24 md:py-36 bg-surface">
  <div class="max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-12 gap-gutter">

    <div class="lg:col-span-5">
      <span class="block uppercase tracking-[0.2em] text-label-md text-on-surface-variant mb-8">
        Support
      </span>

      <h1 class="font-headline-xl text-headline-xl md:text-[88px] leading-[0.95] tracking-[-0.04em] mb-8">
        Help shape slower technology.
      </h1>

      <p class="text-body-lg text-on-surface-variant max-w-xl mb-12">
        Ziyu Development is independently built. Support helps fund product development, infrastructure, research, and long-term experimentation.
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="/pages/store" class="bg-primary text-on-primary px-7 py-3 rounded-full">
          Support Through Store
        </a>

        <a href="/pages/journal" class="border border-outline px-7 py-3 rounded-full hover:bg-surface-container">
          Read Journal
        </a>
      </div>
    </div>

    <div class="lg:col-span-7">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">

        <div class="bg-surface-container-low border border-outline-variant rounded-2xl p-10">
          <span class="material-symbols-outlined text-5xl mb-8">
            code
          </span>

          <h2 class="font-headline-md text-headline-md mb-4">
            Product Development
          </h2>

          <p class="text-body-md text-on-surface-variant">
            Funding app infrastructure, design systems, engineering, and long-term maintenance.
          </p>
        </div>

        <div class="bg-surface-container-low border border-outline-variant rounded-2xl p-10">
          <span class="material-symbols-outlined text-5xl mb-8">
            auto_stories
          </span>

          <h2 class="font-headline-md text-headline-md mb-4">
            Research & Writing
          </h2>

          <p class="text-body-md text-on-surface-variant">
            Supporting essays, educational resources, experiments, and intentional learning systems.
          </p>
        </div>

        <div class="bg-surface-container-low border border-outline-variant rounded-2xl p-10">
          <span class="material-symbols-outlined text-5xl mb-8">
            devices
          </span>

          <h2 class="font-headline-md text-headline-md mb-4">
            Hardware Experiments
          </h2>

          <p class="text-body-md text-on-surface-variant">
            Helping prototype physical tools designed around deep work and focus rituals.
          </p>
        </div>

        <div class="bg-surface-container-low border border-outline-variant rounded-2xl p-10">
          <span class="material-symbols-outlined text-5xl mb-8">
            favorite
          </span>

          <h2 class="font-headline-md text-headline-md mb-4">
            Independent Creation
          </h2>

          <p class="text-body-md text-on-surface-variant">
            Allowing products to remain intentional instead of being optimized for extraction and engagement.
          </p>
        </div>

      </div>
    </div>

  </div>
</section>

<section class="px-margin-mobile md:px-margin-desktop py-32 bg-primary text-on-primary">
  <div class="max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-2 gap-gutter items-center">

    <div>
      <span class="block uppercase tracking-[0.2em] text-label-md opacity-70 mb-6">
        Thank You
      </span>

      <h2 class="font-headline-lg text-headline-lg md:text-[72px] leading-tight">
        Every contribution helps keep the systems intentional.
      </h2>
    </div>

    <div class="space-y-8">
      <p class="text-body-lg opacity-80">
        The goal is not infinite scale. The goal is building tools that genuinely help people live better lives.
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="/pages/store" class="bg-surface text-on-surface px-7 py-3 rounded-full">
          Explore Store
        </a>

        <a href="/pages/roadmap" class="border border-white/30 px-7 py-3 rounded-full">
          View Roadmap
        </a>
      </div>
    </div>

  </div>
</section>

