<section class="ziyu-section">
  <div class="ziyu-container">
    <div class="ziyu-archive-hero">
      <span class="ziyu-label">Changelog</span>

      <h1 class="ziyu-h1">
        Public progress from the archive.
      </h1>

      <p class="ziyu-body-lg">
        A living record of design changes, product updates, experiments, and development milestones.
      </p>
    </div>

    <div class="ziyu-timeline">

      <div class="ziyu-timeline-item">
        <span class="ziyu-label">May 2026</span>
        <div>
          <h2 class="ziyu-h3">Shopify-native visual system</h2>
          <p class="ziyu-body-lg" style="margin-top: 16px;">
            Converted the cinematic Ziyu direction into reusable Shopify sections and CSS.
          </p>
        </div>
      </div>

      <div class="ziyu-timeline-item">
        <span class="ziyu-label">Prototype</span>
        <div>
          <h2 class="ziyu-h3">Goal Grower identity</h2>
          <p class="ziyu-body-lg" style="margin-top: 16px;">
            Refined the app around botanical progress, life realms, and intentional growth.
          </p>
        </div>
      </div>

      <div class="ziyu-timeline-item">
        <span class="ziyu-label">Research</span>
        <div>
          <h2 class="ziyu-h3">Slow technology language</h2>
          <p class="ziyu-body-lg" style="margin-top: 16px;">
            Defined the brand around attention, reflection, and human-centered systems.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
