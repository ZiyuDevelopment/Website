<section class="ziyu-section">
  <div class="ziyu-container">
    <div style="max-width: 820px; margin-bottom: 96px;">
      <span class="ziyu-label">Projects</span>

      <h1 class="ziyu-h1">
        A living archive of intentional technology.
      </h1>

      <p class="ziyu-body-lg" style="margin-top: 28px;">
        Each project is treated like a chapter in the Ziyu ecosystem: part product, part experiment, part philosophy.
      </p>
    </div>

    <div class="ziyu-project-list">

      <a href="/pages/goal-grower" class="ziyu-project">
        <div class="ziyu-project__copy">
          <span class="ziyu-label ziyu-label--muted">Chapter 01 · In Development</span>

          <h2 class="ziyu-h2">Goal Grower</h2>

          <p class="ziyu-body-lg" style="margin-top: 24px;">
            Growth visualized through intentional systems. A botanical goal tracker for long-term consistency.
          </p>

          <p style="margin-top: 28px; color: var(--primary);">
            View Chapter →
          </p>
        </div>

        <div class="ziyu-card ziyu-project__visual">
          <img
            class="ziyu-image"
            src="https://images.unsplash.com/photo-1466692476868-aef1dfb1e735?q=80&w=1800&auto=format&fit=crop"
            alt="Goal Grower"
            width="1800"
            height="1100"
          >
        </div>
      </a>

      <a href="/pages/blokkr" class="ziyu-project ziyu-project--reverse">
