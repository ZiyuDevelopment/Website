<section class="gg-fintech-home">
  <style>
    .gg-fintech-home {
      padding: 6rem 1.5rem;
      background: linear-gradient(135deg, var(--color-base-background-1), var(--color-base-background-2));
    }

    .gg-container {
      max-width: 1250px;
      margin: 0 auto;
    }

    /* HERO */
    .gg-hero {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 3rem;
      align-items: center;
    }

    @media (max-width: 900px) {
      .gg-hero {
        grid-template-columns: 1fr;
      }
    }

    .gg-hero-title {
      font-size: clamp(2.5rem, 4vw, 3.5rem);
      font-weight: 800;
      line-height: 1.1;
      color: var(--color-foreground);
      letter-spacing: -0.03em;
      margin-bottom: 1rem;
    }

    .gg-hero-sub {
      font-size: 1.2rem;
      color: var(--color-foreground-subdued);
      margin-bottom: 2rem;
      max-width: 550px;
      line-height: 1.6;
    }

    .gg-btn-primary,
    .gg-btn-secondary {
      display: inline-block;
      padding: 1rem 1.8rem;
      border-radius: 12px;
      font-weight: 600;
      text-decoration: none;
      transition: 0.2s ease;
      font-size: 1rem;
    }

    .gg-btn-primary {
      background: var(--color-accent);
      color: white;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .gg-btn-primary:hover {
      opacity: 0.9;
      transform: translateY(-2px);
    }

    .gg-btn-secondary {
      background: var(--color-base-background-2);
      border: 1px solid var(--color-border);
      color: var(--color-foreground);
    }

    .gg-btn-secondary:hover {
      background: var(--color-base-background-3);
      transform: translateY(-2px);
    }

    /* HERO VISUAL */
    .gg-hero-visual {
      background: var(--color-base-background-1);
      border: 1px solid var(--color-border);
      border-radius: 20px;
      padding: 2rem;
      box-shadow: 0 20px 40px rgba(0,0,0,0.06);
    }

    .gg-plant-card {
      background: var(--color-base-background-2);
      border: 1px solid var(--color-border);
      border-radius: 14px;
      padding: 1rem;
      margin-bottom: 1rem;
    }

    .gg-plant-title {
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: var(--color-foreground);
    }

    .gg-bar {
      height: 10px;
      border-radius: 999px;
      background: var(--color-base-background-3);
      overflow: hidden;
      margin-bottom: 0.5rem;
    }

    .gg-bar-fill {
      height: 100%;
      background: var(--color-accent);
      border-radius: 999px;
    }

    /* CARD SECTIONS */
    .gg-card {
      background: var(--color-base-background-1);
      border: 1px solid var(--color-border);
      border-radius: 16px;
      padding: 2rem;
      margin-top: 4rem;
      box-shadow: 0 12px 30px rgba(0,0,0,0.05);
    }

    .gg-section-title {
      font-size: 1.8rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
      color: var(--color-foreground);
    }

    .gg-section-sub {
      font-size: 1.05rem;
      color: var(--color-foreground-subdued);
      margin-bottom: 2rem;
      line-height: 1.6;
    }

    /* SUPPORT GRID */
    .gg-support-grid {
      display: grid;
      gap: 1.5rem;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }

    .gg-support-card {
      border: 1px solid var(--color-border);
      background: var(--color-base-background-2);
      border-radius: 14px;
      padding: 1.5rem;
      transition: 0.2s ease;
    }

    .gg-support-card:hover {
      border-color: var(--color-accent);
      transform: translateY(-3px);
    }

    .gg-support-name {
      font-size: 1.2rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      color: var(--color-foreground);
    }

    .gg-support-desc {
      font-size: 1rem;
      color: var(--color-foreground-subdued);
      line-height: 1.5;
    }

    /* PRODUCTS */
    .gg-products-grid {
      display: grid;
      gap: 1.5rem;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }

    .gg-product-card {
      border: 1px solid var(--color-border);
      background: var(--color-base-background-1);
      border-radius: 14px;
      padding: 1rem;
      transition: 0.2s ease;
    }

    .gg-product-card:hover {
      border-color: var(--color-accent);
      transform: translateY(-3px);
    }

    .gg-product-title {
      font-weight: 600;
      margin-top: 0.75rem;
      color: var(--color-foreground);
      font-size: 1.05rem;
    }

    .gg-product-price {
      font-size: 1rem;
      color: var(--color-foreground-subdued);
      margin-bottom: 0.75rem;
    }

    /* ROADMAP */
    .gg-roadmap-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 1.25rem;
    }

    .gg-roadmap-item {
      font-size: 1.05rem;
      color: var(--color-foreground-subdued);
      padding-left: 1.5rem;
      position: relative;
    }

    .gg-roadmap-item::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.4rem;
      width: 10px;
      height: 10px;
      background: var(--color-accent);
      border-radius: 999px;
    }

    /* FOUNDER */
    .gg-founder {
      margin-top: 4rem;
      padding: 2.5rem;
      border-radius: 16px;
      background: var(--color-base-background-2);
      border: 1px solid var(--color-border);
    }

    .gg-founder-title {
      font-size: 1.6rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
      color: var(--color-foreground);
    }

    .gg-founder-text {
      font-size: 1.05rem;
      color: var(--color-foreground-subdued);
      line-height: 1.7;
      margin-bottom: 1rem;
    }
  </style>

  <div class="gg-container">

    <!-- HERO -->
    <div class="gg-hero">
      <div>
        <h1 class="gg-hero-title">Grow Better Habits. Build a Better Life.</h1>
        <p class="gg-hero-sub">
          Goal Grower turns your habits into living plants. Beta access is always free — support development through donations or workspace tools.
        </p>

        <div style="display:flex; gap:1rem; flex-wrap:wrap;">
          <a href="#beta" class="gg-btn-primary">Join Free Beta</a>
          <a href="#support" class="gg-btn-secondary">Support the Project</a>
        </div>
      </div>

      <!-- HERO VISUAL -->
      <div class="gg-hero-visual">
        <div class="gg-plant-card">
          <div class="gg-plant-title">Read 10 minutes</div>
          <div class="gg-bar"><div class="gg-bar-fill" style="width: 30%;"></div></div>
        </div>

        <div class="gg-plant-card">
          <div class="gg-plant-title">Stretch before bed</div>
          <div class="gg-bar"><div class="gg-bar-fill" style="width: 60%;"></div></div>
        </div>

        <div class="gg-plant-card">
          <div class="gg-plant-title">Morning walk</div>
          <div class="gg-bar"><div class="gg-bar-fill" style="width: 100%;"></div></div>
        </div>
      </div>
    </div>

    <!-- EMAIL SIGNUP -->
    <div class="gg-card" id="beta">
      <div class="gg-section-title">Get Free Beta Access</div>
      <div class="gg-section-sub">No payment required. Just updates and early access.</div>

      {% form 'customer', id: 'beta-form' %}
        <input type="email" name="contact[email]" placeholder="you@example.com" required style="padding:1rem; width:100%; border-radius:12px; border:1px solid var(--color-border); margin-bottom:1rem;">
        <input type="hidden" name="contact[tags]" value="goal-grower-beta">
        <button class="gg-btn-primary" type="submit">Join Beta List</button>
      {% endform %}
    </div>

    <!-- SUPPORT -->
    <div class="gg-card" id="support">
      <div class="gg-section-title">Support the Project</div>
      <div class="gg-section-sub">Beta is free. Support helps fund development.</div>

      <div class="gg-support-grid">
        <div class="gg-support-card">
          <div class="gg-support-name">Seed Supporter ($5–$10)</div>
          <div class="gg-support-desc">Helps cover hosting + basic tools.</div>
        </div>

        <div class="gg-support-card">
          <div class="gg-support-name">Sprout Supporter ($15–$25)</div>
          <div class="gg-support-desc">Funds UI design + plant animations.</div>
        </div>

        <div class="gg-support-card">
          <div class="gg-support-name">Bloom Supporter ($30–$50)</div>
          <div class="gg-support-desc">Supports feature development like Shared Gardens.</div>
        </div>

        <div class="gg-support-card">
          <div class="gg-support-name">Garden Supporter ($60+)</div>
          <div class="gg-support-desc">Helps fund future ZIYU apps.</div>
        </div>
      </div>

      {% assign support_product = all_products['support-goal-grower'] %}
      {% if support_product %}
        <a href="{{ support_product.url }}" class="gg-btn-secondary" style="margin-top:2rem; display:inline-block;">Choose Support Level</a>
      {% endif %}
    </div>

    <!-- PRODUCTS -->
    <div class="gg-card">
      <div class="gg-section-title">Workspace Tools</div>
      <div class="gg-section-sub">Support development by buying desk + computer products.</div>

      {% assign workspace = collections['workspace-tools'] %}
      {% if workspace.products_count > 0 %}
        <div class="gg-products-grid">
          {% for product in workspace.products limit: 4 %}
            <div class="gg-product-card">
              <a href="{{ product.url }}">
                <img src="{{ product.featured_image | img_url: '400x' }}" style="width:100%; border-radius:12px;">
              </a>
              <div class="gg-product-title">{{ product.title }}</div>
              <div class="gg-product-price">{{ product.price | money }}</div>
              <a href="{{ product.url }}" class="gg-btn-secondary">View Product</a>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- ROADMAP -->
    <div class="gg-card">
      <div class="gg-section-title">Roadmap</div>
      <ul class="gg-roadmap-list">
        <li class="gg-roadmap-item">Building core habit → plant system</li>
        <li class="gg-roadmap-item">Private beta for supporters</li>
        <li class="gg-roadmap-item">Shared Gardens + reflections</li>
        <li class="gg-roadmap-item">Mobile app + public launch</li>
      </ul>
    </div>

    <!-- FOUNDER -->
    <div class="gg-founder">
      <div class="gg-founder-title">Hi, I’m Avery.</div>
      <div class="gg-founder-text">
        I’m building Goal Grower as a calm, visual habit app. Beta will always be free — support simply helps me build faster and create more tools in the ZIYU ecosystem.
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Goal Grower Fintech Homepage",
  "settings": [],
  "presets": [
    {
      "name": "Goal Grower Fintech Homepage"
    }
  ]
}
{% endschema %}
