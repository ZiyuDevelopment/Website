<main class="zd-home-new">
  <div class="zd-grain"></div>

  <section class="zd-new-hero">
    <div class="zd-new-hero__copy">
      <h1>Technology designed to help people live intentionally.</h1>
      <p>
        We create digital tools that prioritize your presence over your attention.
        Ziyu Development is a craft studio dedicated to apps that foster real-life
        focus and personal growth.
      </p>

      <div class="zd-new-actions">
        <a href="/pages/support" class="zd-new-btn zd-new-btn--primary">Support the Future</a>
        <a href="/pages/goal-grower" class="zd-new-btn zd-new-btn--secondary">Explore Goal Grower</a>
      </div>
    </div>

    <div class="zd-new-hero__image">
      {% if section.settings.hero_image %}
        <img src="{{ section.settings.hero_image | image_url: width: 1200 }}" alt="Goal Grower app preview" width="1200" height="1400" loading="eager">
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'zd-new-placeholder' }}
      {% endif %}
    </div>
  </section>

  <section class="zd-new-problem">
    <p class="zd-new-eyebrow">The Current State</p>
    <h2>Modern technology is designed to keep us consuming.</h2>
    <div class="zd-new-line"></div>
    <p>
      The apps we use every day are built on the attention economy. They are
      optimized for scrolls, clicks, and notifications — measurements that rarely
      align with a fulfilling life. We believe there is a better way to build.
    </p>
  </section>

  <section class="zd-new-values">
    <article>
      <span>✦</span>
      <h3>Intentional Technology</h3>
      <p>Tools that serve as quiet companions, respecting your boundaries and helping you disconnect from the screen.</p>
    </article>

    <article>
      <span>✦</span>
      <h3>Real-Life Growth</h3>
      <p>Digital milestones that translate into physical progress. If it does not help you in the real world, we do not build it.</p>
    </article>

    <article>
      <span>✦</span>
      <h3>Human Connection</h3>
      <p>Features designed to bridge the gap between people, focusing on shared gardens and collective focus.</p>
    </article>
  </section>

  <section class="zd-new-showcase">
    <div class="zd-new-showcase__copy">
      <h2>Growth visualized through intentional systems.</h2>
      <p>
        Goal Grower turns your abstract ambitions into a living digital ecosystem.
        Each goal you set is represented by progress that grows as you commit time
        to your craft in the real world.
      </p>

      <div class="zd-new-check">
        <strong>Goal Plants</strong>
        <span>Visual progress that evolves with your consistency.</span>
      </div>

      <div class="zd-new-check">
        <strong>Shared Gardens</strong>
        <span>Collaborative spaces for families and friends to grow together.</span>
      </div>

      <a href="/pages/goal-grower" class="zd-new-text-link">View Goal Grower →</a>
    </div>

    <div class="zd-new-showcase__image">
      {% if section.settings.showcase_image %}
        <img src="{{ section.settings.showcase_image | image_url: width: 1200 }}" alt="Digital garden preview" width="1200" height="800" loading="lazy">
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'zd-new-placeholder' }}
      {% endif %}
    </div>
  </section>

  <section class="zd-new-founder">
    <div class="zd-new-founder__image">
      {% if section.settings.founder_image %}
        <img src="{{ section.settings.founder_image | image_url: width: 900 }}" alt="Founder story" width="900" height="1200" loading="lazy">
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'zd-new-placeholder' }}
      {% endif %}
    </div>

    <div class="zd-new-founder__copy">
      <h2>Built by one, for the many.</h2>
      <p>
        Ziyu Development started with a simple question: why does technology make
        us feel so busy but so unaccomplished? This site is a public record of
        building tools that honor time, attention, learning, and real growth.
      </p>
      <p>
        Every project is part of a larger mission to reclaim digital life, one
        intentional interaction at a time.
      </p>

      <a href="/pages/founder-journey" class="zd-new-btn zd-new-btn--light">Read Founder Journey</a>
    </div>
  </section>

  <section class="zd-new-progress">
    <div class="zd-new-section-head">
      <div>
        <p class="zd-new-eyebrow">The Journey</p>
        <h2>Development Progress</h2>
      </div>
      <a href="/pages/roadmap">View full roadmap →</a>
    </div>

    <div class="zd-new-progress-scroll">
      <article>
        <i style="width: 100%;"></i>
        <span>Now</span>
        <h3>Website Foundation</h3>
        <p>Building the brand, pages, store structure, and project ecosystem.</p>
      </article>

      <article>
        <i style="width: 60%;"></i>
        <span>Next</span>
        <h3>Goal Grower MVP</h3>
        <p>Creating goal tracking, visual growth, and early user testing.</p>
      </article>

      <article>
        <i style="width: 35%;"></i>
        <span>Later</span>
        <h3>MyJourney</h3>
        <p>Planning, reflection, growth areas, and journey mapping.</p>
      </article>

      <article>
        <i style="width: 25%;"></i>
        <span>Future</span>
        <h3>Blokkr + Kindlitt</h3>
        <p>Focus protection, clean reading, and intentional information tools.</p>
      </article>
    </div>
  </section>

  <section class="zd-new-support">
    <div class="zd-new-support__intro">
      <h2>Help build the future of intentional technology.</h2>
      <p>
        Ziyu Development is funded by people who believe technology should help
        people grow instead of keeping them stuck.
      </p>
    </div>

    <div class="zd-new-support-grid">
      <article>
        <h3>Observer</h3>
        <p>Free</p>
        <ul>
          <li>Public dev logs</li>
          <li>Community access</li>
          <li>Intentional updates</li>
        </ul>
        <a href="/pages/beta">Join for Free</a>
      </article>

      <article>
        <h3>Supporter</h3>
        <p>Shop or share</p>
        <ul>
          <li>Support through products</li>
          <li>Join waitlists</li>
          <li>Share the mission</li>
        </ul>
        <a href="/pages/support">Support the Future</a>
      </article>

      <article class="zd-new-support-card--featured">
        <span>Most Helpful</span>
        <h3>Advocate</h3>
        <p>Early supporter</p>
        <ul>
          <li>Beta interest</li>
          <li>Feature feedback</li>
          <li>Community involvement</li>
        </ul>
        <a href="/pages/community">Become an Advocate</a>
      </article>

      <article>
        <h3>Visionary</h3>
        <p>Long-term support</p>
        <ul>
          <li>Help shape future apps</li>
          <li>Support physical products</li>
          <li>Follow the full roadmap</li>
        </ul>
        <a href="/pages/roadmap">Shape the Future</a>
      </article>
    </div>
  </section>

  <section class="zd-new-journal">
    <div class="zd-new-section-head">
      <h2>Journal</h2>
      <a href="/blogs/journal">Read all entries →</a>
    </div>

    <div class="zd-new-journal-grid">
      {% assign journal_blog = blogs.journal %}
      {% if journal_blog.articles.size > 0 %}
        {% for article in journal_blog.articles limit: 2 %}
          <a href="{{ article.url }}" class="zd-new-journal-card">
            {% if article.image %}
              <img src="{{ article.image | image_url: width: 900 }}" alt="{{ article.title | escape }}" width="900" height="600" loading="lazy">
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'zd-new-placeholder' }}
            {% endif %}
            <span>{{ article.tags.first | default: 'Journal' }}</span>
            <h3>{{ article.title }}</h3>
            <p>{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
          </a>
        {% endfor %}
      {% else %}
        <a href="/blogs/journal" class="zd-new-journal-card">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'zd-new-placeholder' }}
          <span>Thought</span>
          <h3>The Case for Digital Stillness</h3>
          <p>Why we need to reintroduce friction into our digital interactions.</p>
        </a>

        <a href="/blogs/journal" class="zd-new-journal-card">
          {{ 'collection-1' | placeholder_svg_tag: 'zd-new-placeholder' }}
          <span>Process</span>
          <h3>Crafting the Goal Grower UI</h3>
          <p>Designing a visual system that mirrors slow but steady progress.</p>
        </a>
      {% endif %}
    </div>
  </section>
</main>

{% schema %}
{
  "name": "Ziyu Homepage",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "showcase_image",
      "label": "Goal Grower showcase image"
    },
    {
      "type": "image_picker",
      "id": "founder_image",
      "label": "Founder image"
    }
  ],
  "presets": [
    {
      "name": "Ziyu Homepage"
    }
  ]
}
{% endschema %}