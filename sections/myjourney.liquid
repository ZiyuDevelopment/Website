<section class="px-margin-mobile md:px-margin-desktop py-24 md:py-36 bg-surface">
  <div class="max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">

    <div class="lg:col-span-6">
      <span class="block uppercase tracking-[0.2em] text-label-md text-on-surface-variant mb-8">
        MyJourney
      </span>

      <h1 class="font-headline-xl text-headline-xl md:text-[88px] leading-[0.95] tracking-[-0.04em] mb-8">
        Your life deserves a better archive.
      </h1>

      <p class="text-body-lg text-on-surface-variant max-w-xl mb-10">
        MyJourney is a personal operating system for intentional growth. A place to track goals, preserve memories, build habits, and reflect on the path you are becoming.
      </p>

      <div class="flex flex-wrap gap-4 mb-16">
        <a href="/pages/store" class="bg-primary text-on-primary px-7 py-3 rounded-full">
          Join Waitlist
        </a>

        <a href="/pages/philosophy" class="border border-outline px-7 py-3 rounded-full hover:bg-surface-container">
          Read Philosophy
        </a>
      </div>

      <div class="grid grid-cols-2 gap-8">
        <div>
          <div class="text-4xl font-headline-lg mb-2">365</div>
          <p class="text-body-sm text-on-surface-variant">
            days of intentional growth tracking
          </p>
        </div>

        <div>
          <div class="text-4xl font-headline-lg mb-2">∞</div>
          <p class="text-body-sm text-on-surface-variant">
            customizable life systems
          </p>
        </div>
      </div>
    </div>

    <div class="lg:col-span-6">
      <div class="rounded-2xl overflow-hidden border border-outline-variant bg-surface-container shadow-[0_30px_100px_rgba(0,0,0,0.08)]">
        <img
          src="https://images.unsplash.com/photo-1499750310107-5fef28a66643?q=80&w=1800&auto=format&fit=crop"
          alt="MyJourney"
          width="1800"
          height="2200"
          class="w-full h-full object-cover"
        >
      </div>
    </div>

  </div>
</section>

<section class="px-margin-mobile md:px-margin-desktop py-28 bg-surface-container-low">
  <div class="max-w-container-max mx-auto">

    <div class="max-w-3xl mb-20">
      <span class="block uppercase tracking-[0.2em] text-label-md text-on-surface-variant mb-6">
        The System
      </span>

      <h2 class="font-headline-lg text-headline-lg md:text-[64px] leading-tight">
        Designed to become your life's headquarters.
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">

      <div class="bg-surface rounded-xl border border-outline-variant p-10">
        <span class="material-symbols-outlined text-5xl mb-8">menu_book</span>

        <h3 class="font-headline-md text-headline-md mb-4">
          Personal Archive
        </h3>

        <p class="text-body-md text-on-surface-variant">
          Preserve lessons, memories, journal entries, and milestones in one evolving timeline.
        </p>
      </div>

      <div class="bg-surface rounded-xl border border-outline-variant p-10">
        <span class="material-symbols-outlined text-5xl mb-8">task_alt</span>

        <h3 class="font-headline-md text-headline-md mb-4">
          Realm Systems
        </h3>

        <p class="text-body-md text-on-surface-variant">
          Organize growth into categories like fitness, learning, spirituality, creativity, and work.
        </p>
      </div>

      <div class="bg-surface rounded-xl border border-outline-variant p-10">
        <span class="material-symbols-outlined text-5xl mb-8">timeline</span>

        <h3 class="font-headline-md text-headline-md mb-4">
          Long-Term Progress
        </h3>

        <p class="text-body-md text-on-surface-variant">
          Designed for years of growth rather than short-term productivity spikes.
        </p>
      </div>

    </div>

  </div>
</section>

<section class="px-margin-mobile md:px-margin-desktop py-32 bg-primary text-on-primary">
  <div class="max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-2 gap-gutter items-center">

    <div>
      <span class="block uppercase tracking-[0.2em] text-label-md opacity-70 mb-6">
        Future Vision
      </span>

      <h2 class="font-headline-lg text-headline-lg md:text-[72px] leading-tight mb-8">
        A digital garden for your entire life.
      </h2>
    </div>

    <div class="space-y-8">
      <div class="border-b border-white/20 pb-6">
        <h3 class="font-headline-md text-headline-md mb-2">
          Cross-Platform Archive
        </h3>

        <p class="opacity-80">
          Your goals, memories, and systems available everywhere you work and live.
        </p>
      </div>

      <div class="border-b border-white/20 pb-6">
        <h3 class="font-headline-md text-headline-md mb-2">
          Accountability Systems
        </h3>

        <p class="opacity-80">
          Optional collaborative spaces for shared goals and mutual growth.
        </p>
      </div>

      <div>
        <h3 class="font-headline-md text-headline-md mb-2">
          Lifelong Reflection
        </h3>

        <p class="opacity-80">
          A system built to evolve alongside decades of becoming.
        </p>
      </div>
    </div>

  </div>
</section>

