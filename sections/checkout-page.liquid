<section class="ziyu-section">
  <div class="ziyu-container">
    <div class="ziyu-checkout-hero">
      <span class="ziyu-label">Checkout</span>

      <h1 class="ziyu-h1">
        Finalize your support for intentional technology.
      </h1>

      <p class="ziyu-body-lg">
        This page is styled to match the Ziyu experience. Shopify’s real checkout is controlled separately by Shopify.
      </p>
    </div>

    <div class="ziyu-checkout-layout">

      <div class="ziyu-card ziyu-checkout-form">
        <h2 class="ziyu-h3">
          Contact Information
        </h2>

        <div class="ziyu-form-fields">
          <input type="text" placeholder="Full Name">
          <input type="email" placeholder="Email Address">
          <input type="text" placeholder="Card Number">

          <div class="ziyu-form-fields--split">
            <input type="text" placeholder="MM / YY">
            <input type="text" placeholder="CVC">
          </div>
        </div>
      </div>

      <aside class="ziyu-card ziyu-checkout-summary">
        <span class="ziyu-label" style="color: rgba(255,255,255,.7);">
          Order Summary
        </span>

        <div class="ziyu-checkout-items">
          <div>
            <span>Goal Grower Early Access</span>
            <span>$29</span>
          </div>

          <div>
            <span>Support Contribution</span>
            <span>$10</span>
          </div>
        </div>

        <div class="ziyu-checkout-total">
          <span>Total</span>
          <span>$39</span>
        </div>

        <a href="/pages/thank-you" class="ziyu-button ziyu-button--light">
          Complete Checkout
        </a>

        <p>
          Thank you for supporting independent software and intentional technology development.
        </p>
      </aside>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Checkout Page",
  "settings": [],
  "presets": [
    {
      "name": "Checkout Page"
    }
  ]
}
{% endschema %}