<section class="ziyu-section">
  <div class="ziyu-container">
    <div class="ziyu-reading">
      <span class="ziyu-label">Philosophy</span>

      <h1 class="ziyu-h1">
        Technology should help people become more human, not less.
      </h1>

      <p class="ziyu-body-lg" style="margin-top: 28px;">
        Ziyu Development exists to explore how software, hardware, and digital environments can support meaningful human growth.
      </p>
    </div>
  </div>
</section>

<section class="ziyu-section ziyu-section--dark">
  <div class="ziyu-manifesto">
    <span class="ziyu-label" style="color: rgba(255,255,255,.7);">Manifesto</span>

    <h2 class="ziyu-display" style="font-size: clamp(52px, 7vw, 88px);">
      The future does not need louder tools. It needs quieter ones.
    </h2>
  </div>
</section>

<section class="ziyu-section ziyu-section--soft">
  <div class="ziyu-container">
    <div class="ziyu-grid-3">
      <div class="ziyu-card" style="padding: 40px;">
        <span class="ziyu-label">01</span>
        <h2 class="ziyu-h3">Slow Technology</h2>
        <p class="ziyu-body" style="margin-top: 16px;">
          Digital systems should encourage reflection, intentionality, and sustainable attention.
        </p>
      </div>

      <div class="ziyu-card" style="padding: 40px;">
        <span class="ziyu-label">02</span>
        <h2 class="ziyu-h3">Human-Centered Systems</h2>
        <p class="ziyu-body" style="margin-top: 16px;">
          Products should adapt to human needs instead of forcing people into addictive loops.
        </p>
      </div>

      <div class="ziyu-card" style="padding: 40px;">
        <span class="ziyu-label">03</span>
        <h2 class="ziyu-h3">Long-Term Thinking</h2>
        <p class="ziyu-body" style="margin-top: 16px;">
          We design for years and decades, not just short-term engagement spikes.
        </p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Philosophy",
  "settings": [],
  "presets": [
    {
      "name": "Philosophy"
    }
  ]
}
{% endschema %}