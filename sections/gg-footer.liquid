<footer class="gg-footer">
  <div class="gg-footer-grid">
    <div>
      <a class="gg-logo gg-footer-logo" href="{{ routes.root_url }}">
        <span class="gg-logo-mark">
          <span class="gg-leaf-icon"></span>
        </span>
        <span>{{ shop.name }}</span>
      </a>

      <p>
        A visual goal tracker that turns habits, big goals, and shared progress
        into a living garden.
      </p>
    </div>

    <div>
      <h3>Explore</h3>
      <a href="{{ routes.root_url }}">Home</a>
      <a href="/pages/about">About</a>
      <a href="{{ routes.collections_url }}">Store</a>
      <a href="/pages/support">Support</a>
    </div>

    <div>
      <h3>Account</h3>
      <a href="{{ routes.cart_url }}">Cart</a>
      <a href="{{ routes.account_url }}">Profile</a>
      <a href="/pages/contact">Contact</a>
      <a href="/policies/privacy-policy">Privacy</a>
    </div>

    <div>
      <h3>Mission</h3>
      <p>
        Built for people who want progress to feel alive, visible, and human.
      </p>
    </div>
  </div>

  <div class="gg-footer-bottom">
    <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Goal Grower Footer",
  "settings": [],
  "presets": [
    {
      "name": "Goal Grower Footer"
    }
  ]
}
{% endschema %}