<main class="gg-page">
  <section class="gg-subpage-hero">
    <p class="gg-eyebrow">Contact + Feedback</p>
    <h1>Tell us what would make Goal Grower better.</h1>
    <p>
      Send feedback, report bugs, ask about beta testing, or contact the student
      team building Goal Grower.
    </p>
  </section>

  <section id="testing" class="gg-testing">
    <div>
      <p class="gg-eyebrow">Beta testing</p>
      <h2>Join the testing list.</h2>
      <p>
        Leave your email to get early access updates, testing links, and launch news.
      </p>
    </div>

    <div class="gg-email-card">
      {% form 'customer', class: 'gg-email-form' %}
        <input type="hidden" name="contact[tags]" value="Goal Grower Beta Tester">

        <label for="GoalGrowerContactEmail">Email for beta access</label>

        <div class="gg-email-row">
          <input
            id="GoalGrowerContactEmail"
            type="email"
            name="contact[email]"
            placeholder="you@example.com"
            required
          >
          <button type="submit">Join list</button>
        </div>

        {% if form.posted_successfully? %}
          <p class="gg-form-success">Thank you. You are on the testing list.</p>
        {% endif %}

        {% if form.errors %}
          <p class="gg-form-error">Please check your email and try again.</p>
        {% endif %}
      {% endform %}
    </div>
  </section>

  <section id="feedback" class="gg-contact-form-section">
    <div>
      <p class="gg-eyebrow">Feedback</p>
      <h2>Send us a message.</h2>
      <p>
        Use this for feature ideas, app feedback, bugs, store questions, or collaboration.
      </p>
    </div>

    <div class="gg-contact-card">
      {% form 'contact', class: 'gg-contact-form' %}
        {% if form.posted_successfully? %}
          <p class="gg-form-success">Thank you. Your message was sent.</p>
        {% endif %}

        {% if form.errors %}
          <p class="gg-form-error">Please check the form and try again.</p>
        {% endif %}

        <label for="ContactName">Name</label>
        <input id="ContactName" type="text" name="contact[name]" placeholder="Your name">

        <label for="ContactEmail">Email</label>
        <input id="ContactEmail" type="email" name="contact[email]" placeholder="you@example.com" required>

        <label for="ContactReason">What is this about?</label>
        <select id="ContactReason" name="contact[reason]">
          <option>Beta testing</option>
          <option>App feedback</option>
          <option>Bug report</option>
          <option>Store question</option>
          <option>Support / funding</option>
          <option>Other</option>
        </select>

        <label for="ContactMessage">Message</label>
        <textarea id="ContactMessage" name="contact[body]" rows="7" placeholder="Tell us what you think..." required></textarea>

        <button type="submit">Send message</button>
      {% endform %}
    </div>
  </section>
</main>

{% schema %}
{
  "name": "Goal Grower Contact",
  "settings": [],
  "presets": [
    {
      "name": "Goal Grower Contact"
    }
  ]
}
{% endschema %}