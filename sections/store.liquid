<section class="ziyu-section">
  <div class="ziyu-container">
    <div style="max-width: 720px; margin-bottom: 80px;">
      <span class="ziyu-label">The Boutique</span>
      <h1 class="ziyu-h1">Curated tools for intentional living.</h1>
      <p class="ziyu-body-lg" style="margin-top: 28px;">A selection of physical and digital artifacts designed to bring focus, beauty, and purpose to daily workflows.</p>
    </div>

    <div class="ziyu-grid-2">
      <a href="/pages/goal-grower" class="ziyu-card">
        <div style="aspect-ratio: 16 / 10;">
          <img class="ziyu-image" src="https://images.unsplash.com/photo-1466692476868-aef1dfb1e735?q=80&w=1600&auto=format&fit=crop" alt="Goal Grower">
        </div>
        <div style="padding: 32px;">
          <span class="ziyu-status">In Development</span>
          <h2 class="ziyu-h3" style="margin-top: 22px;">Goal Grower</h2>
          <p class="ziyu-body" style="margin-top: 16px;">A botanical goal-tracking system for long-term consistency.</p>
        </div>
      </a>

      <a href="/pages/support" class="ziyu-card" style="background: var(--primary); color: white;">
        <div style="padding: 48px; min-height: 100%;">
          <span class="ziyu-status" style="border: 1px solid rgba(255,255,255,.3);">Founding Support</span>
          <h2 class="ziyu-h3" style="margin-top: 28px;">Support Ziyu Development</h2>
          <p style="margin-top: 16px; color: rgba(255,255,255,.78);">Help fund independent software, writing, infrastructure, and experiments.</p>
          <p style="margin-top: 40px;">Become a founding member →</p>
        </div>
      </a>

      <a href="/pages/blokkr" class="ziyu-card">
        <div style="aspect-ratio: 16 / 10;">
          <img class="ziyu-image ziyu-grayscale" src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?q=80&w=1600&auto=format&fit=crop" alt="Blokkr">
        </div>
        <div style="padding: 32px;">
          <span class="ziyu-status ziyu-status--outline">Hardware Experiment</span>
          <h2 class="ziyu-h3" style="margin-top: 22px;">Blokkr</h2>
          <p class="ziyu-body" style="margin-top: 16px;">A physical ritual object for entering deep work.</p>
        </div>
      </a>

      <a href="/pages/deep-work-library" class="ziyu-card">
        <div style="aspect-ratio: 16 / 10;">
          <img class="ziyu-image" src="https://images.unsplash.com/photo-1512820790803-83ca734da794?q=80&w=1600&auto=format&fit=crop" alt="Deep Work Library">
        </div>
        <div style="padding: 32px;">
          <span class="ziyu-status ziyu-status--outline">Library</span>
          <h2 class="ziyu-h3" style="margin-top: 22px;">Deep Work Library</h2>
          <p class="ziyu-body" style="margin-top: 16px;">Resources for focus, learning, and intentional creation.</p>
        </div>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Store",
  "settings": [],
  "presets": [
    {
      "name": "Store"
    }
  ]
}
{% endschema %}