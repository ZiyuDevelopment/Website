<section class="ziyu-section">
  <div class="ziyu-container">
    <div style="max-width: 760px; margin-bottom: 90px;">
      <span class="ziyu-label">The Boutique</span>

      <h1 class="ziyu-h1">
        Curated tools for intentional living.
      </h1>

      <p class="ziyu-body-lg" style="margin-top: 28px;">
        A selection of digital systems, physical concepts, and support options designed around focus, beauty, and purpose.
      </p>
    </div>

    <div class="ziyu-store-grid">

      <a href="/pages/goal-grower" class="ziyu-card ziyu-store-card ziyu-store-card--large">
        <div class="ziyu-store-card__image">
          <img
            class="ziyu-image"
            src="https://images.unsplash.com/photo-1466692476868-aef1dfb1e735?q=80&w=1800&auto=format&fit=crop"
            alt="Goal Grower"
            width="1800"
            height="1200"
          >
        </div>

        <div class="ziyu-store-card__content">
          <span class="ziyu-status">In Development</span>
          <h2 class="ziyu-h3">Goal Grower</h2>
          <p class="ziyu-body">A botanical goal-tracking system for long-term consistency.</p>
          <span class="ziyu-card-link">View Product →</span>
        </div>
      </a>

      <a href="/pages/support" class="ziyu-card ziyu-store-card ziyu-store-card--support">
        <div class="ziyu-store-card__content">
          <span class="ziyu-status ziyu-status--light">Founding Support</span>
          <h2 class="ziyu-h3">Support Ziyu Development</h2>
          <p>Help fund independent software, writing, infrastructure, and experiments.</p>
          <span class="ziyu-card-link">Become a Founding Member →</span>
        </div>
      </a>

      <a href="/pages/blokkr" class="ziyu-card ziyu-store-card">
        <div class="ziyu-store-card__image">
          <img
            class="ziyu-image ziyu-grayscale"
            src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?q=80&w=1600&auto=format&fit=crop"
            alt="Blokkr"
            width="1600"
            height="1000"
          >
        </div>

        <div class="ziyu-store-card__content">
          <span class="ziyu-status ziyu-status--outline">Hardware Experiment</span>
          <h2 class="ziyu-h3">Blokkr</h2>
          <p class="ziyu-body">A physical ritual object for entering deep work.</p>
          <span class="ziyu-card-link">View Concept →</span>
        </div>
      </a>

      <a href="/pages/deep-work-library" class="ziyu-card ziyu-store-card">
        <div class="ziyu-store-card__image">
          <img
            class="ziyu-image"
            src="https://images.unsplash.com/photo-1512820790803-83ca734da794?q=80&w=1600&auto=format&fit=crop"
            alt="Deep Work Library"
            width="1600"
            height="1000"
          >
        </div>

        <div class="ziyu-store-card__content">
          <span class="ziyu-status ziyu-status--outline">Library</span>
          <h2 class="ziyu-h3">Deep Work Library</h2>
          <p class="ziyu-body">Resources for focus, learning, and intentional creation.</p>
          <span class="ziyu-card-link">Browse Library →</span>
        </div>
      </a>

    </div>
  </div>
</section>

<section class="ziyu-section ziyu-section--dark">
  <div class="ziyu-manifesto">
    <span class="ziyu-label" style="color: rgba(255,255,255,.7);">
      Not a Marketplace
    </span>

    <h2 class="ziyu-h2">
      The store is a curated shelf, not an endless feed.
    </h2>

    <p style="margin-top: 24px; color: rgba(255,255,255,.78);">
      Every item exists to support the larger mission: quieter technology, deeper focus, and more intentional living.
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Store",
  "settings": [],
  "presets": [
    {
      "name": "Store"
    }
  ]
}
{% endschema %}