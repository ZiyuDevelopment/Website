<section class="px-margin-mobile md:px-margin-desktop pt-24 md:pt-32 pb-20 bg-surface">
  <div class="max-w-container-max mx-auto">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-end mb-24">

      <div class="lg:col-span-8">
        <span class="block uppercase tracking-[0.2em] text-label-md text-on-surface-variant mb-8">
          Store
        </span>

        <h1 class="font-headline-xl text-headline-xl md:text-[96px] leading-[0.92] tracking-[-0.05em] max-w-5xl">
          Objects and systems for intentional living.
        </h1>
      </div>

      <div class="lg:col-span-4">
        <p class="text-body-lg text-on-surface-variant leading-relaxed">
          Apps, physical tools, and digital products designed around calmness, focus, and sustainable growth.
        </p>
      </div>

    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter mb-32">

      <a href="/pages/goal-grower" class="group block">
        <div class="aspect-[4/5] overflow-hidden rounded-2xl bg-surface-container border border-outline-variant mb-6">
          <img
            src="https://images.unsplash.com/photo-1466692476868-aef1dfb1e735?q=80&w=1600&auto=format&fit=crop"
            alt="Goal Grower"
            width="1600"
            height="2000"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          >
        </div>

        <div class="flex justify-between items-start gap-8">
          <div>
            <span class="block uppercase tracking-[0.2em] text-label-md text-on-surface-variant mb-3">
              App Ecosystem
            </span>

            <h2 class="font-headline-lg text-headline-lg mb-3">
              Goal Grower
            </h2>

            <p class="text-body-md text-on-surface-variant max-w-md">
              A botanical productivity system designed around gradual growth instead of urgency.
            </p>
          </div>

          <span class="material-symbols-outlined mt-2 group-hover:translate-x-1 transition-transform">
            arrow_forward
          </span>
        </div>
      </a>

      <a href="/pages/blokkr" class="group block">
        <div class="aspect-[4/5] overflow-hidden rounded-2xl bg-surface-container border border-outline-variant mb-6">
          <img
            src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?q=80&w=1600&auto=format&fit=crop"
            alt="Blokkr"
            width="1600"
            height="2000"
            class="w-full h-full object-cover grayscale group-hover:scale-105 transition-transform duration-700"
          >
        </div>

        <div class="flex justify-between items-start gap-8">
          <div>
            <span class="block uppercase tracking-[0.2em] text-label-md text-on-surface-variant mb-3">
              Hardware
            </span>

            <h2 class="font-headline-lg text-headline-lg mb-3">
              Blokkr
            </h2>

            <p class="text-body-md text-on-surface-variant max-w-md">
              A physical deep-work object designed to create intentional focus rituals.
            </p>
          </div>

          <span class="material-symbols-outlined mt-2 group-hover:translate-x-1 transition-transform">
            arrow_forward
          </span>
        </div>
      </a>

      <a href="/pages/myjourney" class="group block">
        <div class="aspect-[4/5] overflow-hidden rounded-2xl bg-surface-container border border-outline-variant mb-6">
          <img
            src="https://images.unsplash.com/photo-1499750310107-5fef28a66643?q=80&w=1600&auto=format&fit=crop"
            alt="MyJourney"
            width="1600"
            height="2000"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          >
        </div>

        <div class="flex justify-between items-start gap-8">
          <div>
            <span class="block uppercase tracking-[0.2em] text-label-md text-on-surface-variant mb-3">
              Life System
            </span>

            <h2 class="font-headline-lg text-headline-lg mb-3">
              MyJourney
            </h2>

            <p class="text-body-md text-on-surface-variant max-w-md">
              A personal archive for goals, journaling, habits, memories, and reflection.
            </p>
          </div>

          <span class="material-symbols-outlined mt-2 group-hover:translate-x-1 transition-transform">
            arrow_forward
          </span>
        </div>
      </a>

      <a href="/pages/kindlitt" class="group block">
        <div class="aspect-[4/5] overflow-hidden rounded-2xl bg-surface-container border border-outline-variant mb-6">
          <img
            src="https://images.unsplash.com/photo-1512820790803-83ca734da794?q=80&w=1600&auto=format&fit=crop"
            alt="KindLitt"
            width="1600"
            height="2000"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          >
        </div>

        <div class="flex justify-between items-start gap-8">
          <div>
            <span class="block uppercase tracking-[0.2em] text-label-md text-on-surface-variant mb-3">
              Reading Platform
            </span>

            <h2 class="font-headline-lg text-headline-lg mb-3">
              KindLitt
            </h2>

            <p class="text-body-md text-on-surface-variant max-w-md">
              A calmer reading environment for families, comprehension, and long-form learning.
            </p>
          </div>

          <span class="material-symbols-outlined mt-2 group-hover:translate-x-1 transition-transform">
            arrow_forward
          </span>
        </div>
      </a>

    </div>

  </div>
</section>

<section class="px-margin-mobile md:px-margin-desktop py-32 bg-primary text-on-primary">
  <div class="max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-2 gap-gutter items-center">

    <div>
      <span class="block uppercase tracking-[0.2em] text-label-md opacity-70 mb-6">
        Independent Development
      </span>

      <h2 class="font-headline-lg text-headline-lg md:text-[72px] leading-tight">
        Every purchase directly supports future tools.
      </h2>
    </div>

    <div class="space-y-8">
      <p class="text-body-lg opacity-80">
        Ziyu Development is independently built and research-driven. Purchases help fund infrastructure, experimentation, writing, and long-term development.
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="/pages/support" class="bg-surface text-on-surface px-7 py-3 rounded-full">
          Support the Mission
        </a>

        <a href="/pages/roadmap" class="border border-white/30 px-7 py-3 rounded-full">
          View Roadmap
        </a>
      </div>
    </div>

  </div>
</section>

