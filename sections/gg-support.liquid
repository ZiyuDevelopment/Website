<section class="gg-page-hero gg-support-hero">
  <div class="gg-container">
    <span class="gg-badge">Support Development</span>
    <h1>Help Goal Grower keep growing.</h1>
    <p>
      Your support helps fund development, testing, design, and future features.
      No rewards are guaranteed — this is support for the mission.
    </p>

    <div class="gg-hero-actions">
      <a href="/collections/all" class="gg-btn">Visit Store</a>
      <a href="/pages/contact" class="gg-btn-outline">Become a Tester</a>
    </div>
  </div>
</section>

<section class="gg-page-section">
  <div class="gg-container">
    <h2>What support helps with</h2>

    <div class="gg-feature-grid">
      <div class="gg-feature-card">
        <span>🛠️</span>
        <h3>App Development</h3>
        <p>Building features, fixing bugs, and improving the experience.</p>
      </div>

      <div class="gg-feature-card">
        <span>📱</span>
        <h3>Testing</h3>
        <p>Preparing Goal Grower for real users and app store release.</p>
      </div>

      <div class="gg-feature-card">
        <span>🌿</span>
        <h3>Design</h3>
        <p>Making progress feel more human, visual, and motivating.</p>
      </div>
    </div>
  </div>
</section>

