<section class="gg-page-hero">
  <div class="gg-container reveal">
    <span class="gg-kicker">Support Development</span>
    <h1>Help the garden keep growing.</h1>
    <p>
      Goal Grower is still being built. Your support helps fund development, testing, design, and future features.
    </p>

    <div class="gg-hero-actions center">
      <a href="{{ routes.collections_url }}" class="gg-btn">Visit Store</a>
      <a href="/pages/contact" class="gg-btn-soft">Become a Tester</a>
    </div>
  </div>
</section>

<section class="gg-section">
  <div class="gg-container">
    <div class="gg-section-heading reveal">
      <span class="gg-kicker">Where support goes</span>
      <h2>Funding real development work.</h2>
    </div>

    <div class="gg-card-grid">
      <div class="gg-info-card reveal">
        <span class="gg-number">01</span>
        <h3>Building</h3>
        <p>New features, app polish, shared gardens, and bug fixes.</p>
      </div>

      <div class="gg-info-card reveal">
        <span class="gg-number">02</span>
        <h3>Testing</h3>
        <p>Preparing Goal Grower for beta testers and app store release.</p>
      </div>

      <div class="gg-info-card reveal">
        <span class="gg-number">03</span>
        <h3>Design</h3>
        <p>Making the app feel more human, calming, motivating, and alive.</p>
      </div>
    </div>

    <p class="gg-disclaimer reveal">
      Support is voluntary and does not guarantee rewards, ownership, or future access.
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Goal Grower Support",
  "settings": []
}
{% endschema %}