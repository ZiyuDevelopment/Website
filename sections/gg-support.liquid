<section class="gg-page-hero gg-support-hero">
  <div class="gg-container">
    <span class="gg-badge">Support Development</span>
    <h1>Help the garden keep growing.</h1>
    <p>
      Goal Grower is still being built. Your support helps fund development,
      testing, design, and future features.
    </p>

    <div class="gg-hero-actions center">
      <a href="/collections/all" class="gg-btn">Visit Store</a>
      <a href="/pages/contact" class="gg-btn-outline">Become a Tester</a>
    </div>
  </div>
</section>

<section class="gg-page-section">
  <div class="gg-container">
    <span class="gg-mini-label">Where support goes</span>
    <h2>Funding real development work.</h2>

    <div class="gg-feature-grid">
      <div class="gg-feature-card">
        <span class="gg-feature-icon"></span>
        <h3>Building</h3>
        <p>New features, shared gardens, app polish, and bug fixes.</p>
      </div>

      <div class="gg-feature-card">
        <span class="gg-feature-icon alt"></span>
        <h3>Testing</h3>
        <p>Preparing the app for beta testers and app store release.</p>
      </div>

      <div class="gg-feature-card">
        <span class="gg-feature-icon third"></span>
        <h3>Design</h3>
        <p>Making the app feel more human, motivating, and alive.</p>
      </div>
    </div>

    <p class="gg-disclaimer">
      Support is voluntary and does not guarantee rewards, ownership, or future access.
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Goal Grower Support",
  "settings": []
}
{% endschema %}