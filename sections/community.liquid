<section class="ziyu-section">
  <div class="ziyu-container ziyu-grid-12">
    <div style="grid-column: span 7;">
      <span class="ziyu-label">Built Together</span>
      <h1 class="ziyu-h1">Technology should not feel lonely. It should feel like home.</h1>
      <p class="ziyu-body-lg" style="margin-top: 28px;">A movement of intentional creators, thoughtful users, and early adopters who believe digital space can be warm, collaborative, and human-centered.</p>

      <div class="ziyu-hero__actions">
        <a href="#" class="ziyu-button">Join the Discord</a>
        <a href="/pages/support" class="ziyu-button ziyu-button--ghost">Become a Beta Tester</a>
      </div>
    </div>

    <div style="grid-column: span 5;">
      <div class="ziyu-card" style="aspect-ratio: 4 / 5;">
        <img class="ziyu-image" src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?q=80&w=1200&auto=format&fit=crop" alt="Community collaboration">
      </div>
    </div>
  </div>
</section>

<section class="ziyu-section ziyu-section--soft">
  <div class="ziyu-container">
    <div class="ziyu-grid-3">
      <div class="ziyu-card" style="padding: 40px;">
        <span class="material-symbols-outlined" style="font-size: 44px; color: var(--primary); margin-bottom: 28px;">forum</span>
        <h2 class="ziyu-h4">Discussion</h2>
        <p class="ziyu-body" style="margin-top: 14px;">Conversations around focus, design, technology, and intentional living.</p>
      </div>

      <div class="ziyu-card" style="padding: 40px;">
        <span class="material-symbols-outlined" style="font-size: 44px; color: var(--primary); margin-bottom: 28px;">science</span>
        <h2 class="ziyu-h4">Beta Testing</h2>
        <p class="ziyu-body" style="margin-top: 14px;">Help shape early versions of Ziyu products through thoughtful feedback.</p>
      </div>

      <div class="ziyu-card" style="padding: 40px;">
        <span class="material-symbols-outlined" style="font-size: 44px; color: var(--primary); margin-bottom: 28px;">favorite</span>
        <h2 class="ziyu-h4">Supporters</h2>
        <p class="ziyu-body" style="margin-top: 14px;">A founding circle for people who believe in the mission.</p>
      </div>
    </div>
  </div>
</section>

