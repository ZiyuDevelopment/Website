<section class="ziyu-section">
  <div class="ziyu-container">
    <div class="ziyu-community-hero">
      <div>
        <span class="ziyu-label">Built Together</span>

        <h1 class="ziyu-h1">
          Technology should not feel lonely. It should feel like home.
        </h1>

        <p class="ziyu-body-lg" style="margin-top: 28px;">
          A movement of intentional creators, thoughtful users, and early adopters who believe digital space can be warm, collaborative, and human-centered.
        </p>

        <div class="ziyu-hero__actions">
          <a href="#" class="ziyu-button">Join the Discord</a>
          <a href="/pages/support" class="ziyu-button ziyu-button--ghost">Become a Beta Tester</a>
        </div>
      </div>

      <div class="ziyu-card ziyu-community-hero__image">
        <img
          class="ziyu-image"
          src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?q=80&w=1400&auto=format&fit=crop"
          alt="Community collaboration"
          width="1400"
          height="1600"
        >
      </div>
    </div>
  </div>
</section>

<section class="ziyu-section ziyu-section--soft">
  <div class="ziyu-container">
    <div style="max-width: 760px; margin-bottom: 70px;">
      <span class="ziyu-label">Community Paths</span>

      <h2 class="ziyu-h2">
        Three ways to enter the circle.
      </h2>
    </div>

    <div class="ziyu-grid-3">
      <div class="ziyu-card" style="padding: 40px;">
        <span class="material-symbols-outlined" style="font-size: 44px; color: var(--primary); margin-bottom: 28px;">forum</span>

        <h3 class="ziyu-h4">
          Discussion
        </h3>

        <p class="ziyu-body" style="margin-top: 14px;">
          Conversations around focus, design, technology, learning, and intentional living.
        </p>
      </div>

      <div class="ziyu-card" style="padding: 40px;">
        <span class="material-symbols-outlined" style="font-size: 44px; color: var(--primary); margin-bottom: 28px;">science</span>

        <h3 class="ziyu-h4">
          Beta Testing
        </h3>

        <p class="ziyu-body" style="margin-top: 14px;">
          Help shape early versions of Ziyu products through thoughtful feedback.
        </p>
      </div>

      <div class="ziyu-card" style="padding: 40px;">
        <span class="material-symbols-outlined" style="font-size: 44px; color: var(--primary); margin-bottom: 28px;">favorite</span>

        <h3 class="ziyu-h4">
          Supporters
        </h3>

        <p class="ziyu-body" style="margin-top: 14px;">
          A founding circle for people who believe in slower, healthier technology.
        </p>
      </div>
    </div>
  </div>
</section>

<section class="ziyu-section">
  <div class="ziyu-container">
    <div class="ziyu-community-quote">
      <span class="ziyu-label">Early Movement</span>

      <h2 class="ziyu-h2">
        The goal is not to build a massive audience. The goal is to gather the right people.
      </h2>

      <p class="ziyu-body-lg" style="margin-top: 28px;">
        Ziyu is for people who want technology to feel calmer, more beautiful, and more respectful of real life.
      </p>
    </div>
  </div>
</section>

<section class="ziyu-section ziyu-section--dark">
  <div class="ziyu-manifesto">
    <span class="ziyu-label" style="color: rgba(255,255,255,.7);">
      Join the Circle
    </span>

    <h2 class="ziyu-h2">
      Help shape the archive while it is still young.
    </h2>

    <div style="margin-top: 36px; display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;">
      <a href="#" class="ziyu-button ziyu-button--light">
        Join Discord
      </a>

      <a href="/pages/support" class="ziyu-button" style="background: transparent; border-color: rgba(255,255,255,.35);">
        Support the Future
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Community",
  "settings": [],
  "presets": [
    {
      "name": "Community"
    }
  ]
}
{% endschema %}