<section class="ziyu-hero">
  <div class="ziyu-container ziyu-grid-12">
    <div class="ziyu-hero__copy">
      <span class="ziyu-label">Chapter 04 · Future Product</span>

      <h1 class="ziyu-display">KindLitt</h1>

      <p class="ziyu-body-lg">
        A calmer reading environment for families, comprehension, long-form learning, and meaningful digital libraries.
      </p>

      <div class="ziyu-hero__actions">
        <a href="/pages/support" class="ziyu-button">Follow the Idea</a>
        <a href="/pages/deep-work-library" class="ziyu-button ziyu-button--ghost">Browse Library</a>
      </div>
    </div>

    <div class="ziyu-hero__visual">
      <div class="ziyu-card" style="aspect-ratio: 4 / 5;">
        <img class="ziyu-image" src="https://images.unsplash.com/photo-1512820790803-83ca734da794?q=80&w=1400&auto=format&fit=crop" alt="KindLitt">
      </div>
    </div>
  </div>
</section>

<section class="ziyu-section ziyu-section--soft">
  <div class="ziyu-container ziyu-grid-12">
    <div style="grid-column: span 5;">
      <span class="ziyu-label">Origin Story</span>
      <h2 class="ziyu-h2">Reading should feel peaceful, not algorithmic.</h2>
    </div>

    <div class="ziyu-text-stack" style="grid-column: span 7;">
      <p class="ziyu-body-lg">KindLitt is a future reading platform designed around quiet comprehension instead of content addiction.</p>
      <p class="ziyu-body-lg">The goal is to create a digital library that feels more like a calm study room than an infinite feed.</p>
    </div>
  </div>
</section>

<section class="ziyu-section">
  <div class="ziyu-container">
    <span class="ziyu-label">Experience</span>
    <h2 class="ziyu-h2" style="max-width: 760px; margin-bottom: 80px;">Reading designed for attention and care.</h2>

    <div class="ziyu-grid-3">
      <div class="ziyu-card" style="padding: 40px;">
        <span class="material-symbols-outlined" style="font-size: 48px; color: var(--primary); margin-bottom: 32px;">menu_book</span>
        <h3 class="ziyu-h4">Deep Reading</h3>
        <p class="ziyu-body" style="margin-top: 16px;">Typography and reading flow designed for calm comprehension and retention.</p>
      </div>

      <div class="ziyu-card" style="padding: 40px;">
        <span class="material-symbols-outlined" style="font-size: 48px; color: var(--primary); margin-bottom: 32px;">family_restroom</span>
        <h3 class="ziyu-h4">Family Libraries</h3>
        <p class="ziyu-body" style="margin-top: 16px;">Shared reading spaces for families, students, and intentional learning groups.</p>
      </div>

      <div class="ziyu-card" style="padding: 40px;">
        <span class="material-symbols-outlined" style="font-size: 48px; color: var(--primary); margin-bottom: 32px;">visibility</span>
        <h3 class="ziyu-h4">No Feed Pressure</h3>
        <p class="ziyu-body" style="margin-top: 16px;">A reading environment without addictive loops, endless feeds, or noisy recommendations.</p>
      </div>
    </div>
  </div>
</section>

<section class="ziyu-section ziyu-section--dark">
  <div class="ziyu-manifesto">
    <span class="ziyu-label" style="color: rgba(255,255,255,.7);">Future Library</span>
    <h2 class="ziyu-h2">A digital library that feels human again.</h2>
    <p style="margin-top: 24px; color: rgba(255,255,255,.78);">KindLitt is part of the long-term Ziyu vision for healthier reading, learning, and family technology.</p>
    <a href="/pages/support" class="ziyu-button ziyu-button--light" style="margin-top: 36px;">Support the Vision</a>
  </div>
</section>

