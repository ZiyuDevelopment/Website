<main class="zd-beta">

  <section class="zdbeta-hero">
    <div class="zdbeta-hero__copy">
      <p class="zdbeta-eyebrow">Beta Access</p>
      <h1>Help grow Goal Grower before it launches.</h1>
      <p>
        Become an early tester for Goal Grower and help improve shared gardens,
        goal plants, watering, reminders, and the full app experience.
      </p>

      <div class="zdbeta-hero__actions">
        <a href="#beta-form">Apply to Test</a>
        <a href="#future-app-waitlist">Future App Waitlist</a>
      </div>
    </div>

    <div class="zdbeta-hero__panel">
      <span>Now Testing</span>
      <h2>Shared Gardens</h2>
      <p>
        Test goals with other people, water your plants, and help shape accountability
        before public launch.
      </p>

      <div class="zdbeta-mini-stats">
        <div>
          <strong>01</strong>
          <small>Goal Grower</small>
        </div>
        <div>
          <strong>Live</strong>
          <small>Shared Gardens</small>
        </div>
        <div>
          <strong>Open</strong>
          <small>Beta Requests</small>
        </div>
      </div>
    </div>
  </section>

  <section class="zdbeta-application" id="beta-form">

    <div class="zdbeta-form-card">
      <div class="zdbeta-form-header">
        <p class="zdbeta-eyebrow">Application</p>
        <h2>Apply to become a Goal Grower tester.</h2>
        <p>
          This is for people who want to actively use the app, test features,
          report bugs, and help improve the experience before launch.
        </p>
      </div>

      <form class="zdbeta-form" method="post" action="/contact#beta-form">
        <input type="hidden" name="form_type" value="contact">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="contact[subject]" value="Goal Grower Beta Access Request">

        <div class="zdbeta-field-row">
          <label>
            Name
            <input type="text" name="contact[name]" placeholder="Your name" required>
          </label>

          <label>
            Email
            <input type="email" name="contact[email]" placeholder="you@example.com" required>
          </label>
        </div>

        <label>
          Device
          <select name="contact[Device]">
            <option>iPhone</option>
            <option>Android</option>
            <option>Both</option>
            <option>Not sure yet</option>
          </select>
        </label>

        <label>
          Why do you want to test Goal Grower?
          <textarea name="contact[Beta reason]" rows="5" placeholder="Tell us what you want to test or why you are interested."></textarea>
        </label>

        <button type="submit">Request Beta Access</button>
      </form>
    </div>

    <aside class="zdbeta-testing-card">
      <p class="zdbeta-eyebrow">Tester Focus</p>

      <div class="zdbeta-testing-list">
        <article>
          <span>01</span>
          <h3>Shared Gardens</h3>
          <p>Test accountability gardens with friends, family, or groups.</p>
        </article>

        <article>
          <span>02</span>
          <h3>Plant Health</h3>
          <p>Check how goals grow, fade, recover, and respond to progress.</p>
        </article>

        <article>
          <span>03</span>
          <h3>Launch Readiness</h3>
          <p>Help find bugs, confusing screens, and missing pieces before launch.</p>
        </article>
      </div>
    </aside>

  </section>

  <section class="zdbeta-role">
    <div>
      <p class="zdbeta-eyebrow">Your Role</p>
      <h2>Beta testers help turn the app from working into worth launching.</h2>
    </div>

    <div>
      <p>
        You will use Goal Grower in real life and tell us what feels fun, confusing,
        broken, helpful, unnecessary, or missing.
      </p>
      <p>
        The goal is to make the app clearer, smoother, and more meaningful before
        it reaches more users.
      </p>
    </div>
  </section>

  <section class="zdbeta-future" id="future-app-waitlist">

    <div class="zdbeta-future__copy">
      <p class="zdbeta-eyebrow">Future App Waitlist</p>
      <h2>Test future Ziyu apps when they become available.</h2>
      <p>
        Goal Grower is the first major project. Future apps like MyJourney, Blokkr,
        KindLitt, and current experiments will need early testers too.
      </p>
    </div>

    <form class="zdbeta-future-form" method="post" action="/contact#future-app-waitlist">
      <input type="hidden" name="form_type" value="contact">
      <input type="hidden" name="utf8" value="✓">
      <input type="hidden" name="contact[subject]" value="Future Ziyu App Waitlist">

      <input type="text" name="contact[name]" placeholder="Your name" required>
      <input type="email" name="contact[email]" placeholder="Email address" required>

      <select name="contact[Interested apps]">
        <option>All Future Apps</option>
        <option>MyJourney</option>
        <option>Blokkr</option>
        <option>KindLitt</option>
        <option>Current Experiments</option>
      </select>

      <button type="submit">Join Future Waitlist</button>

      <div class="zdbeta-support-line">
        <span>Want to help more?</span>
        <a href="/pages/support">Support Development</a>
      </div>
    </form>

  </section>

</main>

{% schema %}
{
  "name": "Beta Access Page",
  "settings": [],
  "presets": [
    {
      "name": "Beta Access Page"
    }
  ]
}
{% endschema %}