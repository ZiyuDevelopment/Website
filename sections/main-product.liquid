<section class="gg-product-page">
  <div class="gg-container">
    <a href="/collections/all" class="gg-product-back">← Back to Store</a>

    <div class="gg-product-layout">
      <div class="gg-product-left">
        <div class="gg-product-media">
          <div class="gg-product-thumbs">
            {% for image in product.images %}
              <button
                type="button"
                class="gg-product-thumb {% if forloop.first %}is-active{% endif %}"
                data-product-image="{{ image | image_url: width: 1200 }}"
              >
                {{ image | image_url: width: 180 | image_tag: loading: 'lazy', alt: product.title }}
              </button>
            {% endfor %}
          </div>

          <div class="gg-product-main-image">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', alt: product.title }}
            {% else %}
              <div class="gg-product-placeholder large"></div>
            {% endif %}
          </div>
        </div>

        {% if product.description != blank %}
          <div class="gg-product-description-under">
            {{ product.description }}
          </div>
        {% endif %}
      </div>

      <div class="gg-product-panel">
        <span class="gg-kicker">{{ product.type | default: 'Ziyu Development' }}</span>
        <h1>{{ product.title }}</h1>

        <p class="gg-product-price" data-product-price>
          {{ product.selected_or_first_available_variant.price | money }}
        </p>

        {% form 'product', product, class: 'gg-product-form' %}
          <input
            type="hidden"
            name="id"
            value="{{ product.selected_or_first_available_variant.id }}"
            data-variant-id
          >

          {% unless product.has_only_default_variant %}
            <div class="gg-product-options">
              {% for option in product.options_with_values %}
                <label for="Option-{{ forloop.index }}">{{ option.name }}</label>

                <select id="Option-{{ forloop.index }}" data-option-position="{{ option.position }}">
                  {% for value in option.values %}
                    <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>
                      {{ value }}
                    </option>
                  {% endfor %}
                </select>
              {% endfor %}
            </div>
          {% endunless %}

          <div class="gg-product-quantity">
            <span>Quantity</span>

            <div class="gg-quantity-selector">
              <button type="button" class="gg-qty-btn" data-product-minus>−</button>

              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                class="gg-qty-input"
                data-product-quantity
              >

              <button type="button" class="gg-qty-btn" data-product-plus>+</button>
            </div>
          </div>

          <button
            type="submit"
            name="add"
            class="gg-product-add"
            {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
            data-add-button
          >
            {% if product.selected_or_first_available_variant.available %}
              Add to Cart
            {% else %}
              Sold Out
            {% endif %}
          </button>

          <button
            type="submit"
            name="checkout"
            class="gg-product-buy"
            {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
          >
            Buy Now
          </button>
        {% endform %}

        <div class="gg-product-trust">
          <div>
            <strong>Supports development</strong>
            <span>Purchases help fund Goal Grower testing and launch prep.</span>
          </div>

          <div>
            <strong>Secure checkout</strong>
            <span>Checkout is handled through Shopify.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="application/json" data-product-json>
  {{ product.variants | json }}
</script>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const variantsElement = document.querySelector('[data-product-json]');
  const variantInput = document.querySelector('[data-variant-id]');
  const optionSelectors = document.querySelectorAll('[data-option-position]');
  const price = document.querySelector('[data-product-price]');
  const addButton = document.querySelector('[data-add-button]');
  const quantityInput = document.querySelector('[data-product-quantity]');
  const minusButton = document.querySelector('[data-product-minus]');
  const plusButton = document.querySelector('[data-product-plus]');
  const mainImage = document.querySelector('.gg-product-main-image img');
  const thumbs = document.querySelectorAll('[data-product-image]');

  const variants = variantsElement ? JSON.parse(variantsElement.textContent) : [];

  function formatMoney(cents) {
    return '$' + (cents / 100).toFixed(2);
  }

  function getSelectedOptions() {
    return Array.from(optionSelectors).map(select => select.value);
  }

  function findVariant() {
    const selectedOptions = getSelectedOptions();

    return variants.find(variant => {
      return variant.options.every((option, index) => option === selectedOptions[index]);
    });
  }

  function updateVariant() {
    if (!optionSelectors.length) return;

    const variant = findVariant();

    if (!variant) {
      addButton.disabled = true;
      addButton.textContent = 'Unavailable';
      return;
    }

    variantInput.value = variant.id;

    if (price) {
      price.textContent = formatMoney(variant.price);
    }

    if (variant.available) {
      addButton.disabled = false;
      addButton.textContent = 'Add to Cart';
    } else {
      addButton.disabled = true;
      addButton.textContent = 'Sold Out';
    }
  }

  optionSelectors.forEach(select => {
    select.addEventListener('change', updateVariant);
  });

  if (minusButton && quantityInput) {
    minusButton.addEventListener('click', () => {
      const value = parseInt(quantityInput.value || 1, 10);
      quantityInput.value = Math.max(1, value - 1);
    });
  }

  if (plusButton && quantityInput) {
    plusButton.addEventListener('click', () => {
      const value = parseInt(quantityInput.value || 1, 10);
      quantityInput.value = value + 1;
    });
  }

  thumbs.forEach(button => {
  const preload = new Image();
  preload.src = button.dataset.productImage;

  button.addEventListener('click', () => {
    if (!mainImage) return;

    const imageUrl = button.dataset.productImage;

    mainImage.style.opacity = '0';

    setTimeout(() => {
      mainImage.src = imageUrl;
      mainImage.srcset = '';
      mainImage.removeAttribute('srcset');
      mainImage.removeAttribute('sizes');
      mainImage.style.opacity = '1';
    }, 80);

    thumbs.forEach(thumb => {
      thumb.classList.remove('is-active');
    });

    button.classList.add('is-active');
  });
});
});
</script>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}