<section class="gg-product-page">
  <div class="gg-container">

    <div class="gg-product-top">
      <div class="gg-product-gallery">
        <div class="gg-product-main-image">
          {% if product.featured_image %}
            {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: product.title }}
          {% else %}
            <div class="gg-product-placeholder large"></div>
          {% endif %}
        </div>

        {% if product.images.size > 1 %}
          <div class="gg-product-thumbs">
            {% for image in product.images %}
              <button type="button" class="gg-product-thumb" data-product-thumb="{{ image | image_url: width: 1200 }}">
                {{ image | image_url: width: 220 | image_tag: loading: 'lazy', alt: product.title }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="gg-product-buybox">
        <span class="gg-kicker">{{ product.type | default: 'Ziyu Development' }}</span>
        <h1>{{ product.title }}</h1>
        <p class="gg-product-price">{{ product.price | money }}</p>

        {% form 'product', product, class: 'gg-product-form' %}
          {% if product.has_only_default_variant == false %}
            <label for="ProductSelect">Choose an option</label>
            <select id="ProductSelect" name="id">
              {% for variant in product.variants %}
                <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
                  {{ variant.title }}{% unless variant.available %} - Sold out{% endunless %}
                </option>
              {% endfor %}
            </select>
          {% else %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {% endif %}

          <label for="Quantity">Quantity</label>
          <div class="gg-product-quantity">
            <button type="button" class="gg-product-qty-btn" data-product-minus>−</button>
            <input id="Quantity" type="number" name="quantity" value="1" min="1" class="gg-product-qty-input">
            <button type="button" class="gg-product-qty-btn" data-product-plus>+</button>
          </div>

          <button type="submit" name="add" class="gg-product-add" {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
          </button>
        {% endform %}

        <div class="gg-product-fast-notes">
          <span>Secure Shopify checkout</span>
          <span>Supports Goal Grower development</span>
        </div>
      </div>
    </div>

    <div class="gg-product-lower">
      <div class="gg-product-description-card">
        <span class="gg-kicker">Details</span>
        <h2>About this product</h2>

        {% if product.description != blank %}
          <div class="gg-product-description">
            {{ product.description }}
          </div>
        {% else %}
          <p>This product helps support Ziyu Development and the future of Goal Grower.</p>
        {% endif %}
      </div>

      <div class="gg-product-support-card">
        <span class="gg-kicker">Impact</span>
        <h2>Why it matters</h2>

        <div class="gg-product-notes">
          <div>
            <strong>Supports development</strong>
            <span>Purchases help fund Goal Grower testing, launch prep, and future features.</span>
          </div>

          <div>
            <strong>Built with purpose</strong>
            <span>Ziyu Development is focused on tools for growth, focus, learning, and intentional living.</span>
          </div>

          <div>
            <strong>Future projects</strong>
            <span>Support also helps make room for more apps and creative tools after launch.</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const input = document.querySelector('.gg-product-qty-input');
  const minus = document.querySelector('[data-product-minus]');
  const plus = document.querySelector('[data-product-plus]');
  const mainImage = document.querySelector('.gg-product-main-image img');
  const thumbs = document.querySelectorAll('[data-product-thumb]');

  if (input && minus && plus) {
    minus.addEventListener('click', () => {
      const value = parseInt(input.value || 1, 10);
      input.value = Math.max(1, value - 1);
    });

    plus.addEventListener('click', () => {
      const value = parseInt(input.value || 1, 10);
      input.value = value + 1;
    });
  }

  if (mainImage && thumbs.length) {
    thumbs.forEach(button => {
      button.addEventListener('click', () => {
        mainImage.src = button.dataset.productThumb;

        thumbs.forEach(item => item.classList.remove('is-active'));
        button.classList.add('is-active');
      });
    });
  }
});
</script>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}