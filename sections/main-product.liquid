<main class="zd-product-page">

  <section class="zd-product">

    <div class="zd-product-gallery">

      {% if product.images.size > 0 %}

        <div class="zd-product-main-image">

          <img
            src="{{ product.featured_image | image_url: width: 1400 }}"
            alt="{{ product.title }}"
            width="1400"
            height="1400"
          >

        </div>

        {% if product.images.size > 1 %}

          <div class="zd-product-thumbnails">

            {% for image in product.images %}

              <img
                src="{{ image | image_url: width: 300 }}"
                alt="{{ image.alt }}"
                width="300"
                height="300"
              >

            {% endfor %}

          </div>

        {% endif %}

      {% else %}

        {{ 'product-1' | placeholder_svg_tag: 'zd-product-placeholder' }}

      {% endif %}

    </div>

    <div class="zd-product-info">

      <p class="zd-product-type">
        {{ product.type }}
      </p>

      <h1>
        {{ product.title }}
      </h1>

      <div class="zd-product-price">
        {{ product.price | money }}
      </div>

      <div class="zd-product-description">
        {{ product.description }}
      </div>

      {% form 'product', product %}

        {% unless product.has_only_default_variant %}

          <div class="zd-product-variants">

            {% for option in product.options_with_values %}

              <label>{{ option.name }}</label>

              <select name="options[{{ option.name }}]">

                {% for value in option.values %}

                  <option>{{ value }}</option>

                {% endfor %}

              </select>

            {% endfor %}

          </div>

        {% endunless %}

        <div class="zd-product-buy">

          <input
            type="number"
            name="quantity"
            value="1"
            min="1"
          >

          <button type="submit">
            Add to Cart
          </button>

        </div>

      {% endform %}

      <div class="zd-product-benefits">

        <div>
          <strong>Thoughtfully Curated</strong>
          <span>Selected to support intentional living.</span>
        </div>

        <div>
          <strong>Supports Development</strong>
          <span>Purchases help fund future apps and projects.</span>
        </div>

        <div>
          <strong>Part of the Ecosystem</strong>
          <span>Connected to the Ziyu Development mission.</span>
        </div>

      </div>

    </div>

  </section>

  <section class="zd-product-story">

    <div>
      <p class="zd-product-eyebrow">
        Why this exists
      </p>

      <h2>
        Products should support a better life.
      </h2>
    </div>

    <div>

      <p>
        Every item in the store is chosen because it supports focus,
        growth, learning, reading, creativity, or intentional living.
      </p>

      <p>
        Purchases also directly support the development of Goal Grower,
        MyJourney, Blokkr, Kindlitt, and future projects.
      </p>

    </div>

  </section>

  <section class="zd-related-products">

    <div class="zd-related-header">

      <p class="zd-product-eyebrow">
        Related Products
      </p>

      <h2>
        You might also like
      </h2>

    </div>

    <div class="zd-related-grid">

      {% assign related_products = collections.all.products | limit: 4 %}

      {% for product in related_products %}

        <a href="{{ product.url }}" class="zd-related-card">

          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 600 }}"
              alt="{{ product.title }}"
              width="600"
              height="600"
            >
          {% endif %}

          <h3>{{ product.title }}</h3>

          <span>{{ product.price | money }}</span>

        </a>

      {% endfor %}

    </div>

  </section>

</main>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}