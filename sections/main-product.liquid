<section class="gg-product-page">
  <div class="gg-container gg-product-wide">
    <div class="gg-product-main">

      <div class="gg-product-gallery-card">
        {% if product.images.size > 1 %}
          <div class="gg-product-thumbs">
            {% for image in product.images %}
              <button
                type="button"
                class="gg-product-thumb {% if forloop.first %}is-active{% endif %}"
                data-product-thumb="{{ image | image_url: width: 1200 }}"
                data-image-alt="{{ image.alt | downcase | escape }}"
              >
                {{ image | image_url: width: 180 | image_tag: loading: 'lazy', alt: image.alt | default: product.title }}
              </button>
            {% endfor %}
          </div>
        {% endif %}

        <div class="gg-product-main-image">
          {% if product.featured_image %}
            {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: product.title, id: 'ProductMainImage' }}
          {% else %}
            <div class="gg-product-placeholder large"></div>
          {% endif %}
        </div>
      </div>

      <div class="gg-product-info-panel">
        <span class="gg-kicker">{{ product.type | default: 'Ziyu Development' }}</span>
        <h1>{{ product.title }}</h1>

        <div class="gg-product-rating">
          <span>★★★★★</span>
          <small>New product</small>
        </div>

        <div class="gg-product-price-row">
          <strong data-product-price>{{ product.selected_or_first_available_variant.price | money }}</strong>
          <span data-stock-status>{% if product.available %}In stock{% else %}Sold out{% endif %}</span>
        </div>

        {% form 'product', product, class: 'gg-product-form' %}
          <input
            type="hidden"
            name="id"
            value="{{ product.selected_or_first_available_variant.id }}"
            data-selected-variant
          >

          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              <div class="gg-option-group">
                <label>{{ option.name }}</label>

                <div class="gg-option-buttons" data-option-index="{{ forloop.index0 }}">
                  {% for value in option.values %}
                    <button
                      type="button"
                      class="gg-option-btn {% if option.selected_value == value %}is-selected{% endif %}"
                      data-option-value="{{ value | escape }}"
                      data-option-name="{{ option.name | downcase | escape }}"
                    >
                      {{ value }}
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          {% endunless %}

          <div class="gg-purchase-row">
            <div>
              <label>Quantity</label>

              <div class="gg-product-quantity">
                <button type="button" data-product-minus>−</button>
                <input type="number" name="quantity" value="1" min="1" data-product-quantity>
                <button type="button" data-product-plus>+</button>
              </div>
            </div>

            <div class="gg-product-total">
              <span>Total</span>
              <strong data-product-total>{{ product.selected_or_first_available_variant.price | money }}</strong>
            </div>
          </div>

          <button type="submit" name="add" class="gg-product-add" data-product-add {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
          </button>
        {% endform %}

        <div class="gg-product-trust">
          <div><strong>Secure checkout</strong><span>Powered by Shopify</span></div>
          <div><strong>Supports Goal Grower</strong><span>Helps fund testing and launch prep</span></div>
          <div><strong>Easy cart editing</strong><span>Change quantity before checkout</span></div>
        </div>
      </div>

    </div>

    <div class="gg-product-details-area">
      <div>
        <span class="gg-kicker">Product details</span>
        <h2>About this item</h2>
        <div class="gg-product-description">
          {{ product.description }}
        </div>
      </div>

      <div>
        <span class="gg-kicker">Why it matters</span>
        <h2>Every purchase helps the build.</h2>
        <p>
          Purchases help support Goal Grower development, beta testing, launch prep,
          and future intentional software projects from Ziyu Development.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const variants = {{ product.variants | json }};
  const variantInput = document.querySelector('[data-selected-variant]');
  const optionGroups = document.querySelectorAll('[data-option-index]');
  const priceText = document.querySelector('[data-product-price]');
  const totalText = document.querySelector('[data-product-total]');
  const qtyInput = document.querySelector('[data-product-quantity]');
  const minus = document.querySelector('[data-product-minus]');
  const plus = document.querySelector('[data-product-plus]');
  const mainImage = document.querySelector('#ProductMainImage');
  const thumbs = document.querySelectorAll('[data-product-thumb]');
  const addButton = document.querySelector('[data-product-add]');
  const stockStatus = document.querySelector('[data-stock-status]');

  let selectedOptions = [];

  optionGroups.forEach(group => {
    const index = Number(group.dataset.optionIndex);
    const selected = group.querySelector('.is-selected');
    selectedOptions[index] = selected ? selected.dataset.optionValue : '';
  });

  function money(cents) {
    return '$' + (cents / 100).toFixed(2);
  }

  function selectedVariant() {
    if (!variants.length) return null;

    if (!selectedOptions.length) {
      return variants[0];
    }

    return variants.find(variant =>
      variant.options.every((option, index) => option === selectedOptions[index])
    );
  }

  function setMainImage(src) {
    if (!mainImage || !src) return;
    mainImage.src = src;
  }

  function activateThumbBySrc(src) {
    if (!src) return;

    thumbs.forEach(thumb => {
      const thumbSrc = thumb.dataset.productThumb || '';
      thumb.classList.toggle('is-active', thumbSrc.includes(src.split('?')[0]) || src.includes(thumbSrc.split('?')[0]));
    });
  }

  function clickMatchingThumb(value) {
    if (!value) return;

    const searchValue = value.toLowerCase();

    const matchingThumb = Array.from(thumbs).find(thumb => {
      const alt = thumb.dataset.imageAlt || '';
      const imgAlt = thumb.querySelector('img')?.alt?.toLowerCase() || '';
      return alt.includes(searchValue) || imgAlt.includes(searchValue);
    });

    if (matchingThumb) {
      matchingThumb.click();
    }
  }

  function updateProduct() {
    const variant = selectedVariant();
    if (!variant) return;

    const quantity = Math.max(1, parseInt(qtyInput?.value || 1, 10));

    if (variantInput) variantInput.value = variant.id;
    if (priceText) priceText.textContent = money(variant.price);
    if (totalText) totalText.textContent = money(variant.price * quantity);

    if (stockStatus) {
      stockStatus.textContent = variant.available ? 'In stock' : 'Sold out';
    }

    if (addButton) {
      addButton.disabled = !variant.available;
      addButton.textContent = variant.available ? 'Add to Cart' : 'Sold Out';
    }

    if (variant.featured_image && mainImage) {
      setMainImage(variant.featured_image.src);
      activateThumbBySrc(variant.featured_image.src);
    }
  }

  thumbs.forEach(button => {
    button.addEventListener('click', () => {
      setMainImage(button.dataset.productThumb);

      thumbs.forEach(thumb => thumb.classList.remove('is-active'));
      button.classList.add('is-active');
    });
  });

  optionGroups.forEach(group => {
    group.querySelectorAll('.gg-option-btn').forEach(button => {
      button.addEventListener('click', () => {
        group.querySelectorAll('.gg-option-btn').forEach(btn => btn.classList.remove('is-selected'));
        button.classList.add('is-selected');

        selectedOptions[Number(group.dataset.optionIndex)] = button.dataset.optionValue;

        const optionName = button.dataset.optionName || '';

        if (
          optionName.includes('color') ||
          optionName.includes('colour') ||
          optionName.includes('hand') ||
          optionName.includes('style')
        ) {
          clickMatchingThumb(button.dataset.optionValue);
        }

        updateProduct();
      });
    });
  });

  if (minus && qtyInput) {
    minus.addEventListener('click', () => {
      qtyInput.value = Math.max(1, parseInt(qtyInput.value || 1, 10) - 1);
      updateProduct();
    });
  }

  if (plus && qtyInput) {
    plus.addEventListener('click', () => {
      qtyInput.value = parseInt(qtyInput.value || 1, 10) + 1;
      updateProduct();
    });
  }

  if (qtyInput) {
    qtyInput.addEventListener('input', updateProduct);
    qtyInput.addEventListener('change', () => {
      qtyInput.value = Math.max(1, parseInt(qtyInput.value || 1, 10));
      updateProduct();
    });
  }

  updateProduct();
});
</script>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}