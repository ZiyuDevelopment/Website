<section class="gg-product-page">
  <div class="gg-container gg-product-wide">
    <div class="gg-product-shell">
      <div class="gg-product-gallery">
        <div class="gg-product-main-image">
          {% if product.featured_image %}
            {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: product.title, id: 'ProductMainImage' }}
          {% else %}
            <div class="gg-product-placeholder large"></div>
          {% endif %}
        </div>

        {% if product.images.size > 1 %}
          <div class="gg-product-thumbs">
            {% for image in product.images %}
              <button
                type="button"
                class="gg-product-thumb"
                data-product-thumb="{{ image | image_url: width: 1200 }}"
              >
                {{ image | image_url: width: 240 | image_tag: loading: 'lazy', alt: product.title }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="gg-product-buybox">
        <span class="gg-kicker">{{ product.type | default: 'Ziyu Development' }}</span>
        <h1>{{ product.title }}</h1>

        <div class="gg-product-price-row">
          <strong data-product-price>{{ product.selected_or_first_available_variant.price | money }}</strong>
          <span>In stock</span>
        </div>

        {% form 'product', product, class: 'gg-product-form' %}
          <input
            type="hidden"
            name="id"
            value="{{ product.selected_or_first_available_variant.id }}"
            data-selected-variant
          >

          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              <div class="gg-option-group">
                <label>{{ option.name }}</label>

                <div class="gg-option-buttons" data-option-index="{{ forloop.index0 }}">
                  {% for value in option.values %}
                    <button
                      type="button"
                      class="gg-option-btn {% if option.selected_value == value %}is-selected{% endif %}"
                      data-option-value="{{ value | escape }}"
                    >
                      {{ value }}
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          {% endunless %}

          <div class="gg-product-quantity-row">
            <div>
              <label>Quantity</label>

              <div class="gg-product-quantity">
                <button type="button" class="gg-product-qty-btn" data-product-minus>−</button>
                <input type="number" name="quantity" value="1" min="1" class="gg-product-qty-input" data-product-quantity>
                <button type="button" class="gg-product-qty-btn" data-product-plus>+</button>
              </div>
            </div>

            <div class="gg-product-total">
              <span>Total</span>
              <strong data-product-total>{{ product.selected_or_first_available_variant.price | money }}</strong>
            </div>
          </div>

          <button type="submit" name="add" class="gg-product-add" {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
          </button>
        {% endform %}

        <div class="gg-product-trust">
          <span>Secure checkout</span>
          <span>Supports Goal Grower</span>
          <span>Ships through Shopify</span>
        </div>
      </div>
    </div>

    <div class="gg-product-lower">
      <div>
        <span class="gg-kicker">Details</span>
        <h2>Product details</h2>
        <div class="gg-product-description">
          {{ product.description }}
        </div>
      </div>

      <div>
        <span class="gg-kicker">Impact</span>
        <h2>Why this matters</h2>
        <p>
          Every purchase helps support Goal Grower development, testing, launch prep,
          and future intentional software projects.
        </p>
      </div>
    </div>

    <section class="gg-product-suggestions">
      <div class="gg-section-heading">
        <span class="gg-kicker">You may also like</span>
        <h2>More from the store.</h2>
      </div>

      <div class="gg-product-suggestion-grid">
        {% assign shown = 0 %}
        {% for related_product in collections.all.products %}
          {% if related_product.id != product.id and shown < 3 %}
            <a href="{{ related_product.url }}" class="gg-product-suggestion-card">
              <div class="gg-product-suggestion-image">
                {% if related_product.featured_image %}
                  {{ related_product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: related_product.title }}
                {% else %}
                  <div class="gg-product-placeholder"></div>
                {% endif %}
              </div>

              <strong>{{ related_product.title }}</strong>
              <p>{{ related_product.price | money }}</p>
            </a>

            {% assign shown = shown | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    </section>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const variants = {{ product.variants | json }};
  const selectedVariantInput = document.querySelector('[data-selected-variant]');
  const optionGroups = document.querySelectorAll('[data-option-index]');
  const priceText = document.querySelector('[data-product-price]');
  const totalText = document.querySelector('[data-product-total]');
  const qtyInput = document.querySelector('[data-product-quantity]');
  const minus = document.querySelector('[data-product-minus]');
  const plus = document.querySelector('[data-product-plus]');
  const mainImage = document.querySelector('#ProductMainImage');
  const thumbs = document.querySelectorAll('[data-product-thumb]');

  let selectedOptions = [];

  optionGroups.forEach(group => {
    const index = Number(group.dataset.optionIndex);
    const selected = group.querySelector('.is-selected');
    selectedOptions[index] = selected ? selected.dataset.optionValue : '';
  });

  function formatMoney(cents) {
    return '$' + (cents / 100).toFixed(2);
  }

  function getSelectedVariant() {
    return variants.find(variant => {
      return variant.options.every((option, index) => option === selectedOptions[index]);
    });
  }

  function updateProduct() {
    const variant = getSelectedVariant();

    if (!variant) return;

    selectedVariantInput.value = variant.id;

    if (priceText) priceText.textContent = formatMoney(variant.price);

    const quantity = Math.max(1, parseInt(qtyInput.value || 1, 10));
    if (totalText) totalText.textContent = formatMoney(variant.price * quantity);

    if (variant.featured_image && mainImage) {
      mainImage.src = variant.featured_image.src;
    }
  }

  optionGroups.forEach(group => {
    group.querySelectorAll('.gg-option-btn').forEach(button => {
      button.addEventListener('click', () => {
        const index = Number(group.dataset.optionIndex);

        group.querySelectorAll('.gg-option-btn').forEach(btn => {
          btn.classList.remove('is-selected');
        });

        button.classList.add('is-selected');
        selectedOptions[index] = button.dataset.optionValue;

        updateProduct();
      });
    });
  });

  if (minus && qtyInput) {
    minus.addEventListener('click', () => {
      qtyInput.value = Math.max(1, parseInt(qtyInput.value || 1, 10) - 1);
      updateProduct();
    });
  }

  if (plus && qtyInput) {
    plus.addEventListener('click', () => {
      qtyInput.value = parseInt(qtyInput.value || 1, 10) + 1;
      updateProduct();
    });
  }

  if (qtyInput) {
    qtyInput.addEventListener('input', updateProduct);
  }

  thumbs.forEach(button => {
    button.addEventListener('click', () => {
      if (mainImage) mainImage.src = button.dataset.productThumb;
      thumbs.forEach(item => item.classList.remove('is-active'));
      button.classList.add('is-active');
    });
  });

  updateProduct();
});
</script>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}