<section class="gg-product-page">
  <div class="gg-container">
    <a href="/collections/all" class="gg-product-back">
      <span>←</span>
      Back to Store
    </a>

    {% assign color_option_position = 0 %}

    {% for option in product.options_with_values %}
      {% assign option_name = option.name | downcase %}
      {% if option_name contains 'color' or option_name contains 'colour' %}
        {% assign color_option_position = option.position %}
      {% endif %}
    {% endfor %}

    <div class="gg-product-layout">
      <div class="gg-product-left">
        <div class="gg-product-media">
          <div class="gg-product-thumbs-wrap">
            <button type="button" class="gg-thumb-arrow" data-thumb-up>↑</button>

            <div class="gg-product-thumbs" data-product-thumbs>
              {% for image in product.images %}
                {% assign image_colors = '' %}

                {% for variant in product.variants %}
                  {% if variant.featured_image and variant.featured_image.id == image.id %}
                    {% case color_option_position %}
                      {% when 1 %}
                        {% assign image_colors = image_colors | append: variant.option1 | append: '|' %}
                      {% when 2 %}
                        {% assign image_colors = image_colors | append: variant.option2 | append: '|' %}
                      {% when 3 %}
                        {% assign image_colors = image_colors | append: variant.option3 | append: '|' %}
                    {% endcase %}
                  {% endif %}
                {% endfor %}

                <button
                  type="button"
                  class="gg-product-thumb {% if forloop.first %}is-active{% endif %}"
                  data-product-image="{{ image | image_url: width: 1200 }}"
                  data-image-colors="{{ image_colors | downcase | escape }}"
                  data-image-alt="{{ image.alt | downcase | escape }}"
                  data-image-src="{{ image.src | downcase | escape }}"
                  data-image-index="{{ forloop.index0 }}"
                >
                  {{ image | image_url: width: 180 | image_tag: loading: 'lazy', alt: product.title }}
                </button>
              {% endfor %}
            </div>

            <button type="button" class="gg-thumb-arrow" data-thumb-down>↓</button>
          </div>

          <div class="gg-product-main-image">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', alt: product.title }}
            {% else %}
              <div class="gg-product-placeholder large"></div>
            {% endif %}
          </div>
        </div>

        {% if product.description != blank %}
          <div class="gg-product-description-under">
            {{ product.description }}
          </div>
        {% endif %}
      </div>

      <div class="gg-product-panel">
        <span class="gg-kicker">{{ product.type | default: 'Ziyu Development' }}</span>
        <h1>{{ product.title }}</h1>

        <p class="gg-product-price" data-product-price>
          {{ product.selected_or_first_available_variant.price | money }}
        </p>

        {% form 'product', product, class: 'gg-product-form' %}
          <input
            type="hidden"
            name="id"
            value="{{ product.selected_or_first_available_variant.id }}"
            data-variant-id
          >

          {% unless product.has_only_default_variant %}
            <div class="gg-product-options">
              {% for option in product.options_with_values %}
                {% assign option_name = option.name | downcase %}

                <div
                  class="gg-option-group"
                  data-option-group
                  data-option-position="{{ option.position }}"
                  data-option-name="{{ option_name }}"
                >
                  <span class="gg-option-label">
                      {{ option.name }}:
                      {% if option_name contains 'color' or option_name contains 'colour' %}
                        <span
                            class="gg-color-dot"
                            data-color-dot="{{ value | handleize }}"
                          ></span>
                      {% endif %}
                      <strong data-option-selected>{{ option.selected_value }}</strong>
                    </span>

                  <div class="gg-option-values {% if option_name contains 'color' or option_name contains 'colour' %}gg-color-options{% else %}gg-size-options{% endif %}">
                    {% for value in option.values %}
                      {% assign color_value = value | downcase %}

                      <button
                        type="button"
                        class="gg-option-button {% if option_name contains 'color' or option_name contains 'colour' %}gg-color-dot-option{% else %}gg-size-option{% endif %} {% if option.selected_value == value %}is-active{% endif %}"
                        data-option-value="{{ value | escape }}"
                      >
                        {% if option_name contains 'color' or option_name contains 'colour' %}
                          <span
                            class="gg-color-dot"
                            style="background: {{ color_value }};"
                          ></span>
                          <span>{{ value }}</span>
                        {% else %}
                          {{ value }}
                        {% endif %}
                      </button>
                    {% endfor %}
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endunless %}

          <div class="gg-product-quantity">
            <span>Quantity</span>

            <div class="gg-quantity-selector">
              <button type="button" class="gg-qty-btn" data-product-minus>−</button>

              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                class="gg-qty-input"
                data-product-quantity
              >

              <button type="button" class="gg-qty-btn" data-product-plus>+</button>
            </div>
          </div>

          <button
            type="submit"
            name="add"
            class="gg-product-add"
            {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
            data-add-button
          >
            {% if product.selected_or_first_available_variant.available %}
              Add to Cart
            {% else %}
              Sold Out
            {% endif %}
          </button>

          <button
            type="submit"
            name="checkout"
            class="gg-product-buy"
            {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
          >
            Buy Now
          </button>
        {% endform %}

        <div class="gg-product-trust">
          <div>
            <strong>Supports development</strong>
            <span>Purchases help fund Goal Grower testing and launch prep.</span>
          </div>

          <div>
            <strong>Secure checkout</strong>
            <span>Checkout is handled through Shopify.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="application/json" data-product-json>
  {{ product.variants | json }}
</script>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}