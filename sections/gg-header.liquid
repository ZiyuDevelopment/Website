<div class="gg-announcement-bar">
  <div class="gg-announcement-track">
    <span> Free shipping on orders over $40</span>
    <span> Every purchase helps fund Goal Grower</span>
    <span> Join beta testing and shape the app</span>

    <span> Free shipping on orders over $40</span>
    <span> Every purchase helps fund Goal Grower</span>
    <span> Join beta testing and shape the app</span>
  </div>
</div>

<header class="gg-header" data-header>
  <a class="gg-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
    <span class="gg-logo-mark">
      <span class="gg-leaf-icon"></span>
    </span>
    <span>{{ shop.name }}</span>
  </a>

  <nav class="gg-nav" aria-label="Main navigation">
    <a href="{{ routes.root_url }}">Home</a>
    <a href="/pages/about">About</a>
    <a href="/pages/support">Support</a>
    <a href="/collections/all">Store</a>
    <a href="/pages/contact">Contact</a>
  </nav>

  <div class="gg-header-actions">
    <a href="{{ routes.cart_url }}" class="gg-cart-link" aria-label="Cart">

  <svg class="gg-cart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="9" cy="20" r="1"></circle>
    <circle cx="18" cy="20" r="1"></circle>
    <path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L22 8H7"></path>
  </svg>

  {% assign custom_support_handle = 'custom-support-goal-grower' %}
  {% assign real_cart_count = 0 %}

  {% for item in cart.items %}
    {% if item.product.handle == custom_support_handle %}
      {% assign real_cart_count = real_cart_count | plus: 1 %}
    {% else %}
      {% assign real_cart_count = real_cart_count | plus: item.quantity %}
    {% endif %}
  {% endfor %}

  {% if real_cart_count > 0 %}
    <span class="gg-cart-bubble">{{ real_cart_count }}</span>
  {% endif %}
</a>

    <a href="{{ routes.account_url }}" class="gg-btn gg-btn-small">
      Profile
    </a>
  </div>

  <button class="gg-menu-btn" type="button" data-menu-toggle aria-label="Open menu">
    <span></span>
    <span></span>
  </button>

  <div class="gg-mobile-menu" data-mobile-menu>
    <a href="{{ routes.root_url }}">Home</a>
    <a href="/pages/about">About</a>
    <a href="/pages/support">Support</a>
    <a href="{{ routes.collections_url }}">Store</a>
    <a href="/pages/contact">Contact</a>
    <a href="{{ routes.cart_url }}">Cart</a>
    <a href="{{ routes.account_url }}">Profile</a>
  </div>
</header>

{% schema %}
{
  "name": "Goal Grower Header",
  "settings": [],
  "presets": [{ "name": "Goal Grower Header" }]
}
{% endschema %}