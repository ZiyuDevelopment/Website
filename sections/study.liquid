<section class="px-margin-mobile md:px-margin-desktop py-24 md:py-32 bg-surface">
  <div class="max-w-container-max mx-auto">

    <section class="mb-20 text-center md:text-left">
      <span class="block uppercase tracking-[0.2em] text-label-md text-secondary mb-6">
        Member Access
      </span>

      <h1 class="font-headline-xl text-headline-xl md:text-[88px] leading-[0.95] tracking-[-0.04em] mb-6">
        Welcome back, Scholar.
      </h1>

      <p class="text-body-lg text-on-surface-variant max-w-2xl">
        The Study is yours. A quiet corner for intentional growth, reflection, reading, and deep work.
      </p>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">

      <div class="md:col-span-8 bg-surface-container-low border border-outline-variant/30 rounded-2xl p-10 min-h-[420px] relative overflow-hidden">
        <div class="relative z-10 flex flex-col h-full">
          <div class="flex justify-between items-start gap-6 mb-10">
            <span class="text-label-md uppercase tracking-[0.2em] text-secondary flex items-center gap-2">
              <span class="material-symbols-outlined text-[18px]">auto_awesome</span>
              Daily Prompt
            </span>

            <button class="flex items-center gap-2 px-3 py-1.5 hover:bg-surface-container rounded-full text-secondary hover:text-primary">
              <span class="material-symbols-outlined text-[18px]">refresh</span>
              <span class="text-[10px] uppercase tracking-widest">New Prompt</span>
            </button>
          </div>

          <h2 class="font-headline-lg text-headline-lg max-w-2xl italic mb-12">
            “What is one habit you have outgrown that no longer serves your intention?”
          </h2>

          <textarea
            placeholder="Write your reflection here..."
            class="w-full bg-transparent border-b border-outline/20 focus:border-primary focus:ring-0 font-headline-md text-headline-md italic py-4 resize-none transition-all placeholder:text-outline/40"
            rows="3"
          ></textarea>

          <div class="mt-auto pt-12 flex flex-wrap gap-4">
            <button class="bg-primary text-on-primary px-8 py-3 text-label-md uppercase tracking-[0.15em] flex items-center gap-2 hover:opacity-90">
              Save Reflection
              <span class="material-symbols-outlined text-[16px]">done_all</span>
            </button>

            <button class="border border-outline/20 text-on-surface px-8 py-3 text-label-md uppercase tracking-[0.15em] hover:bg-surface-container">
              Skip Today
            </button>
          </div>
        </div>

        <div class="absolute right-[-10%] bottom-[-10%] opacity-5 select-none pointer-events-none">
          <span class="material-symbols-outlined text-[360px]">edit_note</span>
        </div>
      </div>

      <div class="md:col-span-4 bg-surface-dim border border-outline-variant/30 rounded-2xl p-8 flex flex-col justify-between">
        <div>
          <span class="block text-label-md uppercase tracking-[0.2em] text-secondary mb-8">
            My Progress
          </span>

          <div class="space-y-8">
            <div>
              <span class="block text-[10px] uppercase tracking-[0.2em] text-on-surface-variant mb-1">
                Articles Read
              </span>
              <div class="flex items-baseline gap-2">
                <span class="font-headline-lg text-headline-lg">12</span>
                <span class="text-on-surface-variant italic">this month</span>
              </div>
            </div>

            <div>
              <span class="block text-[10px] uppercase tracking-[0.2em] text-on-surface-variant mb-1">
                Focus Time
              </span>
              <div class="flex items-baseline gap-2">
                <span class="font-headline-lg text-headline-lg">42</span>
                <span class="text-on-surface-variant italic">hours total</span>
              </div>
            </div>

            <div>
              <span class="block text-[10px] uppercase tracking-[0.2em] text-on-surface-variant mb-1">
                Streak
              </span>
              <div class="flex items-baseline gap-2">
                <span class="font-headline-lg text-headline-lg">07</span>
                <span class="text-on-surface-variant italic">days mindful</span>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-8 border-t border-outline/10">
          <a class="text-label-md uppercase tracking-[0.15em] text-primary flex items-center justify-between group" href="#">
            Full Analytics
            <span class="material-symbols-outlined transition-transform group-hover:translate-x-1">arrow_forward</span>
          </a>
        </div>
      </div>

      <div class="md:col-span-12 mt-8">
        <div class="flex items-center justify-between mb-8 border-b border-outline/10 pb-4">
          <h3 class="font-headline-md text-headline-md">Saved for Later</h3>

          <a class="text-label-md uppercase tracking-[0.15em] text-secondary hover:text-primary underline decoration-outline/30 underline-offset-4" href="/pages/deep-work-library">
            View All Archive
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">

          <article class="group">
            <div class="aspect-[4/3] bg-surface-container-high overflow-hidden mb-4 relative rounded-xl border border-outline-variant/30">
              <img
                alt="Journaling"
                width="1200"
                height="900"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                src="https://images.unsplash.com/photo-1455390582262-044cdead277a?q=80&w=1200&auto=format&fit=crop"
              >
              <div class="absolute top-4 right-4">
                <span class="bg-surface/90 backdrop-blur-sm px-3 py-1 text-[10px] uppercase tracking-[0.15em] border border-outline/10">
                  12 Min Read
                </span>
              </div>
            </div>

            <span class="text-label-md uppercase tracking-[0.15em] text-secondary block mb-2">
              Philosophy
            </span>

            <h4 class="font-headline-md text-[24px] mb-2 leading-tight">
              The Ethics of Intentional Disconnection
            </h4>

            <p class="text-body-md text-on-surface-variant">
              Exploring the boundaries between digital utility and the erosion of human presence.
            </p>
          </article>

          <article class="group">
            <div class="aspect-[4/3] bg-surface-container-high overflow-hidden mb-4 relative rounded-xl border border-outline-variant/30">
              <img
                alt="Tranquility"
                width="1200"
                height="900"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?q=80&w=1200&auto=format&fit=crop"
              >
              <div class="absolute top-4 right-4">
                <span class="bg-surface/90 backdrop-blur-sm px-3 py-1 text-[10px] uppercase tracking-[0.15em] border border-outline/10">
                  8 Min Read
                </span>
              </div>
            </div>

            <span class="text-label-md uppercase tracking-[0.15em] text-secondary block mb-2">
              Practice
            </span>

            <h4 class="font-headline-md text-[24px] mb-2 leading-tight">
              Designing Your Physical Sanctuary
            </h4>

            <p class="text-body-md text-on-surface-variant">
              How our immediate environment shapes cognitive load and deep work.
            </p>
          </article>

          <article class="group">
            <div class="aspect-[4/3] bg-surface-container-high overflow-hidden mb-4 relative rounded-xl border border-outline-variant/30">
              <img
                alt="Paper texture"
                width="1200"
                height="900"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                src="https://images.unsplash.com/photo-1517971071642-34a2d3ecc9cd?q=80&w=1200&auto=format&fit=crop"
              >
              <div class="absolute top-4 right-4">
                <span class="bg-surface/90 backdrop-blur-sm px-3 py-1 text-[10px] uppercase tracking-[0.15em] border border-outline/10">
                  15 Min Read
                </span>
              </div>
            </div>

            <span class="text-label-md uppercase tracking-[0.15em] text-secondary block mb-2">
              Essay
            </span>

            <h4 class="font-headline-md text-[24px] mb-2 leading-tight">
              The Permanence of the Printed Word
            </h4>

            <p class="text-body-md text-on-surface-variant">
              Why physical artifacts remain an anchor for long-form thought.
            </p>
          </article>

        </div>
      </div>

    </div>
  </div>
</section>

<section class="px-margin-mobile md:px-margin-desktop py-32 bg-primary text-on-primary">
  <div class="max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-2 gap-gutter items-center">

    <div>
      <span class="block uppercase tracking-[0.2em] text-label-md opacity-70 mb-6">
        The Study
      </span>

      <h2 class="font-headline-lg text-headline-lg md:text-[72px] leading-tight">
        A quiet member space for continued reflection.
      </h2>
    </div>

    <div class="space-y-8">
      <p class="text-body-lg opacity-80">
        Future versions of The Study can connect saved essays, personal notes, focus analytics, and member-only archive access.
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="/pages/settings" class="bg-surface text-on-surface px-7 py-3 rounded-full">
          Account Settings
        </a>

        <a href="/pages/deep-work-library" class="border border-white/30 px-7 py-3 rounded-full">
          Browse Library
        </a>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Study",
  "settings": [],
  "presets": [
    {
      "name": "Study"
    }
  ]
}
{% endschema %}