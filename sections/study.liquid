<section class="ziyu-section">
  <div class="ziyu-container">
    <div class="ziyu-study-hero">
      <div>
        <span class="ziyu-label">Member Access</span>

        <h1 class="ziyu-h1">
          Welcome back, Scholar.
        </h1>

        <p class="ziyu-body-lg" style="margin-top: 28px;">
          The Study is a quiet member space for reflection, saved essays, focus progress, and archive access.
        </p>
      </div>

      <a href="/pages/settings" class="ziyu-button ziyu-button--ghost">
        Account Settings
      </a>
    </div>

    <div class="ziyu-study-grid">

      <div class="ziyu-card ziyu-study-prompt">
        <span class="ziyu-label">Daily Prompt</span>

        <h2 class="ziyu-h3" style="font-style: italic;">
          “What is one habit you have outgrown that no longer serves your intention?”
        </h2>

        <textarea
          class="ziyu-textarea"
          placeholder="Write your reflection here..."
        ></textarea>

        <div class="ziyu-study-actions">
          <button class="ziyu-button">Save Reflection</button>
          <button class="ziyu-button ziyu-button--ghost">Skip Today</button>
        </div>
      </div>

      <aside class="ziyu-card ziyu-study-progress">
        <span class="ziyu-label">My Progress</span>

        <div class="ziyu-progress-list">
          <div>
            <span class="ziyu-label ziyu-label--muted">Articles Read</span>
            <p class="ziyu-h3">12 <span>this month</span></p>
          </div>

          <div>
            <span class="ziyu-label ziyu-label--muted">Focus Time</span>
            <p class="ziyu-h3">42 <span>hours total</span></p>
          </div>

          <div>
            <span class="ziyu-label ziyu-label--muted">Streak</span>
            <p class="ziyu-h3">07 <span>days mindful</span></p>
          </div>
        </div>
      </aside>

    </div>

    <section class="ziyu-saved">
      <div class="ziyu-saved__header">
        <h2 class="ziyu-h3">Saved for Later</h2>
        <a href="/pages/deep-work-library" class="ziyu-card-link">View All Archive →</a>
      </div>

      <div class="ziyu-article-grid">

        <article class="ziyu-card">
          <div class="ziyu-article-card__image">
            <img
              class="ziyu-image"
              src="https://images.unsplash.com/photo-1455390582262-044cdead277a?q=80&w=1200&auto=format&fit=crop"
              alt="Journaling"
              width="1200"
              height="900"
            >
          </div>

          <div class="ziyu-article-card__content">
            <span class="ziyu-label ziyu-label--muted">Philosophy · 12 min</span>
            <h3 class="ziyu-h4">The Ethics of Intentional Disconnection</h3>
            <p class="ziyu-body">Exploring digital utility and human presence.</p>
          </div>
        </article>

        <article class="ziyu-card">
          <div class="ziyu-article-card__image">
            <img
              class="ziyu-image ziyu-grayscale"
              src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?q=80&w=1200&auto=format&fit=crop"
              alt="Tranquility"
              width="1200"
              height="900"
            >
          </div>

          <div class="ziyu-article-card__content">
            <span class="ziyu-label ziyu-label--muted">Practice · 8 min</span>
            <h3 class="ziyu-h4">Designing Your Physical Sanctuary</h3>
            <p class="ziyu-body">How environment shapes deep work.</p>
          </div>
        </article>

        <article class="ziyu-card">
          <div class="ziyu-article-card__image">
            <img
              class="ziyu-image"
              src="https://images.unsplash.com/photo-1517971071642-34a2d3ecc9cd?q=80&w=1200&auto=format&fit=crop"
              alt="Paper texture"
              width="1200"
              height="900"
            >
          </div>

          <div class="ziyu-article-card__content">
            <span class="ziyu-label ziyu-label--muted">Essay · 15 min</span>
            <h3 class="ziyu-h4">The Permanence of the Printed Word</h3>
            <p class="ziyu-body">Why physical artifacts anchor long-form thought.</p>
          </div>
        </article>

      </div>
    </section>
  </div>
</section>

{% schema %}
{
  "name": "Study",
  "settings": [],
  "presets": [
    {
      "name": "Study"
    }
  ]
}
{% endschema %}