        alt="Minimal architecture"
        width="1000"
        height="1000"
        loading="lazy"
      >
    </div>

    <div>
      <p class="zd-philosophy-eyebrow">The Future</p>
      <h2>A complete ecosystem for intentional living.</h2>
      <p>
        Ziyu Development is becoming an interconnected ecosystem of apps,
        physical products, educational resources, and communities designed to
        help people reclaim focus and build better lives.
      </p>

      <a href="/pages/roadmap" class="zd-philosophy-roadmap">View the Roadmap</a>
    </div>
  </section>

</main>

