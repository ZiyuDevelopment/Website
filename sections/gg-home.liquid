<section class="gg-hero">
  <div class="gg-bg-orb orb-one"></div>
  <div class="gg-bg-orb orb-two"></div>

  <div class="gg-container gg-hero-grid">
    <div class="gg-hero-copy reveal">
      <span class="gg-kicker">Goal Grower App</span>

      <h1>Grow into the person you are becoming.</h1>

      <p>
        A calming goal tracker where habits, big goals, and shared progress become a living garden you actually want to return to.
      </p>

      <div class="gg-hero-actions">
        <a href="/pages/support" class="gg-btn">Support Development</a>
        <a href="#screenshots" class="gg-btn-soft">See the App</a>
      </div>
    </div>

    <div class="gg-phone-showcase reveal">
      <div class="gg-android-phone main-phone">
        <div class="gg-phone-camera"></div>
        <div class="gg-phone-screen">
          <div class="gg-screenshot-slot">
            <span>Add Screenshot</span>
            <small>Garden Home Screen</small>
          </div>
        </div>
      </div>

      <div class="gg-mini-phone phone-float-one">
        <div class="gg-phone-camera small"></div>
        <div class="gg-phone-screen">
          <div class="gg-screenshot-slot small">
            <span>Add Screenshot</span>
          </div>
        </div>
      </div>

      <div class="gg-human-note">
        <strong>Small actions count.</strong>
        <span>3 goals watered today</span>
      </div>
    </div>
  </div>
</section>

<section class="gg-section gg-story">
  <div class="gg-container">
    <div class="gg-section-heading reveal">
      <span class="gg-kicker">The feeling</span>
      <h2>Progress should feel peaceful, not punishing.</h2>
      <p>
        Goal Grower is designed for imperfect days, fresh starts, long-term growth, and the kind of motivation that feels human.
      </p>
    </div>

    <div class="gg-card-grid">
      <div class="gg-info-card reveal">
        <span class="gg-number">01</span>
        <h3>Plant a goal</h3>
        <p>Create a habit, project, spiritual goal, school goal, health goal, or personal dream.</p>
      </div>

      <div class="gg-info-card reveal">
        <span class="gg-number">02</span>
        <h3>Water it with action</h3>
        <p>Your effort becomes visible as your plant grows through consistent progress.</p>
      </div>

      <div class="gg-info-card reveal">
        <span class="gg-number">03</span>
        <h3>Return without shame</h3>
        <p>The app is built to help you come back, restart, and keep growing.</p>
      </div>
    </div>
  </div>
</section>

<section class="gg-section gg-dark-band">
  <div class="gg-container gg-two-col">
    <div class="reveal">
      <span class="gg-kicker light">App functionality</span>
      <h2>Built for habits, big goals, and shared gardens.</h2>
    </div>

    <div class="gg-function-list reveal">
      <div>
        <strong>Personal garden</strong>
        <span>See your goals in one visual, calming place.</span>
      </div>

      <div>
        <strong>Shared gardens</strong>
        <span>Grow with friends, family, classmates, or accountability partners.</span>
      </div>

      <div>
        <strong>Living progress</strong>
        <span>Your effort becomes something you can see, care about, and return to.</span>
      </div>
    </div>
  </div>
</section>

<section class="gg-section gg-screenshots" id="screenshots">
  <div class="gg-container">
    <div class="gg-section-heading reveal">
      <span class="gg-kicker">App preview</span>
      <h2>Place your real app screenshots here.</h2>
      <p>
        These Android phone frames are made for your Goal Grower screenshots. Replace each placeholder with an image.
      </p>
    </div>

    <div class="gg-phone-grid">
      <div class="gg-android-phone reveal">
        <div class="gg-phone-camera"></div>
        <div class="gg-phone-screen">
          <div class="gg-screenshot-slot">
            <span>Add Screenshot</span>
            <small>Garden Dashboard</small>
          </div>
        </div>
      </div>

      <div class="gg-android-phone reveal">
        <div class="gg-phone-camera"></div>
        <div class="gg-phone-screen">
          <div class="gg-screenshot-slot">
            <span>Add Screenshot</span>
            <small>Goal Creation</small>
          </div>
        </div>
      </div>

      <div class="gg-android-phone reveal">
        <div class="gg-phone-camera"></div>
        <div class="gg-phone-screen">
          <div class="gg-screenshot-slot">
            <span>Add Screenshot</span>
            <small>Shared Garden</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="gg-section gg-products-section">
  <div class="gg-container">
    <div class="gg-section-heading reveal">
      <span class="gg-kicker">Store</span>
      <h2>Support the app and future products.</h2>
      <p>
        The store can support Goal Grower, future apps, digital tools, physical products, and intentional living resources.
      </p>
    </div>

    <div class="gg-product-lanes">
      <a href="{{ routes.collections_url }}" class="gg-lane-card reveal">
        <h3>Goal Grower Support</h3>
        <p>Help fund development, design, testing, and future features.</p>
      </a>

      <a href="{{ routes.collections_url }}" class="gg-lane-card reveal">
        <h3>Digital Products</h3>
        <p>Templates, planners, resources, and tools for intentional growth.</p>
      </a>

      <a href="{{ routes.collections_url }}" class="gg-lane-card reveal">
        <h3>Physical Products</h3>
        <p>Merch, desk items, calming productivity objects, and future products.</p>
      </a>
    </div>
  </div>
</section>

<section class="gg-final-cta">
  <div class="gg-container reveal">
    <span class="gg-kicker">The mission</span>
    <h2>Build a life you can keep returning to.</h2>
    <p>
      Goal Grower is about making progress feel human, hopeful, and worth caring about.
    </p>
    <a href="/pages/support" class="gg-btn">Support the Mission</a>
  </div>
</section>

{% schema %}
{
  "name": "Goal Grower Home",
  "settings": [],
  "presets": [{ "name": "Goal Grower Home" }]
}
{% endschema %}