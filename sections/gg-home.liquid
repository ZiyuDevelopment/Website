<section class="gg-hero">
  <div class="gg-container">
    <div class="gg-hero-grid">

      <div class="gg-hero-content">
        <span class="gg-badge">
          🌱 Goal Grower Beta
        </span>

        <h1>
          Grow goals that
          actually stick.
        </h1>

        <p>
          Every goal becomes a living plant.
          Show up consistently and watch your garden flourish.
          Miss too many days and your plants begin to wilt.
        </p>

        <div class="gg-hero-actions">
          <a href="/pages/support" class="gg-btn">
            Support Development
          </a>

          <a href="/pages/about" class="gg-btn-outline">
            Learn More
          </a>
        </div>
      </div>

      <div class="gg-hero-visual">
        <div class="garden-card">
          <img
            src="https://cdn.shopify.com/s/files/1/0000/0000/files/goal-grower-phone.png"
            alt="Goal Grower"
          >
        </div>
      </div>

    </div>
  </div>
</section>

<section class="gg-stack-wrapper">

  <div class="gg-stack-card">
    <div class="gg-container">

      <h2>
        Most goal trackers are
        just lists.
      </h2>

      <div class="gg-problems">

        <div class="problem-card">
          ❌ Empty checkboxes
        </div>

        <div class="problem-card">
          ❌ Forgotten goals
        </div>

        <div class="problem-card">
          ❌ Lost motivation
        </div>

      </div>

      <p class="gg-large-text">
        Goals need something worth caring about.
      </p>

    </div>
  </div>

  <div class="gg-stack-card">

    <div class="gg-container">

      <h2>
        Meet Goal Grower
      </h2>

      <p>
        Your goals become living plants.
        Every action helps them grow.
        Every missed commitment has consequences.
      </p>

      <div class="growth-stages">

        <div class="growth-stage">
          🌱
          <span>Seed</span>
        </div>

        <div class="growth-stage">
          🌿
          <span>Sprout</span>
        </div>

        <div class="growth-stage">
          🪴
          <span>Plant</span>
        </div>

        <div class="growth-stage">
          🌻
          <span>Bloom</span>
        </div>

      </div>

    </div>

  </div>

  <div class="gg-stack-card">

    <div class="gg-container">

      <h2>
        Build a Garden
      </h2>

      <p>
        A goal is just the beginning.
        A garden is the result.
      </p>

      <div class="screens-grid">

        <div class="screen-card">
          <img src="https://cdn.shopify.com/s/files/1/0000/0000/files/screen1.png">
        </div>

        <div class="screen-card">
          <img src="https://cdn.shopify.com/s/files/1/0000/0000/files/screen2.png">
        </div>

        <div class="screen-card">
          <img src="https://cdn.shopify.com/s/files/1/0000/0000/files/screen3.png">
        </div>

      </div>

    </div>

  </div>

  <div class="gg-stack-card">

    <div class="gg-container">

      <h2>
        Grow Together
      </h2>

      <p>
        Create shared gardens with friends,
        family, and accountability partners.
      </p>

      <div class="shared-garden-card">
        🌱 🌱 🌱 🌱 🌱
      </div>

    </div>

  </div>

</section>

<section class="gg-timeline">

  <div class="gg-container">

    <h2>
      The Life Of A Goal
    </h2>

    <div class="timeline-track">

      <div class="timeline-step">
        🌱
        <span>Plant</span>
      </div>

      <div class="timeline-step">
        💧
        <span>Water</span>
      </div>

      <div class="timeline-step">
        🌿
        <span>Grow</span>
      </div>

      <div class="timeline-step">
        🌻
        <span>Bloom</span>
      </div>

      <div class="timeline-step">
        🏆
        <span>Achieve</span>
      </div>

    </div>

  </div>

</section>

<section class="gg-final-cta">

  <div class="gg-container">

    <h2>
      What could your garden
      look like in a year?
    </h2>

    <p>
      Start planting today.
    </p>

    <a href="/pages/support" class="gg-btn">
      Support Development
    </a>

  </div>

</section>

{% schema %}
{
  "name": "Goal Grower Home",
  "settings": [],
  "presets": [
    {
      "name": "Goal Grower Home"
    }
  ]
}
{% endschema %}