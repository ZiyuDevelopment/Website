<section class="gg-hero gg-human-hero">
  <div class="gg-container gg-human-grid">
    <div class="gg-hero-copy">
      <span class="gg-kicker">Goal Grower Beta</span>

      <h1>Make progress feel alive again.</h1>

      <p>
        Goal Grower turns habits, big goals, and shared commitments into a living
        garden you actually want to return to.
      </p>

      <div class="gg-hero-actions">
        <a href="/pages/support" class="gg-btn">Support Development</a>
        <a href="/pages/about" class="gg-text-link">See the story</a>
      </div>
    </div>

    <div class="gg-human-visual">
      <div class="gg-soft-card gg-phone-card">
        <div class="gg-phone">
          <div class="gg-phone-top"></div>

          <div class="gg-plant-world">
            <span class="gg-plant p1"></span>
            <span class="gg-plant p2"></span>
            <span class="gg-plant p3"></span>
          </div>

          <div class="gg-ui-line"></div>
          <div class="gg-ui-line short"></div>
        </div>
      </div>

      <div class="gg-note-card">
        <strong>Today’s progress</strong>
        <span>3 goals watered</span>
      </div>
    </div>
  </div>
</section>

<section class="gg-story-section">
  <div class="gg-container gg-editorial">
    <span class="gg-kicker">The problem</span>

    <h2>Most goal trackers feel too mechanical.</h2>

    <p>
      Goal Grower is designed for real life — imperfect days, restarts, shared
      encouragement, and slow visible growth.
    </p>
  </div>
</section>

<section class="gg-flow-section">
  <div class="gg-container">
    <div class="gg-flow-grid">
      <div class="gg-flow-card">
        <span class="plant-mark seed"></span>
        <h3>Plant</h3>
        <p>Choose a goal and give it a place in your garden.</p>
      </div>

      <div class="gg-flow-card tall">
        <span class="plant-mark sprout"></span>
        <h3>Water</h3>
        <p>Complete small actions that keep your goal alive.</p>
      </div>

      <div class="gg-flow-card">
        <span class="plant-mark plant"></span>
        <h3>Grow</h3>
        <p>Watch effort become visible over time.</p>
      </div>

      <div class="gg-flow-card wide">
        <span class="plant-mark bloom"></span>
        <h3>Bloom together</h3>
        <p>
          Invite others into shared gardens and grow with accountability that feels gentle.
        </p>
      </div>
    </div>
  </div>
</section>

<section class="gg-split-section">
  <div class="gg-container gg-two-col">
    <div>
      <span class="gg-kicker">Shared gardens</span>
      <h2>Progress feels better when it is not lonely.</h2>
    </div>

    <div>
      <p>
        Build shared gardens with friends, family, classmates, or accountability
        partners. Each person contributes to the garden by showing up for their
        own goals.
      </p>

      <a href="/pages/support" class="gg-btn">Help Build It</a>
    </div>
  </div>
</section>

<section class="gg-final-cta">
  <div class="gg-container">
    <span class="gg-kicker">Start small</span>

    <h2>What could your garden look like in one year?</h2>

    <p>
      Support Goal Grower while it grows from beta into a real app for real people.
    </p>

    <a href="{{ routes.collections_url }}" class="gg-btn">Visit Store</a>
  </div>
</section>

