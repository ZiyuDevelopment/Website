<main class="zd-article-page">

  <article class="zd-article">

    <header class="zd-article-hero">
      <p class="zd-article-eyebrow">
        {% if article.tags.size > 0 %}
          {{ article.tags.first }}
        {% else %}
          Journal
        {% endif %}
      </p>

      <h1>{{ article.title }}</h1>

      <div class="zd-article-meta">
        <span>{{ article.published_at | date: "%B %d, %Y" }}</span>
        <span>By Ziyu Development</span>
      </div>
    </header>

    {% if article.image %}
      <div class="zd-article-image">
        <img
          src="{{ article.image | image_url: width: 1600 }}"
          alt="{{ article.title | escape }}"
          width="1600"
          height="900"
          loading="eager"
        >
      </div>
    {% endif %}

    <div class="zd-article-layout">
      <aside class="zd-article-sidebar">
        <p>In this article</p>
        <a href="#article-content">Read</a>
        <a href="/blogs/journal">Journal</a>
        <a href="/pages/projects">Projects</a>
        <a href="/pages/support">Support</a>
      </aside>

      <div id="article-content" class="zd-article-content">
        {{ article.content }}
      </div>
    </div>

  </article>

  <section class="zd-article-cta">
    <div>
      <p class="zd-article-eyebrow">Keep following the build</p>
      <h2>Join the journey.</h2>
      <p>
        Get project updates, founder notes, product drops, app previews,
        and new journal posts.
      </p>
    </div>

    {% form 'customer', class: 'zd-article-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter, journal">
      <input type="email" name="contact[email]" placeholder="Email address" required>
      <button type="submit">Join</button>
    {% endform %}
  </section>

  <section class="zd-article-related">
    <div class="zd-article-related-head">
      <p class="zd-article-eyebrow">More from the journal</p>
      <h2>Related reading</h2>
    </div>

    <div class="zd-article-related-grid">
      {% for related_article in blog.articles limit: 3 %}
        {% unless related_article.id == article.id %}
          <a href="{{ related_article.url }}" class="zd-article-related-card">
            {% if related_article.image %}
              <img
                src="{{ related_article.image | image_url: width: 700 }}"
                alt="{{ related_article.title | escape }}"
                width="700"
                height="500"
                loading="lazy"
              >
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'zd-article-placeholder' }}
            {% endif %}

            <div>
              <span>{{ related_article.published_at | date: "%b %d, %Y" }}</span>
              <h3>{{ related_article.title }}</h3>
            </div>
          </a>
        {% endunless %}
      {% endfor %}
    </div>
  </section>

</main>

{% schema %}
{
  "name": "Main Article",
  "settings": []
}
{% endschema %}