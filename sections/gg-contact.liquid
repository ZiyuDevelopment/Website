<section class="gg-contact-hero">
  <div class="gg-contact-bg"></div>

  <div class="gg-container gg-contact-hero-grid">
    <div class="gg-contact-copy reveal">
      <span class="gg-kicker">Contact + Beta Testing</span>
      <h1>Help shape Goal Grower before launch.</h1>
      <p>
        Join testing, send feedback, ask a question, or share an idea for Ziyu Development.
      </p>

      <div class="gg-hero-actions">
        <a href="#beta-signup" class="gg-btn">Join Beta Testing</a>
        <a href="#contact-form" class="gg-btn-soft">Send a Message</a>
      </div>
    </div>

    <div id="beta-signup" class="gg-beta-card reveal">
      <span class="gg-kicker">Beta list</span>
      <h2>Beta Testing!</h2>
      <p>Your feedback will directly influence future updates and improvements.</p>

      {% form 'customer', class: 'gg-beta-form' %}
        <input type="hidden" name="contact[tags]" value="Goal Grower Beta Tester">
        <input type="email" name="contact[email]" placeholder="Your email" required>
        <button type="submit" class="gg-btn">Join Now</button>

        {% if form.posted_successfully? %}
          <p class="gg-form-success">You’re on the beta list.</p>
        {% endif %}

        {% if form.errors %}
          <p class="gg-form-error">Please check your email and try again.</p>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>

<section class="gg-beta-expectations">
  <div class="gg-container gg-beta-expectations-grid">
    <div class="reveal">
      <span class="gg-kicker light">Beta testing</span>
      <h2>What testers help with.</h2>
    </div>

    <div class="gg-beta-list reveal">
      <div>
        <strong>Try the app naturally</strong>
        <span>Use Goal Grower like you would for your own habits or goals.</span>
      </div>
      <div>
        <strong>Notice friction</strong>
        <span>Share where the app feels confusing, slow, unclear, or hard to return to.</span>
      </div>
      <div>
        <strong>Shape the launch</strong>
        <span>Your feedback helps improve the experience before more people use it.</span>
      </div>
    </div>
  </div>
</section>

<section id="contact-form" class="gg-contact-main">
  <div class="gg-container gg-contact-main-grid">
    <div class="reveal">
      <span class="gg-kicker">Send a message</span>
      <h2>Questions, feedback, ideas, or testing interest.</h2>
      <p>
        Use this form for anything related to Goal Grower, Ziyu Development,
        app testing, products, or project ideas.
      </p>
    </div>

    <div class="gg-contact-form-card reveal">
      {% form 'contact', id: 'ContactForm', class: 'gg-contact-form', return_to: '/pages/contact#contact-form' %}

<input type="hidden" name="contact[subject]" value="New Ziyu Development contact form message">

        {% if form.posted_successfully? %}
          <p class="gg-form-success">Message sent. Thank you.</p>
        {% endif %}

        {% if form.errors %}
          <p class="gg-form-error">Something went wrong. Please check the form.</p>
        {% endif %}

        <label for="ContactFormName">Name</label>
        <input id="ContactFormName" type="text" name="contact[name]" placeholder="Your name">

        <label for="ContactFormEmail">Email</label>
        <input id="ContactFormEmail" type="email" name="contact[email]" placeholder="Your email" required>

        <label for="ContactFormReason">Reason</label>
        <select id="ContactFormReason" name="contact[reason]">
          <option>Beta testing</option>
          <option>Goal Grower feedback</option>
          <option>Support question</option>
          <option>Product question</option>
          <option>Project idea</option>
          <option>Other</option>
        </select>

        <label for="ContactFormMessage">Message</label>
        <textarea id="ContactFormMessage" name="contact[body]" rows="6" placeholder="Write your message here"></textarea>

        <button type="submit" class="gg-btn">Send Message</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Page",
  "settings": [],
  "presets": [
    {
      "name": "Contact Page"
    }
  ]
}
{% endschema %}