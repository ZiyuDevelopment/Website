<footer class="zd-footer">
  <div class="zd-footer__top">
    <div class="zd-footer__message">
      <a href="{{ routes.root_url }}" class="zd-footer__brand">
        <span class="zd-footer__mark">Z</span>
        <span>
          <span class="zd-footer__brand-main">ZIYU</span>
          <span class="zd-footer__brand-sub">DEVELOPMENT</span>
        </span>
      </a>

      <h2>Building technology for intentional living.</h2>
      <p>
        Software, products, and ideas designed to help people focus, grow,
        and build better lives.
      </p>
    </div>

    <div class="zd-footer__newsletter">
      <h3>Join the journey</h3>
      <p>Get project updates, founder notes, product drops, and early access.</p>

      {% form 'customer', class: 'zd-footer__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          type="email"
          name="contact[email]"
          placeholder="Email address"
          required
        >
        <button type="submit">Join</button>
      {% endform %}
    </div>
  </div>

  <div class="zd-footer__links">
    <div>
      <h4>Explore</h4>
      <a href="{{ routes.root_url }}">Home</a>
      <a href="/pages/start-here">Start Here</a>
      <a href="/pages/philosophy">Philosophy</a>
      <a href="/pages/projects">Projects</a>
      <a href="/blogs/journal">Journal</a>
      <a href="/pages/roadmap">Roadmap</a>
      <a href="/pages/community">Community</a>
    </div>

    <div>
      <h4>Projects</h4>
      <a href="/pages/goal-grower">Goal Grower</a>
      <a href="/pages/myjourney">MyJourney</a>
      <a href="/pages/blokkr">Blokkr</a>
      <a href="/pages/kindlitt">Kindlitt</a>
      <a href="/pages/current-experiments">Current Experiments</a>
    </div>

    <div>
      <h4>Store</h4>
      <a href="/collections/all">All Products</a>
      <a href="/collections/journals">Journals</a>
      <a href="/collections/desk-tools">Desk Tools</a>
      <a href="/collections/books">Books</a>
      <a href="/collections/apparel">Apparel</a>
      <a href="/collections/digital-products">Digital Products</a>
    </div>

    <div>
      <h4>Support</h4>
      <a href="/pages/support">Support the Mission</a>
      <a href="/pages/beta">Join Beta</a>
      <a href="/pages/faq">FAQ</a>
      <a href="/pages/contact">Contact</a>
      <a href="/pages/community-support">Community Support</a>
    </div>

    <div>
      <h4>Company</h4>
      <a href="/pages/founder-journey">Founder Journey</a>
      <a href="/pages/about">About</a>
      <a href="/pages/build-in-public">Build in Public</a>
      <a href="/policies/privacy-policy">Privacy Policy</a>
      <a href="/policies/terms-of-service">Terms of Service</a>
      <a href="/policies/refund-policy">Refund Policy</a>
      <a href="/policies/shipping-policy">Shipping Policy</a>
    </div>
  </div>

  <div class="zd-footer__bottom">
    <p>© {{ 'now' | date: '%Y' }} Ziyu Development. All rights reserved.</p>

    <div class="zd-footer__socials">
      <a href="#" aria-label="GitHub">GitHub</a>
      <a href="#" aria-label="Instagram">Instagram</a>
      <a href="#" aria-label="YouTube">YouTube</a>
      <a href="#" aria-label="Discord">Discord</a>
    </div>
  </div>
</footer>