<main class="zd-contact-page">

  <section class="zd-contact-hero">
    <p class="zd-contact-eyebrow">Contact</p>

    <h1>Questions, feedback, partnerships, or support.</h1>

    <p>
      Reach out about Ziyu Development, app ideas, product questions,
      beta testing, collaborations, or the mission behind the projects.
    </p>
  </section>

  <section class="zd-contact-layout">

    <div class="zd-contact-info">
      <p class="zd-contact-eyebrow">Ways to reach out</p>

      <div class="zd-contact-card">
        <h2>Project Feedback</h2>
        <p>Share ideas for Goal Grower, MyJourney, Blokkr, Kindlitt, or future apps.</p>
      </div>

      <div class="zd-contact-card">
        <h2>Support Questions</h2>
        <p>Ask about supporting the mission, buying products, or joining early access.</p>
      </div>

      <div class="zd-contact-card">
        <h2>Partnerships</h2>
        <p>Reach out for collaborations, media, community work, or product opportunities.</p>
      </div>
    </div>

    <div class="zd-contact-form-wrap">
      {% form 'contact', class: 'zd-contact-form' %}

        {% if form.posted_successfully? %}
          <p class="zd-contact-success">Message sent. Thank you for reaching out.</p>
        {% endif %}

        {% if form.errors %}
          <div class="zd-contact-errors">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <label for="ContactFormName">Name</label>
        <input
          id="ContactFormName"
          type="text"
          name="contact[name]"
          value="{{ form.name }}"
          placeholder="Your name"
        >

        <label for="ContactFormEmail">Email</label>
        <input
          id="ContactFormEmail"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="you@example.com"
          required
        >

        <label for="ContactFormTopic">Topic</label>
        <select id="ContactFormTopic" name="contact[topic]">
          <option>Project feedback</option>
          <option>Support question</option>
          <option>Product question</option>
          <option>Beta testing</option>
          <option>Partnership</option>
          <option>Other</option>
        </select>

        <label for="ContactFormMessage">Message</label>
        <textarea
          id="ContactFormMessage"
          name="contact[body]"
          rows="8"
          placeholder="Write your message..."
          required
        >{{ form.body }}</textarea>

        <button type="submit">Send Message</button>

      {% endform %}
    </div>

  </section>

  <section class="zd-contact-cta">
    <div>
      <p class="zd-contact-eyebrow">Before you go</p>
      <h2>Explore the mission behind the work.</h2>
    </div>

    <div class="zd-contact-actions">
      <a href="/pages/projects">View Projects</a>
      <a href="/pages/support">Support the Mission</a>
    </div>
  </section>

</main>

{% schema %}
{
  "name": "Contact Page",
  "settings": [],
  "presets": [
    {
      "name": "Contact Page"
    }
  ]
}
{% endschema %}