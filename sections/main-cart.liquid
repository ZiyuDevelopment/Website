<section class="gg-page-hero">
  <div class="gg-container">
    <span class="gg-kicker">Cart</span>
    <h1>Your cart</h1>
    <p>Review your items before checkout.</p>
  </div>
</section>

<section class="gg-page-section">
  <div class="gg-container">
    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" novalidate class="gg-cart-form">
        <div class="gg-cart-items">
          {% for item in cart.items %}
            <div class="gg-cart-item">
              <div class="gg-cart-image">
                {% if item.image %}
                  {{ item.image | image_url: width: 220 | image_tag: loading: 'lazy', alt: item.product.title }}
                {% endif %}
              </div>

              <div class="gg-cart-info">
                <h3>{{ item.product.title }}</h3>
                <p>{{ item.variant.title }}</p>
                <p>{{ item.final_line_price | money }}</p>

                <label for="Quantity-{{ item.index | plus: 1 }}">Quantity</label>
                <input
                  id="Quantity-{{ item.index | plus: 1 }}"
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                >
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="gg-cart-summary">
          <h2>Total</h2>
          <p>{{ cart.total_price | money }}</p>

          <button type="submit" name="update" class="gg-btn-outline">Update Cart</button>
          <button type="submit" name="checkout" class="gg-btn">Checkout</button>
        </div>
      </form>
    {% else %}
      <div class="gg-empty-state">
        <h2>Your cart is empty.</h2>
        <p>Visit the store to support Goal Grower development.</p>
        <a href="{{ routes.collections_url }}" class="gg-btn">Visit Store</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}