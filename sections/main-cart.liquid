<section class="gg-cart-page">
  <div class="gg-container">
    <div class="gg-cart-hero">
      <span class="gg-kicker">Your Cart</span>
      <h1>Ready to support the build?</h1>
      <p>Review your items before checkout.</p>
    </div>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" class="gg-cart-layout">
        <div class="gg-cart-items">
          {% for item in cart.items %}
            <div class="gg-cart-item">
              <div class="gg-cart-image">
                {% if item.image %}
                  {{ item.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: item.product.title }}
                {% else %}
                  <div class="gg-product-placeholder"></div>
                {% endif %}
              </div>

              <div class="gg-cart-info">
                <a href="{{ item.url }}">
                  <h2>{{ item.product.title }}</h2>
                </a>

                {% if item.properties.size > 0 %}
                  <div class="gg-cart-properties">
                    {% for property in item.properties %}
                      {% unless property.last == blank %}
                        <span>{{ property.first }}: {{ property.last }}</span>
                      {% endunless %}
                    {% endfor %}
                  </div>
                {% endif %}

                <p class="gg-cart-price">{{ item.line_price | money }}</p>

                <div class="gg-cart-controls">
  <label for="updates_{{ item.key }}">Quantity</label>

  <div class="gg-quantity-selector">
    <button
      type="button"
      class="gg-qty-btn"
      data-qty-minus
    >
      −
    </button>

    <input
  id="updates_{{ item.key }}"
  type="number"
  name="updates[]"
  value="{{ item.quantity }}"
  min="0"
  class="gg-qty-input"
  data-line="{{ forloop.index }}"
>

    <button
      type="button"
      class="gg-qty-btn"
      data-qty-plus
    >
      +
    </button>
  </div>

  <a href="{{ item.url_to_remove }}" class="gg-cart-remove">
    Remove
  </a>
</div>
              </div>
            </div>
          {% endfor %}
        </div>

        <aside class="gg-cart-summary">
          <span class="gg-kicker">Summary</span>

          <div class="gg-cart-total-row">
            <span>Subtotal</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>

          <p>
            Taxes, shipping, and discounts are calculated at checkout.
          </p>

          <button type="submit" name="checkout" class="gg-btn-soft gg-btn-checkout">
  Checkout
</button>

          <a href="/collections/all" class="gg-cart-continue">
            Continue shopping
          </a>
        </aside>
      </form>
    {% else %}
      <div class="gg-empty-cart">
        <span class="gg-kicker">Empty cart</span>
        <h2>Your cart is waiting for something meaningful.</h2>
        <p>
          Add a product, support Goal Grower, or browse the store.
        </p>

        <div class="gg-hero-actions center">
          <a href="/collections/all" class="gg-btn">Visit Store</a>
          <a href="/pages/support" class="gg-btn-soft">Support Goal Grower</a>
        </div>
      </div>
    {% endif %}
  </div>
</section>

<div class="gg-remove-modal" data-remove-modal aria-hidden="true">
  <div class="gg-remove-modal__overlay" data-remove-cancel></div>

  <div class="gg-remove-modal__panel">
    <span class="gg-kicker">Remove item?</span>
    <h2>Take this out of your cart?</h2>
    <p>This item will be removed from your cart. You can keep it if you changed your mind.</p>

    <div class="gg-remove-modal__actions">
      <button type="button" class="gg-btn-soft" data-remove-cancel>
        Keep Item
      </button>

      <button type="button" class="gg-btn" data-remove-confirm>
        Remove
      </button>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const modal = document.querySelector('[data-remove-modal]');
  const confirmRemove = document.querySelector('[data-remove-confirm]');
  const cancelRemoveButtons = document.querySelectorAll('[data-remove-cancel]');
  const subtotal = document.querySelector('[data-cart-subtotal]');

  let pendingRemove = null;

  function formatMoney(cents) {
    return '$' + (cents / 100).toFixed(2);
  }

  function openRemoveModal(callback) {
    pendingRemove = callback;
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
  }

  function closeRemoveModal() {
    pendingRemove = null;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
  }

  if (cancelRemoveButtons.length) {
    cancelRemoveButtons.forEach(button => {
      button.addEventListener('click', closeRemoveModal);
    });
  }

  if (confirmRemove) {
    confirmRemove.addEventListener('click', () => {
      if (pendingRemove) pendingRemove();
      closeRemoveModal();
    });
  }

  document.querySelectorAll('.gg-quantity-selector').forEach(selector => {
    const input = selector.querySelector('.gg-qty-input');
    const item = selector.closest('[data-cart-item]');
    const linePrice = item.querySelector('[data-line-price]');

    async function updateCartQuantity(newQuantity) {
      const line = input.dataset.line;

      input.value = newQuantity;
      item.classList.add('is-updating');

      const response = await fetch('/cart/change.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          line: Number(line),
          quantity: Number(newQuantity)
        })
      });

      const cart = await response.json();

      if (newQuantity === 0) {
        item.remove();
      } else {
        const updatedItem = cart.items[Number(line) - 1];

        if (updatedItem && linePrice) {
          linePrice.textContent = formatMoney(updatedItem.line_price);
        }
      }

      if (subtotal) {
        subtotal.textContent = formatMoney(cart.total_price);
      }

      item.classList.remove('is-updating');
    }

    selector.querySelector('[data-qty-minus]').addEventListener('click', () => {
      const value = parseInt(input.value || 0, 10);
      const newQuantity = Math.max(0, value - 1);

      if (newQuantity === 0) {
        openRemoveModal(() => {
          updateCartQuantity(0);
        });

        return;
      }

      updateCartQuantity(newQuantity);
    });

    selector.querySelector('[data-qty-plus]').addEventListener('click', () => {
      const value = parseInt(input.value || 0, 10);
      updateCartQuantity(value + 1);
    });

    input.addEventListener('change', () => {
      const value = parseInt(input.value || 0, 10);

      if (value === 0) {
        openRemoveModal(() => {
          updateCartQuantity(0);
        });

        input.value = 1;
        return;
      }

      updateCartQuantity(value);
    });
  });
});
</script>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}