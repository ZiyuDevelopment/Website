<section class="min-h-screen bg-surface-container-lowest text-on-surface px-margin-mobile md:px-margin-desktop py-[160px]">
  <div class="max-w-container-max mx-auto">

    <div class="text-center max-w-3xl mx-auto mb-24">
      <span class="font-label-md text-label-md uppercase tracking-[0.2em] text-primary mb-6 block">
        Chapter I
      </span>

      <h1 class="font-headline-xl text-headline-xl md:text-[84px] leading-tight mb-8">
        The Digital Suite
      </h1>

      <p class="font-body-lg text-body-lg text-secondary">
        A collection of focused environments designed to eliminate cognitive noise.
        We don't build tools; we build sanctuaries for your attention.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
      <a href="/pages/blokkr" class="group bg-surface rounded-xl overflow-hidden border border-outline-variant hover:-translate-y-1 transition-all">
        <div class="aspect-video overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?q=80&w=1200&auto=format&fit=crop"
            alt="Blokkr"
            width="1200"
            height="675"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          >
        </div>
        <div class="p-8">
          <h2 class="font-headline-md text-headline-md mb-4">Blokkr</h2>
          <p class="font-body-md text-secondary">
            An intelligent barrier against the attention economy.
          </p>
        </div>
      </a>

      <a href="/pages/myjourney" class="group bg-surface rounded-xl overflow-hidden border border-outline-variant hover:-translate-y-1 transition-all">
        <div class="aspect-video overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1499750310107-5fef28a66643?q=80&w=1200&auto=format&fit=crop"
            alt="MyJourney"
            width="1200"
            height="675"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          >
        </div>
        <div class="p-8">
          <h2 class="font-headline-md text-headline-md mb-4">MyJourney</h2>
          <p class="font-body-md text-secondary">
            A reflective chronological archive for personal growth.
          </p>
        </div>
      </a>

      <a href="/pages/kindlitt" class="group bg-surface rounded-xl overflow-hidden border border-outline-variant hover:-translate-y-1 transition-all">
        <div class="aspect-video overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1512820790803-83ca734da794?q=80&w=1200&auto=format&fit=crop"
            alt="KindLitt"
            width="1200"
            height="675"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          >
        </div>
        <div class="p-8">
          <h2 class="font-headline-md text-headline-md mb-4">KindLitt</h2>
          <p class="font-body-md text-secondary">
            A calm e-reading environment for focused retention.
          </p>
        </div>
      </a>
    </div>

  </div>
</section>

