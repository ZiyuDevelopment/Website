<section class="gg-ad-landing gg-consideration-page">
  <div class="gg-container">
    <div class="gg-ad-hero">
      <span class="gg-kicker">Beta Testing</span>

      <h1>Help shape Goal Grower before launch.</h1>

      <p>
        Goal Grower is being built for people who want goals to feel more visual,
        encouraging, and consistent. Beta testers help decide what gets improved next.
      </p>

      <div class="gg-hero-actions">
        <a href="/pages/contact" class="gg-btn">Become a Beta Tester</a>
        <a href="/pages/roadmap" class="gg-btn-soft">View Roadmap</a>
      </div>
    </div>

    <div class="gg-consideration-layout">
      <div class="gg-consideration-card">
        <span class="gg-kicker">Why join?</span>
        <h2>Your feedback helps build the app.</h2>
        <p>
          Test early features, share what feels confusing, and help make Goal Grower
          better before public launch.
        </p>
      </div>

      <div class="gg-beta-benefits">
        <div>
          <strong>01</strong>
          <span>Early access to Goal Grower</span>
        </div>

        <div>
          <strong>02</strong>
          <span>Direct influence on new features</span>
        </div>

        <div>
          <strong>03</strong>
          <span>Help improve shared gardens</span>
        </div>

        <div>
          <strong>04</strong>
          <span>Support an app built with intention</span>
        </div>
      </div>
    </div>

    <div class="gg-ad-section">
      <span class="gg-kicker">Good fit?</span>
      <h2>Join if you want a better way to stay consistent.</h2>
      <p>
        You do not need to be perfect at goals. You just need to be willing to try the app
        and give honest feedback.
      </p>

      <a href="/pages/contact" class="gg-btn">Join the Beta</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Goal Grower Consideration",
  "settings": [],
  "presets": [
    {
      "name": "Goal Grower Consideration"
    }
  ]
}
{% endschema %}