<section class="gg-ad-landing">
  <div class="gg-container">
    <div class="gg-ad-hero">
      <span class="gg-kicker">Beta Testing</span>
      <h1>Help Improve the App</h1>
      <p>
        Join the beta to try the app early, share your experience, and help shape a goal tracker that feels clearer, calmer, and more motivating.
      </p>

      <div class="gg-hero-actions">
        <a href="#beta-signup" class="gg-btn">Join Beta</a>
      </div>
    </div>

    <div class="gg-consideration-layout">
      <div class="gg-consideration-card">
        <span class="gg-kicker">How it works</span>
        <h2>Share Feedback</h2>
        <p>
          Beta testing is about helping make the product feel more useful every day. Your experience will shape what gets built next.
        </p>
      </div>

      <div class="gg-beta-benefits">
        <div>
          <div class="gg-beta-benefit-image">
            {{ 'gg-no-goals-yet.png' | asset_img_url: '400x' | img_tag: 'Goal Grower empty goals screen' }}
          </div>
          <div class="gg-beta-benefit-copy">
            <strong>Try Features</strong>
            <span>See the next features before launch.</span>
          </div>
        </div>
        <div>
          <div class="gg-beta-benefit-image">
            {{ 'gg-exercise-more-only-goal-list-view.png' | asset_img_url: '400x' | img_tag: 'Goal Grower goal list screen' }}
          </div>
          <div class="gg-beta-benefit-copy">
            <strong>Give Feedback</strong>
            <span>Tell us what helps and what feels confusing.</span>
          </div>
        </div>
        <div>
          <div class="gg-beta-benefit-image">
            {{ 'gg-exercise-more-before-placed-garden-view.png' | asset_img_url: '400x' | img_tag: 'Goal Grower garden screen' }}
          </div>
          <div class="gg-beta-benefit-copy">
            <strong>Clear Progress</strong>
            <span>Help the app feel more motivating and less distracting.</span>
          </div>
        </div>
        <div>
          <div class="gg-beta-benefit-image">
            {{ 'gg-exercise-more-goal-details-view.png' | asset_img_url: '400x' | img_tag: 'Goal Grower goal details screen' }}
          </div>
          <div class="gg-beta-benefit-copy">
            <strong>Shape Release</strong>
            <span>Your input decides the priorities for the next release.</span>
          </div>
        </div>
      </div>
    </div>

    <div class="gg-ad-section" id="beta-signup">
      <span class="gg-kicker">Ready to help?</span>
      <h2>Join <span class="gg-text-accent">Beta</span></h2>
      <p>
        You do not need to be perfect at goals. You just need to <span class="gg-text-accent">try the app</span> and tell us what makes it feel helpful.
      </p>
      <div class="gg-form-block">
        {% form 'contact', id: 'ConsiderationBetaSignup', class: 'gg-landing-form' %}
          <input type="hidden" name="contact[tags]" value="Goal Grower Beta, Consideration Landing">
          <input type="hidden" name="contact[subject]" value="Beta signup: Consideration landing">
          <div class="gg-form-field">
            <input type="email" name="contact[email]" placeholder="Enter your email" required>
            <button type="submit" class="gg-btn">Join the Beta</button>
          </div>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Goal Grower Consideration",
  "settings": [],
  "presets": [{ "name": "Goal Grower Consideration" }]
}
{% endschema %}