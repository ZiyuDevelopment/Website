<main class="zd-build-page">

  <section class="zd-build-hero">
    <p class="zd-build-eyebrow">Build in Public</p>

    <h1>Follow the process as the ecosystem becomes real.</h1>

    <p>
      This page documents the work behind Ziyu Development: what is being built,
      what is improving, what is blocked, and what comes next.
    </p>

    <div class="zd-build-actions">
      <a href="/pages/roadmap" class="zd-build-btn zd-build-btn--primary">View Roadmap</a>
      <a href="/pages/support" class="zd-build-btn zd-build-btn--secondary">Support the Mission</a>
    </div>
  </section>

  <section class="zd-build-current">
    <div>
      <p class="zd-build-eyebrow">Current Sprint</p>
      <h2>Building the foundation.</h2>
    </div>

    <div class="zd-build-current-card">
      <h3>Now working on</h3>
      <ul>
        <li>Shopify theme structure</li>
        <li>Homepage and project pages</li>
        <li>Support and community pages</li>
        <li>Store and product templates</li>
        <li>Journal and build notes</li>
      </ul>
    </div>
  </section>

  <section class="zd-build-progress">
    <p class="zd-build-eyebrow">Progress</p>
    <h2>Project status.</h2>

    <div class="zd-build-progress-grid">
      <article>
        <span>Website</span>
        <h3>In Progress</h3>
        <div class="zd-build-bar"><i style="width: 75%;"></i></div>
      </article>

      <article>
        <span>Goal Grower</span>
        <h3>Planning + Design</h3>
        <div class="zd-build-bar"><i style="width: 35%;"></i></div>
      </article>

      <article>
        <span>MyJourney</span>
        <h3>Concept</h3>
        <div class="zd-build-bar"><i style="width: 20%;"></i></div>
      </article>

      <article>
        <span>Blokkr</span>
        <h3>Concept</h3>
        <div class="zd-build-bar"><i style="width: 15%;"></i></div>
      </article>

      <article>
        <span>Kindlitt</span>
        <h3>Concept</h3>
        <div class="zd-build-bar"><i style="width: 15%;"></i></div>
      </article>

      <article>
        <span>Store</span>
        <h3>Early Setup</h3>
        <div class="zd-build-bar"><i style="width: 30%;"></i></div>
      </article>
    </div>
  </section>

  <section class="zd-build-log">
    <div class="zd-build-section-head">
      <p class="zd-build-eyebrow">Build Log</p>
      <h2>Recent updates.</h2>
    </div>

    <div class="zd-build-log-list">
      <article>
        <span>Update 01</span>
        <h3>Website direction chosen</h3>
        <p>
          The site direction is now focused on a warm, handcrafted, lifestyle-based
          ecosystem instead of a garden-only theme.
        </p>
      </article>

      <article>
        <span>Update 02</span>
        <h3>Core pages structured</h3>
        <p>
          Homepage, projects, app pages, support, philosophy, roadmap, community,
          journal, and store templates are being built.
        </p>
      </article>

      <article>
        <span>Update 03</span>
        <h3>Support funnel added</h3>
        <p>
          Support the Mission is now the primary conversion path for people who
          believe in the projects.
        </p>
      </article>
    </div>
  </section>

  <section class="zd-build-next">
    <div>
      <p class="zd-build-eyebrow">Next steps</p>
      <h2>What comes after the site foundation.</h2>
    </div>

    <div class="zd-build-next-grid">
      <article>
        <h3>Polish mobile</h3>
        <p>Test layouts, spacing, menus, and buttons on small screens.</p>
      </article>

      <article>
        <h3>Add real images</h3>
        <p>Replace placeholder visuals with branded project and product imagery.</p>
      </article>

      <article>
        <h3>Add products</h3>
        <p>Create store collections, product descriptions, and physical product listings.</p>
      </article>

      <article>
        <h3>Start devlogs</h3>
        <p>Publish regular updates through the Journal and Build in Public pages.</p>
      </article>
    </div>
  </section>

  <section class="zd-build-cta">
    <div>
      <p class="zd-build-eyebrow">Support the work</p>
      <h2>Help move the build forward.</h2>
      <p>
        Every supporter, product purchase, share, and signup helps turn these
        ideas into real tools.
      </p>
    </div>

    <a href="/pages/support" class="zd-build-btn zd-build-btn--light">Support the Mission</a>
  </section>

</main>

{% schema %}
