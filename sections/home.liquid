<section class="px-margin-mobile md:px-margin-desktop py-24 md:py-36 bg-surface">
  <div class="max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-12 gap-gutter items-end">

    <div class="lg:col-span-8">
      <span class="block uppercase tracking-[0.2em] text-label-md text-on-surface-variant mb-8">
        Intentional Living Through Technology
      </span>

      <h1 class="font-headline-xl text-headline-xl md:text-[96px] leading-[0.95] tracking-[-0.04em] max-w-5xl">
        Tools for people who want their lives back.
      </h1>
    </div>

    <div class="lg:col-span-4">
      <p class="text-body-lg text-on-surface-variant mb-8">
        Ziyu Development builds software, hardware, and learning systems for focus, growth, and slower digital living.
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="/pages/store" class="bg-primary text-on-primary px-7 py-3 rounded-full">
          Visit Store
        </a>

        <a href="/pages/archive" class="border border-outline px-7 py-3 rounded-full hover:bg-surface-container">
          Explore Archive
        </a>
      </div>
    </div>

  </div>
</section>

<section class="px-margin-mobile md:px-margin-desktop py-20 bg-surface">
  <div class="max-w-container-max mx-auto">
    <div class="aspect-[16/9] rounded-xl overflow-hidden border border-outline-variant bg-surface-container">
      <img
        src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?q=80&w=2200&auto=format&fit=crop"
        alt="Intentional workspace"
        width="2200"
        height="1237"
        class="w-full h-full object-cover grayscale"
      >
    </div>
  </div>
</section>

<section class="px-margin-mobile md:px-margin-desktop py-28 bg-surface-container-low">
  <div class="max-w-container-max mx-auto">

    <div class="flex items-end justify-between gap-8 mb-16">
      <div>
        <span class="block uppercase tracking-[0.2em] text-label-md text-on-surface-variant mb-4">
          Products
        </span>

        <h2 class="font-headline-lg text-headline-lg md:text-[64px] leading-tight">
          Built as quiet systems.
        </h2>
      </div>

      <a href="/pages/store" class="hidden md:inline-block border border-outline px-6 py-3 rounded-full">
        View All
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter">
      <a href="/pages/goal-grower" class="group bg-surface-container-lowest border border-outline-variant rounded-xl overflow-hidden">
        <div class="aspect-[4/5] overflow-hidden">
          <img src="https://images.unsplash.com/photo-1466692476868-aef1dfb1e735?q=80&w=1200&auto=format&fit=crop" alt="Goal Grower" width="1200" height="1500" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
        </div>
        <div class="p-6">
          <h3 class="font-headline-md text-headline-md mb-2">Goal Grower</h3>
          <p class="text-body-sm text-on-surface-variant">A botanical goal tracker for steady personal growth.</p>
        </div>
      </a>

      <a href="/pages/blokkr" class="group bg-surface-container-lowest border border-outline-variant rounded-xl overflow-hidden">
        <div class="aspect-[4/5] overflow-hidden">
          <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=1200&auto=format&fit=crop" alt="Blokkr" width="1200" height="1500" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
        </div>
        <div class="p-6">
          <h3 class="font-headline-md text-headline-md mb-2">Blokkr</h3>
          <p class="text-body-sm text-on-surface-variant">Physical hardware for deep work and digital boundaries.</p>
        </div>
      </a>

      <a href="/pages/myjourney" class="group bg-surface-container-lowest border border-outline-variant rounded-xl overflow-hidden">
        <div class="aspect-[4/5] overflow-hidden">
          <img src="https://images.unsplash.com/photo-1499750310107-5fef28a66643?q=80&w=1200&auto=format&fit=crop" alt="MyJourney" width="1200" height="1500" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
        </div>
        <div class="p-6">
          <h3 class="font-headline-md text-headline-md mb-2">MyJourney</h3>
          <p class="text-body-sm text-on-surface-variant">An encrypted digital garden for becoming better.</p>
        </div>
      </a>

      <a href="/pages/kindlitt" class="group bg-surface-container-lowest border border-outline-variant rounded-xl overflow-hidden">
        <div class="aspect-[4/5] overflow-hidden">
          <img src="https://images.unsplash.com/photo-1512820790803-83ca734da794?q=80&w=1200&auto=format&fit=crop" alt="KindLitt" width="1200" height="1500" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
        </div>
        <div class="p-6">
          <h3 class="font-headline-md text-headline-md mb-2">KindLitt</h3>
          <p class="text-body-sm text-on-surface-variant">A reading sanctuary for families and focused learning.</p>
        </div>
      </a>
    </div>

  </div>
</section>

<section class="px-margin-mobile md:px-margin-desktop py-32 bg-primary text-on-primary">
  <div class="max-w-container-max mx-auto grid grid-cols-1 md:grid-cols-2 gap-gutter items-center">
    <h2 class="font-headline-lg text-headline-lg md:text-[72px] leading-tight">
      Build a calmer relationship with technology.
    </h2>

    <div>
      <p class="text-body-lg opacity-80 mb-8">
        The archive documents the philosophy, roadmap, changelog, and research behind Ziyu Development.
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="/pages/philosophy" class="bg-surface text-on-surface px-7 py-3 rounded-full">
          Philosophy
        </a>

        <a href="/pages/journal" class="border border-white/30 px-7 py-3 rounded-full">
          Read Journal
        </a>
      </div>
    </div>
  </div>
</section>

