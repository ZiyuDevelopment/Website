<section class="ziyu-section">
  <div class="ziyu-container ziyu-settings-container">
    <div class="ziyu-settings-hero">
      <span class="ziyu-label">Member Settings</span>

      <h1 class="ziyu-h1">
        Account Settings
      </h1>

      <p class="ziyu-body-lg">
        Manage your archive membership, preferences, billing records, and digital residence.
      </p>
    </div>

    <div class="ziyu-settings-list">

      <section class="ziyu-settings-row">
        <span class="ziyu-label">Profile</span>

        <div class="ziyu-grid-2">
          <label class="ziyu-field">
            <span class="ziyu-label ziyu-label--muted">Display Name</span>
            <input value="Ziyu Member">
          </label>

          <label class="ziyu-field">
            <span class="ziyu-label ziyu-label--muted">Email</span>
            <input value="hello@ziyu.dev">
          </label>
        </div>
      </section>

      <section class="ziyu-settings-row">
        <span class="ziyu-label">Security</span>

        <div>
          <h2 class="ziyu-h3">Account Password</h2>

          <p class="ziyu-body-lg" style="margin-top: 12px;">
            Manage your login credentials and account access.
          </p>

          <button class="ziyu-button ziyu-button--ghost" style="margin-top: 24px;">
            Change Password
          </button>
        </div>
      </section>

      <section class="ziyu-settings-row">
        <span class="ziyu-label">Membership</span>

        <div class="ziyu-card ziyu-membership-card">
          <span class="ziyu-status">The Archive Plus</span>

          <h2 class="ziyu-h3">
            Annual Benefactor
          </h2>

          <p class="ziyu-body-lg">
            Next renewal: December 14, 2026
          </p>
        </div>
      </section>

      <section class="ziyu-settings-row">
        <span class="ziyu-label">Billing</span>

        <div class="ziyu-table-wrap">
          <table class="ziyu-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Invoice</th>
                <th>Status</th>
                <th>Amount</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td>Dec 14, 2025</td>
                <td>INV-9821-ARCH</td>
                <td>Paid</td>
                <td>$120.00</td>
              </tr>

              <tr>
                <td>Dec 14, 2024</td>
                <td>INV-7431-ARCH</td>
                <td>Paid</td>
                <td>$120.00</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Settings",
  "settings": [],
  "presets": [
    {
      "name": "Settings"
    }
  ]
}
{% endschema %}