<section class="min-h-screen bg-surface text-on-surface px-margin-mobile md:px-margin-desktop py-[160px]">
  <div class="max-w-container-max mx-auto">

    <div class="text-center max-w-3xl mx-auto mb-24">
      <span class="font-label-md text-label-md uppercase tracking-[0.2em] text-primary mb-6 block">
        Chapter II
      </span>

      <h1 class="font-headline-xl text-headline-xl md:text-[84px] leading-tight mb-8">
        The Physical Archive
      </h1>

      <p class="font-body-lg text-body-lg text-secondary">
        Bridging the gap between pixels and atoms through heirloom-quality tools
        for deep work and reflective living.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
      <a href="/pages/foundation-mat" class="group bg-surface-container-lowest rounded-xl overflow-hidden border border-outline-variant hover:-translate-y-1 transition-all">
        <div class="aspect-[4/3] overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1515879218367-8466d910aaa4?q=80&w=1200&auto=format&fit=crop"
            alt="Foundation Mat"
            width="1200"
            height="900"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          >
        </div>

        <div class="p-8">
          <span class="font-label-md text-label-md text-primary uppercase tracking-widest block mb-4">
            Archive Essential
          </span>

          <h2 class="font-headline-md text-headline-md mb-4">
            The Foundation Mat
          </h2>

          <p class="font-body-md text-secondary">
            A seamless workspace surface for grounding digital focus.
          </p>
        </div>
      </a>

      <div class="bg-surface-container-lowest rounded-xl border border-outline-variant p-12 flex flex-col justify-center">
        <span class="font-label-md text-label-md text-primary uppercase tracking-widest block mb-4">
          Coming Soon
        </span>

        <h2 class="font-headline-md text-headline-md mb-4">
          More Physical Tools
        </h2>

        <p class="font-body-md text-secondary mb-8">
          Future artifacts will extend the Ziyu archive into notebooks,
          dials, physical planners, and slow-tech companions.
        </p>

        <a href="/" class="text-primary font-label-md text-label-md uppercase tracking-wider">
          Return Home
        </a>
      </div>
    </div>

  </div>
</section>

