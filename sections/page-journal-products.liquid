<main class="zd-collection-page">

  <section class="zdcp-hero">
    <p class="zdcp-eyebrow">Journal Products</p>
    <h1>Journals and planners for intentional growth.</h1>
    <p>Reflection tools, planners, and templates for goals, study, growth, and clear thinking.</p>

    <div class="zdcp-actions">
      <a href="/collections/all">Shop All Products</a>
      <a href="/pages/support">Support Development</a>
    </div>
  </section>

  <section class="zdcp-feature">
    <div>
      <p class="zdcp-eyebrow">Featured Collection</p>
      <h2>Tools for people who want to slow down and grow on purpose.</h2>
      <p>These products help you reflect, plan, organize, and build a better life with intention.</p>
    </div>

    <div class="zdcp-feature-card">
      <span>Best Starting Point</span>
      <h3>Focus Journal</h3>
      <p>A simple journal system for goals, reflection, planning, and weekly reset.</p>
      <a href="/collections/all">View Products</a>
    </div>
  </section>

  <section class="zdcp-grid">
    <article>
      <span>01</span>
      <h3>Reflection Journals</h3>
      <p>For documenting growth, thoughts, and meaningful life progress.</p>
    </article>

    <article>
      <span>02</span>
      <h3>Goal Planners</h3>
      <p>For turning big goals into steps, habits, and weekly actions.</p>
    </article>

    <article>
      <span>03</span>
      <h3>Digital Templates</h3>
      <p>Printable and digital tools for planning, studying, and tracking.</p>
    </article>

    <article class="zdcp-dark">
      <span>04</span>
      <h3>Support Products</h3>
      <p>Products that help fund Ziyu Development and future apps.</p>
    </article>
  </section>

  <section class="zdcp-products">
    <div class="zdcp-section-head">
      <p class="zdcp-eyebrow">Shop Journals</p>
      <h2>Curated journal products.</h2>
    </div>

    <div class="zdcp-product-grid">
      {% for product in collections.all.products %}
        {% if product.tags contains 'journal' or product.type == 'Journal' %}
          <article class="zdcp-product">
            <a href="{{ product.url }}" class="zdcp-product-image">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" width="600" height="600" loading="lazy">
              {% else %}
                <div class="zdcp-placeholder">Z</div>
              {% endif %}
            </a>

            <div class="zdcp-product-body">
              <p>{{ product.type | default: 'Journal Product' }}</p>
              <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <span>{{ product.price | money }}</span>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </section>

</main>

{% schema %}
{
  "name": "Journal Products Page",
  "settings": [],
  "presets": [{ "name": "Journal Products Page" }]
}
{% endschema %}