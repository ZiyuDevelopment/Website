<section class="ziyu-section">
  <div class="ziyu-container">
    <div style="max-width: 820px; margin-bottom: 90px;">
      <span class="ziyu-label">Deep Work Library</span>
      <h1 class="ziyu-h1">A curated library for focus, learning, and intentional creation.</h1>
      <p class="ziyu-body-lg" style="margin-top: 28px;">Books, essays, systems, tools, and prompts that support deep thinking and sustainable growth.</p>
    </div>

    <div class="ziyu-grid-3">
      <div class="ziyu-card">
        <div style="aspect-ratio: 4 / 3;">
          <img class="ziyu-image" src="https://images.unsplash.com/photo-1512820790803-83ca734da794?q=80&w=1400&auto=format&fit=crop" alt="Foundational books">
        </div>
        <div style="padding: 32px;">
          <span class="ziyu-label ziyu-label--muted">Reading</span>
          <h2 class="ziyu-h4">Foundational Books</h2>
          <p class="ziyu-body" style="margin-top: 16px;">Long-form reading centered around focus, philosophy, creativity, and intentional living.</p>
        </div>
      </div>

      <div class="ziyu-card">
        <div style="aspect-ratio: 4 / 3;">
          <img class="ziyu-image ziyu-grayscale" src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?q=80&w=1400&auto=format&fit=crop" alt="Workspace">
        </div>
        <div style="padding: 32px;">
          <span class="ziyu-label ziyu-label--muted">Systems</span>
          <h2 class="ziyu-h4">Deep Work Rituals</h2>
          <p class="ziyu-body" style="margin-top: 16px;">Focus systems, environmental design, and practical frameworks for sustained concentration.</p>
        </div>
      </div>

      <div class="ziyu-card">
        <div style="aspect-ratio: 4 / 3;">
          <img class="ziyu-image" src="https://images.unsplash.com/photo-1455390582262-044cdead277a?q=80&w=1400&auto=format&fit=crop" alt="Writing">
        </div>
        <div style="padding: 32px;">
          <span class="ziyu-label ziyu-label--muted">Writing</span>
          <h2 class="ziyu-h4">Essays & Reflections</h2>
          <p class="ziyu-body" style="margin-top: 16px;">Thoughtful writing about technology, creativity, learning, and meaningful systems.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="ziyu-section ziyu-section--dark">
  <div class="ziyu-manifesto">
    <span class="ziyu-label" style="color: rgba(255,255,255,.7);">Future Expansion</span>
    <h2 class="ziyu-h2">A growing archive of intentional knowledge.</h2>
    <p style="margin-top: 24px; color: rgba(255,255,255,.78);">The library will expand with reading lists, educational systems, focus tools, and long-form resources.</p>
    <a href="/pages/journal" class="ziyu-button ziyu-button--light" style="margin-top: 36px;">Read Journal</a>
  </div>
</section>

{% schema %}
{
  "name": "Deep Work Library",
  "settings": [],
  "presets": [
    {
      "name": "Deep Work Library"
    }
  ]
}
{% endschema %}