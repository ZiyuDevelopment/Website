<section class="px-margin-mobile md:px-margin-desktop py-24 md:py-36 bg-surface">
  <div class="max-w-container-max mx-auto">

    <div class="max-w-5xl mb-28">
      <span class="block uppercase tracking-[0.2em] text-label-md text-on-surface-variant mb-8">
        Deep Work Library
      </span>

      <h1 class="font-headline-xl text-headline-xl md:text-[96px] leading-[0.92] tracking-[-0.05em] mb-8">
        A curated library for focus, learning, and intentional creation.
      </h1>

      <p class="text-body-lg text-on-surface-variant max-w-2xl">
        Books, essays, systems, tools, and resources that support deep thinking and sustainable growth.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">

      <div class="bg-surface-container-low border border-outline-variant rounded-2xl overflow-hidden">
        <div class="aspect-[4/3] overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1512820790803-83ca734da794?q=80&w=1400&auto=format&fit=crop"
            alt="Reading"
            width="1400"
            height="1050"
            class="w-full h-full object-cover"
          >
        </div>

        <div class="p-8">
          <span class="text-label-md uppercase tracking-[0.2em] text-on-surface-variant block mb-4">
            Reading
          </span>

          <h2 class="font-headline-md text-headline-md mb-4">
            Foundational Books
          </h2>

          <p class="text-body-md text-on-surface-variant">
            Long-form reading recommendations centered around focus, philosophy, creativity, and intentional living.
          </p>
        </div>
      </div>

      <div class="bg-surface-container-low border border-outline-variant rounded-2xl overflow-hidden">
        <div class="aspect-[4/3] overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?q=80&w=1400&auto=format&fit=crop"
            alt="Workspace"
            width="1400"
            height="1050"
            class="w-full h-full object-cover grayscale"
          >
        </div>

        <div class="p-8">
          <span class="text-label-md uppercase tracking-[0.2em] text-on-surface-variant block mb-4">
            Systems
          </span>

          <h2 class="font-headline-md text-headline-md mb-4">
            Deep Work Rituals
          </h2>

          <p class="text-body-md text-on-surface-variant">
            Focus systems, environmental design, and practical frameworks for entering sustained concentration.
          </p>
        </div>
      </div>

      <div class="bg-surface-container-low border border-outline-variant rounded-2xl overflow-hidden">
        <div class="aspect-[4/3] overflow-hidden">
          <img
            src="https://images.unsplash.com/photo-1455390582262-044cdead277a?q=80&w=1400&auto=format&fit=crop"
            alt="Writing"
            width="1400"
            height="1050"
            class="w-full h-full object-cover"
          >
        </div>

        <div class="p-8">
          <span class="text-label-md uppercase tracking-[0.2em] text-on-surface-variant block mb-4">
            Writing
          </span>

          <h2 class="font-headline-md text-headline-md mb-4">
            Essays & Reflections
          </h2>

          <p class="text-body-md text-on-surface-variant">
            Thoughtful writing about technology, creativity, learning, and building meaningful systems.
          </p>
        </div>
      </div>

    </div>

  </div>
</section>

<section class="px-margin-mobile md:px-margin-desktop py-32 bg-primary text-on-primary">
  <div class="max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-2 gap-gutter items-center">

    <div>
      <span class="block uppercase tracking-[0.2em] text-label-md opacity-70 mb-6">
        Future Expansion
      </span>

      <h2 class="font-headline-lg text-headline-lg md:text-[72px] leading-tight">
        A growing archive of intentional knowledge.
      </h2>
    </div>

    <div class="space-y-8">
      <p class="text-body-lg opacity-80">
        The library will continue expanding with curated reading lists, educational systems, focus tools, and long-form resources.
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="/pages/journal" class="bg-surface text-on-surface px-7 py-3 rounded-full">
          Read Journal
        </a>

        <a href="/pages/philosophy" class="border border-white/30 px-7 py-3 rounded-full">
          Philosophy
        </a>
      </div>
    </div>

  </div>
</section>

{% schema %}
