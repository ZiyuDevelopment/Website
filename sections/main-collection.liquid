<section class="gg-store-hero">
  <div class="gg-store-grid-bg"></div>

  <div class="gg-container gg-store-hero-grid">
    <div class="gg-store-copy reveal">
      <span class="gg-kicker">Goal Grower Store</span>

      <h1>Shop things that help the garden grow.</h1>

      <p>
        Every purchase helps support Goal Grower development, testing, launch prep,
        and future Ziyu Development projects.
      </p>

      <div class="gg-hero-actions">
        <a href="#featured-products" class="gg-btn">Shop Products</a>
        <a href="/pages/support" class="gg-btn-soft">Support the Project</a>
      </div>
    </div>

    <div class="gg-store-orbit reveal">
      <div class="gg-store-circle"></div>

      <div class="gg-store-center">
        <span>Support</span>
        <strong>Build</strong>
      </div>

      <div class="gg-store-chip chip-a">
        <strong>Apps</strong>
        <span>Goal Grower</span>
      </div>

      <div class="gg-store-chip chip-b">
        <strong>Digital</strong>
        <span>tools</span>
      </div>

      <div class="gg-store-chip chip-c">
        <strong>Merch</strong>
        <span>mission goods</span>
      </div>
    </div>
  </div>
</section>

<section class="gg-store-intro">
  <div class="gg-container gg-store-intro-grid">
    <div>
      <span class="gg-kicker">Why shop here</span>
      <h2>Your purchase is part of the build.</h2>
    </div>

    <div>
      <p>
        This store exists to support small, intentional software projects. Some
        products are digital, some are physical, and some are simple ways to fund
        the work behind Goal Grower.
      </p>
    </div>
  </div>
</section>

<section class="gg-store-categories">
  <div class="gg-container">
    <div class="gg-section-heading reveal">
      <span class="gg-kicker">Store paths</span>
      <h2>Choose what kind of support fits you.</h2>
    </div>

    <div class="gg-store-path-grid">
      <a href="/collections/all" class="gg-store-path reveal">
        <span>01</span>
        <h3>Support items</h3>
        <p>Simple products that help fund Goal Grower development.</p>
      </a>

      <a href="/collections/all" class="gg-store-path featured reveal">
        <span>02</span>
        <h3>Digital tools</h3>
        <p>Templates, resources, and future downloads made to help people grow.</p>
      </a>

      <a href="/collections/all" class="gg-store-path reveal">
        <span>03</span>
        <h3>Project merch</h3>
        <p>Physical items connected to the mission and future app projects.</p>
      </a>
    </div>
  </div>
</section>

<section id="featured-products" class="gg-store-products">
  <div class="gg-container">
    <div class="gg-section-heading reveal">
      <span class="gg-kicker">Featured products</span>
      <h2>Available in the store.</h2>
      <p>
        Products may change as the project grows. Each purchase supports the next
        stage of development.
      </p>
    </div>

    {% if collections.all.products.size > 0 %}
      <div class="gg-product-grid">
        {% for product in collections.all.products limit: 6 %}
          <a href="{{ product.url }}" class="gg-product-card reveal">
            <div class="gg-product-image">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}
              {% else %}
                <div class="gg-product-placeholder"></div>
              {% endif %}
            </div>

            <div class="gg-product-info">
              <h3>{{ product.title }}</h3>
              <p>{{ product.price | money }}</p>
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="gg-empty-store reveal">
        <span class="gg-kicker">Coming soon</span>
        <h3>Products are being prepared.</h3>
        <p>
          The store will include support products, digital tools, and project
          items as Goal Grower moves closer to launch.
        </p>
        <a href="/pages/support" class="gg-btn">Support Development</a>
      </div>
    {% endif %}
  </div>
</section>

<section class="gg-store-impact">
  <div class="gg-container gg-store-impact-grid">
    <div class="reveal">
      <span class="gg-kicker light">Where it goes</span>
      <h2>Purchases help move Goal Grower forward.</h2>
    </div>

    <div class="gg-store-impact-list reveal">
      <div>
        <strong>Testing</strong>
        <span>Getting the app into real hands.</span>
      </div>

      <div>
        <strong>Design polish</strong>
        <span>Improving screens, flow, and clarity.</span>
      </div>

      <div>
        <strong>Launch prep</strong>
        <span>Preparing app store assets and release steps.</span>
      </div>
    </div>
  </div>
</section>

<section class="gg-store-close">
  <div class="gg-container">
    <div class="gg-store-close-panel reveal">
      <span class="gg-kicker">Thank you</span>

      <h2>Shop with the mission in mind.</h2>

      <p>
        Whether you buy something, test the app, or share the project, you are
        helping Goal Grower become real.
      </p>

      <div class="gg-hero-actions center">
        <a href="/collections/all" class="gg-btn">View Products</a>
        <a href="/pages/contact" class="gg-btn-soft">Become a Tester</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Goal Grower Store",
  "settings": [],
  "presets": [
    {
      "name": "Goal Grower Store"
    }
  ]
}
{% endschema %}