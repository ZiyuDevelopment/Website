<section class="gg-storefront">
  <div class="gg-container">
    <div class="gg-storefront-hero">
      <div>
        <span class="gg-kicker">Ziyu Development Store</span>
        <h1>Support the build.</h1>
        <p>
          Shop products that help fund Goal Grower development, testing, launch prep,
          and future intentional software projects.
        </p>
        <div class="gg-hero-actions">
          <a href="#products" class="gg-btn">Shop Products</a>
          <a href="#why-it-matters" class="gg-btn-soft">Why It Matters</a>
        </div>
      </div>

      {% assign featured_product = collection.products.first %}
      {% if featured_product %}
        <a href="{{ featured_product.url }}" class="gg-featured-product">
          <span>Featured</span>
          <div class="gg-featured-image">
            {% if featured_product.featured_image %}
              {{ featured_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: featured_product.title }}
            {% else %}
              <div class="gg-product-placeholder"></div>
            {% endif %}
          </div>
          <h2>{{ featured_product.title }}</h2>
          <p>{{ featured_product.price | money }}</p>
        </a>
      {% endif %}
    </div>

    <div class="gg-shop-categories">
      <a href="#support-development">Support Development</a>
      <a href="#products">Products</a>
      <a href="#why-it-matters">Why Purchases Matter</a>
      <a href="#future">Future Releases</a>
    </div>

    <section id="support-development" class="gg-direct-support">
      <div class="gg-direct-support-copy">
        <span class="gg-kicker">Support development</span>

        <h2>Help Bring <span class="gg-highlight">Goal Grower</span><br>to Life</h2>

        <p>
          Help fund app testing, design polish, launch preparation, and future development.
        </p>
      </div>

      <div class="gg-direct-support-side">
        <div class="gg-support-amounts">
          {% assign support_5 = all_products['support-goal-grower-5'] %}
          {% assign support_10 = all_products['support-goal-grower-10'] %}
          {% assign support_25 = all_products['support-goal-grower-25'] %}

          {% if support_5 %}
            <a href="/cart/add?id={{ support_5.selected_or_first_available_variant.id }}&quantity=1&return_to=/cart" class="gg-support-amount">
              <strong>$5</strong>
              <span>Small support</span>
            </a>
          {% endif %}

          {% if support_10 %}
            <a href="/cart/add?id={{ support_10.selected_or_first_available_variant.id }}&quantity=1&return_to=/cart" class="gg-support-amount featured">
              <strong>$10</strong>
              <span>Help the build</span>
            </a>
          {% endif %}

          {% if support_25 %}
            <a href="/cart/add?id={{ support_25.selected_or_first_available_variant.id }}&quantity=1&return_to=/cart" class="gg-support-amount">
              <strong>$25</strong>
              <span>Launch support</span>
            </a>
          {% endif %}
        </div>

        {% assign custom_support = all_products['custom-support-goal-grower'] %}

        {% if custom_support %}
          <div class="gg-custom-support">
            <div class="gg-custom-copy">
              <strong>Custom</strong>
              <span>Choose your own support amount.</span>
            </div>

            <form action="/cart/add" method="post" class="gg-custom-support-form">
              <input 
                type="hidden" 
                name="id" 
                value="{{ custom_support.selected_or_first_available_variant.id }}"
              >

              <input
                type="hidden"
                name="properties[Support type]"
                value="Custom Goal Grower support"
              >

              <label for="custom-support-amount">Amount</label>

              <div class="gg-custom-input-wrap">
                <span>$</span>
                <input 
                  id="custom-support-amount"
                  type="number" 
                  name="quantity" 
                  min="15" 
                  value="15"
                  step="1" 
                  required
                >
              </div>

              <button type="submit" class="gg-custom-submit">
                Add Support
              </button>
            </form>
          </div>
        {% endif %}
      </div>
    </section>

    <section id="products" class="gg-shop-products">
      <div class="gg-shop-heading">
        <span>{{ collection.products_count }} products</span>
        <h2>Available now</h2>
      </div>

      <div class="gg-shop-tools">
        <div class="gg-shop-search">
          <div class="gg-shop-search-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="M20 20l-3.5-3.5"></path>
            </svg>

            <input
              id="gg-product-search"
              type="search"
              placeholder="Search products"
              autocomplete="on"
            >
          </div>
        </div>
        </div>

      {% if collection.products.size > 0 %}
        <div class="gg-shop-grid">
          {% for product in collection.products %}
            <a
              href="{{ product.url }}"
              class="gg-shop-card"
              data-product-card
              data-product-title="{{ product.title | downcase | escape }}"
            >
              <div class="gg-shop-image">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}
                {% else %}
                  <div class="gg-product-placeholder"></div>
                {% endif %}
              </div>

              <div class="gg-shop-info">
                <span>{{ product.type | default: 'Support item' }}</span>
                <h3>{{ product.title }}</h3>
                <p>{{ product.price | money }}</p>
              </div>
            </a>
          {% endfor %}
        </div>
      {% else %}
        <div class="gg-empty-store">
          <h2>Products are coming soon.</h2>
          <p>The store is being prepared.</p>
        </div>
      {% endif %}
    </section>

    <section id="why-it-matters" class="gg-purchase-impact">
      <div>
        <span class="gg-kicker">Why purchases matter</span>
        <h2>Every purchase helps move Goal Grower closer to launch.</h2>
      </div>

      <div class="gg-impact-bars">
        <div>
          <span>Development</span>
          <strong><i style="width: 82%"></i></strong>
        </div>
        <div>
          <span>Testing</span>
          <strong><i style="width: 64%"></i></strong>
        </div>
        <div>
          <span>Launch Prep</span>
          <strong><i style="width: 46%"></i></strong>
        </div>
      </div>
    </section>

    <section id="future" class="gg-future-projects">
      <span class="gg-kicker">Coming next</span>
      <h2>Future projects from the studio.</h2>

      <div class="gg-future-grid">
        <div><strong>MyJourney</strong><span>Life archive app</span></div>
        <div><strong>Blokkr</strong><span>Focus tool</span></div>
        <div><strong>KindLitt</strong><span>Reading helper</span></div>
        <div><strong>EyeDry</strong><span>Eye-rest reminder</span></div>
      </div>
    </section>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const input = document.getElementById('gg-product-search');
  const cards = document.querySelectorAll('[data-product-card]');

  if (!input) return;

  input.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      event.preventDefault();
    }
  });

  input.addEventListener('input', () => {
    const search = input.value.toLowerCase().trim();

    cards.forEach(card => {
      const title = card.dataset.productTitle || '';
      card.style.display = title.includes(search) ? '' : 'none';
    });
  });
});
</script>

{% schema %}
{
  "name": "Main Collection",
  "settings": []
}
{% endschema %}