<section class="gg-page-hero">
  <div class="gg-container reveal">
    <span class="gg-kicker">Store</span>
    <h1>{{ collection.title | default: 'Support Store' }}</h1>

    {% if collection.description != blank %}
      <p>{{ collection.description }}</p>
    {% else %}
      <p>Products and support items that help fund Goal Grower development.</p>
    {% endif %}
  </div>
</section>

<section class="gg-section">
  <div class="gg-container">
    {% if collection.products_count > 0 %}
      <div class="gg-product-grid">
        {% for product in collection.products %}
          <a class="gg-product-card reveal" href="{{ product.url }}">
            <div class="gg-product-image">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}
              {% else %}
                <div class="gg-product-placeholder"></div>
              {% endif %}
            </div>

            <div class="gg-product-info">
              <h3>{{ product.title }}</h3>
              <p>{{ product.price | money }}</p>
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="gg-empty-state reveal">
        <h2>No products yet.</h2>
        <p>Add products in Shopify admin and they will appear here.</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main Collection",
  "settings": []
}
{% endschema %}