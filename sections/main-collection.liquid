<main class="zd-all-products">

  <section class="zdap-hero">
    <p class="zdap-eyebrow">Ziyu Store</p>
    <h1>Products that help fund intentional technology.</h1>
    <p>
      Browse digital tools, support items, merchandise, and curated products connected
      to Ziyu Development and apps like Goal Grower.
    </p>
  </section>

  <section class="zdap-toolbar">
    <div>
      <span>{{ collection.products_count }} products</span>
      <p>Every purchase helps support development, testing, design, hosting, and launch costs.</p>
    </div>

    <div class="zdap-toolbar__links">
      <a href="/pages/store">Store Overview</a>
      <a href="/pages/support">Support Development</a>
    </div>
  </section>

  <section class="zdap-grid">
    {% paginate collection.products by 24 %}
      {% for product in collection.products %}
        <article class="zdap-card">
          <a href="{{ product.url }}" class="zdap-card__image">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 900 }}"
                alt="{{ product.featured_image.alt | escape }}"
                width="900"
                height="900"
                loading="lazy"
              >
            {% else %}
              <div class="zdap-card__placeholder">
                <span>Z</span>
              </div>
            {% endif %}
          </a>

          <div class="zdap-card__body">
            <p class="zdap-card__type">
              {% if product.type != blank %}
                {{ product.type }}
              {% else %}
                Ziyu Product
              {% endif %}
            </p>

            <h2>
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h2>

            {% if product.description != blank %}
              <p class="zdap-card__desc">
                {{ product.description | strip_html | truncate: 110 }}
              </p>
            {% endif %}

            <div class="zdap-card__bottom">
              <span>{{ product.price | money }}</span>
              <a href="{{ product.url }}">View Product</a>
            </div>
          </div>
        </article>
      {% else %}
        <div class="zdap-empty">
          <h2>No products yet.</h2>
          <p>Add products to this collection in Shopify Admin.</p>
        </div>
      {% endfor %}

      {% if paginate.pages > 1 %}
        <nav class="zdap-pagination">
          {{ paginate | default_pagination }}
        </nav>
      {% endif %}
    {% endpaginate %}
  </section>

</main>

{% schema %}
{
  "name": "All Products Collection",
  "settings": [],
  "presets": [
    {
      "name": "All Products Collection"
    }
  ]
}
{% endschema %}