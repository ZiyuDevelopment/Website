<section class="gg-shop-page">
  <div class="gg-container">
    <div class="gg-shop-hero">
      <div>
        <span class="gg-kicker">Ziyu Development Store</span>
        <h1>Build-supporting products for intentional growth.</h1>
        <p>
          Shop digital tools, project merch, and support items that help fund Goal Grower and future app projects.
        </p>
      </div>

      <div class="gg-shop-note">
        <strong>Every purchase supports development.</strong>
        <span>Testing, design polish, launch prep, and future tools.</span>
      </div>
    </div>

    <div class="gg-shop-toolbar">
      <span>{{ collection.products_count }} products</span>
      <a href="/pages/support">Why purchases matter</a>
    </div>

    {% if collection.products.size > 0 %}
      <div class="gg-shop-grid">
        {% for product in collection.products %}
          <a href="{{ product.url }}" class="gg-shop-card">
            <div class="gg-shop-image">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}
              {% else %}
                <div class="gg-product-placeholder"></div>
              {% endif %}
            </div>

            <div class="gg-shop-info">
              <span>{{ product.type | default: 'Support item' }}</span>
              <h2>{{ product.title }}</h2>
              <div class="gg-shop-price-row">
                <p>{{ product.price | money }}</p>
                <small>View item</small>
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="gg-empty-store">
        <h2>Products are coming soon.</h2>
        <p>The store is being prepared.</p>
      </div>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Main Collection",
  "settings": []
}
{% endschema %}