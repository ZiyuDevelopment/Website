<section class="gg-shop-direct">
  <div class="gg-container">
    <div class="gg-shop-direct-hero">
      <span class="gg-kicker">Store</span>
      <h1>Support the build.</h1>
      <p>
        Products here help fund Goal Grower development, testing, and future app projects.
      </p>
    </div>

    {% if collection.products.size > 0 %}
      <div class="gg-shop-direct-grid">
        {% for product in collection.products %}
          <a href="{{ product.url }}" class="gg-shop-direct-card">
            <div class="gg-shop-direct-image">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}
              {% else %}
                <div class="gg-product-placeholder"></div>
              {% endif %}
            </div>

            <div class="gg-shop-direct-info">
              <span>{{ product.type | default: 'Support item' }}</span>
              <h2>{{ product.title }}</h2>
              <p>{{ product.price | money }}</p>
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="gg-empty-store">
        <h2>No products yet.</h2>
        <p>Products are being prepared.</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main Collection",
  "settings": []
}
{% endschema %}