<section class="ziyu-section">
  <div class="ziyu-container">

    <div class="ziyu-journal-hero">
      <div>
        <span class="ziyu-label">Journal</span>

        <h1 class="ziyu-h1">
          Field notes from building slower technology.
        </h1>
      </div>

      <p class="ziyu-body-lg">
        Essays, reflections, build notes, and philosophy from the Ziyu archive.
      </p>
    </div>

    <article class="ziyu-featured-article ziyu-card">
      <div class="ziyu-featured-article__image">
        <img
          class="ziyu-image"
          src="https://images.unsplash.com/photo-1455390582262-044cdead277a?q=80&w=1800&auto=format&fit=crop"
          alt="Writing desk"
          width="1800"
          height="1200"
        >
      </div>

      <div class="ziyu-featured-article__content">
        <span class="ziyu-label ziyu-label--muted">Featured Essay · 12 min read</span>

        <h2 class="ziyu-h2">
          The ethics of intentional disconnection.
        </h2>

        <p class="ziyu-body-lg">
          Exploring the boundary between digital utility and human presence in a world designed to keep us returning.
        </p>

        <a href="#" class="ziyu-card-link">Read Essay →</a>
      </div>
    </article>

    <div class="ziyu-article-grid">

      <article class="ziyu-card">
        <div class="ziyu-article-card__image">
          <img
            class="ziyu-image ziyu-grayscale"
            src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?q=80&w=1200&auto=format&fit=crop"
            alt="Quiet landscape"
            width="1200"
            height="900"
          >
        </div>

        <div class="ziyu-article-card__content">
          <span class="ziyu-label ziyu-label--muted">Practice · 8 min read</span>
          <h3 class="ziyu-h4">Designing your physical sanctuary</h3>
          <p class="ziyu-body">How environment shapes cognitive load, attention, and deep work.</p>
        </div>
      </article>

      <article class="ziyu-card">
        <div class="ziyu-article-card__image">
          <img
            class="ziyu-image"
            src="https://images.unsplash.com/photo-1517971071642-34a2d3ecc9cd?q=80&w=1200&auto=format&fit=crop"
            alt="Paper texture"
            width="1200"
            height="900"
          >
        </div>

        <div class="ziyu-article-card__content">
          <span class="ziyu-label ziyu-label--muted">Essay · 15 min read</span>
          <h3 class="ziyu-h4">The permanence of the printed word</h3>
          <p class="ziyu-body">Why physical artifacts still anchor long-form thought in an ephemeral age.</p>
        </div>
      </article>

      <article class="ziyu-card">
        <div class="ziyu-article-card__image">
          <img
            class="ziyu-image"
            src="https://images.unsplash.com/photo-1499750310107-5fef28a66643?q=80&w=1200&auto=format&fit=crop"
            alt="Notebook"
            width="1200"
            height="900"
          >
        </div>

        <div class="ziyu-article-card__content">
          <span class="ziyu-label ziyu-label--muted">Build Log · 6 min read</span>
          <h3 class="ziyu-h4">Turning Goal Grower into a living system</h3>
          <p class="ziyu-body">A behind-the-scenes look at designing progress without pressure.</p>
        </div>
      </article>

    </div>
  </div>
</section>

<section class="ziyu-section ziyu-section--dark">
  <div class="ziyu-manifesto">
    <span class="ziyu-label" style="color: rgba(255,255,255,.7);">
      Join the Archive
    </span>

    <h2 class="ziyu-h2">
      Receive field notes from the journey.
    </h2>

    <form class="ziyu-form">
      <input type="email" placeholder="your@email.com">
      <button type="submit">Join</button>
    </form>
  </div>
</section>

{% schema %}
{
  "name": "Journal",
  "settings": [],
  "presets": [
    {
      "name": "Journal"
    }
  ]
}
{% endschema %}