<section class="min-h-screen bg-surface text-on-surface px-margin-mobile md:px-margin-desktop py-[160px] flex items-center">
  <div class="max-w-container-max mx-auto grid md:grid-cols-2 gap-24 items-center">

    <div>
      <span class="text-primary uppercase tracking-[0.2em] text-label-md block mb-6">
        Physical Archive
      </span>

      <h1 class="font-headline-xl text-headline-xl md:text-[84px] leading-tight mb-8">
        The Foundation Mat
      </h1>

      <p class="text-body-lg text-secondary mb-10 max-w-xl">
        A seamless surface crafted from vegetable-tanned leather and natural cork,
        designed to ground your workspace and define the boundaries of deep work.
      </p>

      <div class="grid grid-cols-2 gap-4 mb-10">
        <div class="border-l-2 border-outline/30 pl-4">
          <span class="block text-[10px] uppercase text-secondary font-bold tracking-widest">Dimensions</span>
          <span class="font-body-md">90x40 Centimeters</span>
        </div>

        <div class="border-l-2 border-outline/30 pl-4">
          <span class="block text-[10px] uppercase text-secondary font-bold tracking-widest">Thickness</span>
          <span class="font-body-md">4.5mm</span>
        </div>

        <div class="border-l-2 border-outline/30 pl-4">
          <span class="block text-[10px] uppercase text-secondary font-bold tracking-widest">Material</span>
          <span class="font-body-md">Veg-Tanned Leather</span>
        </div>
      </div>

      <a href="/" class="inline-block px-8 py-4 rounded-xl bg-primary text-on-primary hover:bg-primary-container transition-colors">
        Return Home
      </a>
    </div>

    <div class="rounded-xl overflow-hidden shadow-xl aspect-[4/3]">
      <img
        src="https://images.unsplash.com/photo-1515879218367-8466d910aaa4?q=80&w=1600&auto=format&fit=crop"
        alt="Foundation Mat"
        width="1600"
        height="1200"
        class="w-full h-full object-cover"
      >
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Foundation Mat",
  "settings": [],
  "presets": [
    {
      "name": "Foundation Mat"
    }
  ]
}
{% endschema %}