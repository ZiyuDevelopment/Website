<main class="zd-store">

  <section class="zds-hero">
    <p class="zds-eyebrow">Ziyu Store</p>
    <h1>Curated products that help fund intentional apps.</h1>
    <p>
      Shop digital products, development-support items, merchandise, and focused lifestyle tools.
      Every purchase helps support Ziyu Development and apps like Goal Grower.
    </p>

    <div class="zds-hero__actions">
      <a href="/collections/all">Shop All</a>
      <a href="/pages/support">Support Development</a>
    </div>
  </section>

  <section class="zds-featured">
    <div class="zds-featured__copy">
      <p class="zds-eyebrow">Featured Collection</p>
      <h2>Artifacts for focus, growth, and better digital habits.</h2>
      <p>
        Start with the main collection: products connected to intentional living,
        app development, focus, learning, and personal growth.
      </p>
      <a href="/collections/all">View Featured Collection</a>
    </div>

