<section class="ambient-grain min-h-screen px-margin-mobile md:px-margin-desktop py-28 md:py-40 bg-surface overflow-hidden">
  <div class="relative max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center page-reveal">

    <div class="lg:col-span-5">
      <span class="chapter-label text-secondary mb-8 block">
        Chapter 01 · In Development
      </span>

      <h1 class="font-headline-xl text-headline-xl md:text-[104px] leading-[0.9] tracking-[-0.06em] mb-10">
        Goal Grower
      </h1>

      <p class="text-body-lg text-on-surface-variant max-w-xl mb-10 leading-relaxed">
        A botanical goal-tracking system where habits, projects, and long-term growth become a living garden.
      </p>

      <div class="flex flex-wrap gap-3 mb-10">
        <span class="border border-outline px-4 py-2 rounded-full text-sm">App</span>
        <span class="border border-outline px-4 py-2 rounded-full text-sm">In Development</span>
        <span class="border border-outline px-4 py-2 rounded-full text-sm">Waitlist</span>
      </div>

      <div class="flex flex-wrap gap-4">
        <a href="/pages/support" class="bg-primary text-on-primary px-8 py-4 rounded-full">
          Join Waitlist
        </a>

        <a href="/pages/roadmap" class="border border-outline px-8 py-4 rounded-full hover:bg-surface-container transition-all">
          View Roadmap
        </a>
      </div>
    </div>

    <div class="lg:col-span-7">
      <div class="relative">
        <div class="absolute -inset-8 bg-secondary-container/50 blur-[90px] rounded-full"></div>

        <div class="relative rounded-2xl overflow-hidden border border-outline-variant cinematic-card bg-surface-container">
          <img
            src="https://images.unsplash.com/photo-1466692476868-aef1dfb1e735?q=80&w=1800&auto=format&fit=crop"
            alt="Goal Grower"
            width="1800"
            height="1200"
            class="w-full h-full object-cover cinematic-image"
          >
        </div>

        <div class="absolute -bottom-10 left-10 right-10 bg-surface-container-lowest border border-outline-variant rounded-2xl p-6 shadow-xl hidden md:block">
          <span class="chapter-label text-secondary block mb-3">Interface Principle</span>
          <p class="font-headline-md text-headline-md italic leading-tight">
            “Progress should feel cultivated, not chased.”
          </p>
        </div>
      </div>
    </div>

  </div>
</section>

<section class="px-margin-mobile md:px-margin-desktop py-32 bg-surface-container-low">
  <div class="max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-12 gap-gutter">

    <div class="lg:col-span-5">
      <span class="chapter-label text-secondary mb-6 block">
        Origin Story
      </span>

      <h2 class="font-headline-lg text-headline-lg md:text-[72px] leading-tight">
        Productivity apps often make growth feel like pressure.
      </h2>
    </div>

    <div class="lg:col-span-7 space-y-8 text-body-lg text-on-surface-variant leading-relaxed">
      <p>
        Goal Grower starts from a different metaphor. Instead of streak pressure, harsh dashboards, and gamified urgency, it treats goals like living systems that need attention, patience, and care.
      </p>

      <p>
        The goal is to help users build a life slowly and sustainably: one habit, one project, one intentional action at a time.
      </p>
    </div>

  </div>
</section>

<section class="px-margin-mobile md:px-margin-desktop py-32 bg-surface">
  <div class="max-w-container-max mx-auto">

    <div class="max-w-4xl mb-24">
      <span class="chapter-label text-secondary mb-6 block">
        Experience
      </span>

      <h2 class="font-headline-lg text-headline-lg md:text-[76px] leading-tight">
        Features designed as emotional systems.
      </h2>
    </div>

    <div class="space-y-28">

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">
        <div class="lg:col-span-6">
          <span class="chapter-label text-secondary mb-5 block">System 01</span>
          <h3 class="font-headline-lg text-headline-lg mb-6">Botanical Progress</h3>
          <p class="text-body-lg text-on-surface-variant leading-relaxed">
            Goals grow visually over time, turning consistency into something you can feel and recognize.
          </p>
        </div>

        <div class="lg:col-span-6 rounded-2xl overflow-hidden border border-outline-variant cinematic-card">
          <img src="https://images.unsplash.com/photo-1520412099551-62b6bafeb5bb?q=80&w=1600&auto=format&fit=crop" alt="Botanical growth" width="1600" height="1000" class="w-full h-full object-cover cinematic-image">
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">
        <div class="lg:col-span-6 lg:order-2">
          <span class="chapter-label text-secondary mb-5 block">System 02</span>
          <h3 class="font-headline-lg text-headline-lg mb-6">Realms of Life</h3>
          <p class="text-body-lg text-on-surface-variant leading-relaxed">
            Organize growth by meaningful life areas: learning, health, spirituality, creativity, work, and relationships.
          </p>
        </div>

        <div class="lg:col-span-6 lg:order-1 rounded-2xl overflow-hidden border border-outline-variant cinematic-card">
          <img src="https://images.unsplash.com/photo-1519681393784-d120267933ba?q=80&w=1600&auto=format&fit=crop" alt="Life realms" width="1600" height="1000" class="w-full h-full object-cover cinematic-image">
        </div>
      </div>

    </div>

  </div>
</section>

<section class="px-margin-mobile md:px-margin-desktop py-32 bg-primary text-on-primary">
  <div class="max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-2 gap-gutter items-center">

    <div>
      <span class="chapter-label opacity-70 mb-6 block">
        Join the Build
      </span>

      <h2 class="font-headline-lg text-headline-lg md:text-[76px] leading-tight">
        Help shape the first version.
      </h2>
    </div>

    <div>
      <p class="text-body-lg opacity-80 mb-10 leading-relaxed">
        Early supporters help guide the direction of Goal Grower before launch through feedback, testing, and field notes.
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="/pages/support" class="bg-surface text-on-surface px-7 py-3 rounded-full">
          Join Waitlist
        </a>

        <a href="/pages/changelog" class="border border-white/30 px-7 py-3 rounded-full">
          Development Log
        </a>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Goal Grower",
  "settings": [],
  "presets": [
    {
      "name": "Goal Grower"
    }
  ]
}
{% endschema %}