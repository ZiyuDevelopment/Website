<section class="px-margin-mobile md:px-margin-desktop py-24 md:py-36 bg-surface">
  <div class="max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">

    <div class="lg:col-span-6">
      <span class="block uppercase tracking-[0.2em] text-label-md text-on-surface-variant mb-8">
        Goal Grower
      </span>

      <h1 class="font-headline-xl text-headline-xl md:text-[88px] leading-[0.95] tracking-[-0.04em] mb-8">
        Grow your life like a garden.
      </h1>

      <p class="text-body-lg text-on-surface-variant max-w-xl mb-10">
        Goal Grower transforms habits, projects, and personal growth into a living ecosystem. Every completed action nourishes your digital garden.
      </p>

      <div class="flex flex-wrap gap-4 mb-16">
        <a href="/pages/store" class="bg-primary text-on-primary px-7 py-3 rounded-full">
          Join Waitlist
        </a>

        <a href="/pages/archive" class="border border-outline px-7 py-3 rounded-full hover:bg-surface-container">
          Read Philosophy
        </a>
      </div>

      <div class="grid grid-cols-2 gap-8">
        <div>
          <div class="text-4xl font-headline-lg mb-2">+72%</div>
          <p class="text-body-sm text-on-surface-variant">
            average habit consistency increase
          </p>
        </div>

        <div>
          <div class="text-4xl font-headline-lg mb-2">∞</div>
          <p class="text-body-sm text-on-surface-variant">
            customizable growth paths
          </p>
        </div>
      </div>
    </div>

    <div class="lg:col-span-6">
      <div class="rounded-2xl overflow-hidden border border-outline-variant bg-surface-container shadow-[0_30px_100px_rgba(0,0,0,0.08)]">
        <img
          src="https://images.unsplash.com/photo-1466692476868-aef1dfb1e735?q=80&w=1800&auto=format&fit=crop"
          alt="Goal Grower"
          width="1800"
          height="2200"
          class="w-full h-full object-cover"
        >
      </div>
    </div>

  </div>
</section>

<section class="px-margin-mobile md:px-margin-desktop py-28 bg-surface-container-low">
  <div class="max-w-container-max mx-auto">

    <div class="max-w-3xl mb-20">
      <span class="block uppercase tracking-[0.2em] text-label-md text-on-surface-variant mb-6">
        Core System
      </span>

      <h2 class="font-headline-lg text-headline-lg md:text-[64px] leading-tight">
        Progress designed around natural growth.
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">

      <div class="bg-surface rounded-xl border border-outline-variant p-10">
        <span class="material-symbols-outlined text-5xl mb-8">spa</span>

        <h3 class="font-headline-md text-headline-md mb-4">
          Botanical Progress
        </h3>

        <p class="text-body-md text-on-surface-variant">
          Goals visually grow into plants, forests, and ecosystems over time.
        </p>
      </div>

      <div class="bg-surface rounded-xl border border-outline-variant p-10">
        <span class="material-symbols-outlined text-5xl mb-8">timeline</span>

        <h3 class="font-headline-md text-headline-md mb-4">
          Long-Term Thinking
        </h3>

        <p class="text-body-md text-on-surface-variant">
          Designed to reward consistency and intentional progress instead of short dopamine loops.
        </p>
      </div>

      <div class="bg-surface rounded-xl border border-outline-variant p-10">
        <span class="material-symbols-outlined text-5xl mb-8">eco</span>

        <h3 class="font-headline-md text-headline-md mb-4">
          Living Interface
        </h3>

        <p class="text-body-md text-on-surface-variant">
          Your interface evolves based on your behavior, routines, and achievements.
        </p>
      </div>

    </div>

  </div>
</section>

<section class="px-margin-mobile md:px-margin-desktop py-32 bg-primary text-on-primary">
  <div class="max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-2 gap-gutter items-center">

    <div>
      <span class="block uppercase tracking-[0.2em] text-label-md opacity-70 mb-6">
        Future Features
      </span>

      <h2 class="font-headline-lg text-headline-lg md:text-[72px] leading-tight mb-8">
        Built to become your life's headquarters.
      </h2>
    </div>

    <div class="space-y-8">
      <div class="border-b border-white/20 pb-6">
        <h3 class="font-headline-md text-headline-md mb-2">
          Realm-Based Growth
        </h3>

        <p class="opacity-80">
          Separate areas for fitness, learning, spirituality, creativity, and work.
        </p>
      </div>

      <div class="border-b border-white/20 pb-6">
        <h3 class="font-headline-md text-headline-md mb-2">
          Accountability Gardens
        </h3>

        <p class="opacity-80">
          Grow collaborative ecosystems with friends and communities.
        </p>
      </div>

      <div>
        <h3 class="font-headline-md text-headline-md mb-2">
          Cross-Platform Archive
        </h3>

        <p class="opacity-80">
          Your entire life system synchronized across devices and years.
        </p>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Goal Grower",
  "settings": [],
  "presets": [
    {
      "name": "Goal Grower"
    }
  ]
}
{% endschema %}