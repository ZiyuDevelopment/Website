<section class="px-margin-mobile md:px-margin-desktop py-24 md:py-36 bg-surface">
  <div class="max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">

    <div class="lg:col-span-6">
      <span class="block uppercase tracking-[0.2em] text-label-md text-on-surface-variant mb-8">
        Goal Grower
      </span>

      <h1 class="font-headline-xl text-headline-xl md:text-[88px] leading-[0.95] tracking-[-0.04em] mb-8">
        Grow goals instead of forcing them.
      </h1>

      <p class="text-body-lg text-on-surface-variant mb-10 max-w-xl">
        Goal Grower turns personal progress into a quiet botanical system. Your goals become living things that grow through consistency, care, and reflection.
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="/pages/store" class="bg-primary text-on-primary px-7 py-3 rounded-full">
          Back to Store
        </a>

        <a href="/pages/roadmap" class="border border-outline px-7 py-3 rounded-full hover:bg-surface-container">
          View Roadmap
        </a>
      </div>
    </div>

    <div class="lg:col-span-6">
      <div class="aspect-[4/5] rounded-xl overflow-hidden border border-outline-variant bg-surface-container">
        <img
          src="https://images.unsplash.com/photo-1466692476868-aef1dfb1e735?q=80&w=1600&auto=format&fit=crop"
          alt="Goal Grower"
          width="1600"
          height="2000"
          class="w-full h-full object-cover"
        >
      </div>
    </div>

  </div>
</section>

<section class="px-margin-mobile md:px-margin-desktop py-28 bg-surface-container-low">
  <div class="max-w-container-max mx-auto grid grid-cols-1 md:grid-cols-3 gap-gutter">

    <div class="bg-surface border border-outline-variant rounded-xl p-8">
      <span class="material-symbols-outlined text-primary text-4xl mb-6">psychiatry</span>
      <h2 class="font-headline-md text-headline-md mb-4">Botanical Progress</h2>
      <p class="text-body-md text-on-surface-variant">
        Goals grow visually over time, helping progress feel organic instead of pressured.
      </p>
    </div>

    <div class="bg-surface border border-outline-variant rounded-xl p-8">
      <span class="material-symbols-outlined text-primary text-4xl mb-6">event_available</span>
      <h2 class="font-headline-md text-headline-md mb-4">Habit Rhythm</h2>
      <p class="text-body-md text-on-surface-variant">
        Build steady routines around flexible schedules, reflections, and realistic daily progress.
      </p>
    </div>

    <div class="bg-surface border border-outline-variant rounded-xl p-8">
      <span class="material-symbols-outlined text-primary text-4xl mb-6">group</span>
      <h2 class="font-headline-md text-headline-md mb-4">Accountability</h2>
      <p class="text-body-md text-on-surface-variant">
        Invite trusted people to support your goals without turning growth into social media.
      </p>
    </div>

  </div>
</section>

<section class="px-margin-mobile md:px-margin-desktop py-32 bg-primary text-on-primary">
  <div class="max-w-4xl mx-auto text-center">
    <h2 class="font-headline-lg text-headline-lg md:text-[72px] leading-tight mb-8">
      Designed for patient growth.
    </h2>

    <p class="text-body-lg opacity-80 mb-10">
      Goal Grower is built around the idea that becoming better should feel meaningful, not frantic.
    </p>

    <a href="/pages/checkout-page" class="inline-block bg-surface text-on-surface px-8 py-4 rounded-full">
      Join Waitlist
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Goal Grower",
  "settings": [],
  "presets": [
    {
      "name": "Goal Grower"
    }
  ]
}
{% endschema %}