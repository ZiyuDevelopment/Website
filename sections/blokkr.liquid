<section class="px-margin-mobile md:px-margin-desktop py-24 md:py-36 bg-surface">
  <div class="max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">

    <div class="lg:col-span-6">
      <span class="block uppercase tracking-[0.2em] text-label-md text-on-surface-variant mb-8">
        Blokkr
      </span>

      <h1 class="font-headline-xl text-headline-xl md:text-[88px] leading-[0.95] tracking-[-0.04em] mb-8">
        Hardware for deep work.
      </h1>

      <p class="text-body-lg text-on-surface-variant max-w-xl mb-10">
        Blokkr creates a physical boundary between you and digital distraction. A slow-tech object for focus, silence, and intentional work.
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="/pages/store" class="bg-primary text-on-primary px-7 py-3 rounded-full">
          Reserve Blokkr
        </a>

        <a href="/pages/deep-work-library" class="border border-outline px-7 py-3 rounded-full hover:bg-surface-container">
          Deep Work Library
        </a>
      </div>
    </div>

    <div class="lg:col-span-6">
      <div class="rounded-2xl overflow-hidden border border-outline-variant bg-surface-container shadow-[0_30px_100px_rgba(0,0,0,0.08)]">
        <img
          src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?q=80&w=1800&auto=format&fit=crop"
          alt="Blokkr"
          width="1800"
          height="1200"
          class="w-full h-full object-cover grayscale"
        >
      </div>
    </div>

  </div>
</section>

<section class="px-margin-mobile md:px-margin-desktop py-28 bg-surface-container-low">
  <div class="max-w-container-max mx-auto">

    <div class="max-w-3xl mb-20">
      <span class="block uppercase tracking-[0.2em] text-label-md text-on-surface-variant mb-6">
        The Object
      </span>

      <h2 class="font-headline-lg text-headline-lg md:text-[64px] leading-tight">
        A ritual tool for entering focus.
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">

      <div class="bg-surface rounded-xl border border-outline-variant p-10">
        <span class="material-symbols-outlined text-5xl mb-8">lock</span>

        <h3 class="font-headline-md text-headline-md mb-4">
          Physical Commitment
        </h3>

        <p class="text-body-md text-on-surface-variant">
          A tangible action begins the work session, making focus feel deliberate instead of accidental.
        </p>
      </div>

      <div class="bg-surface rounded-xl border border-outline-variant p-10">
        <span class="material-symbols-outlined text-5xl mb-8">timer</span>

        <h3 class="font-headline-md text-headline-md mb-4">
          Focus Windows
        </h3>

        <p class="text-body-md text-on-surface-variant">
          Set work intervals, block interruptions, and create repeatable deep work cycles.
        </p>
      </div>

      <div class="bg-surface rounded-xl border border-outline-variant p-10">
        <span class="material-symbols-outlined text-5xl mb-8">do_not_disturb_on</span>

        <h3 class="font-headline-md text-headline-md mb-4">
          Digital Boundary
        </h3>

        <p class="text-body-md text-on-surface-variant">
          Designed to help separate intentional tool use from unconscious scrolling.
        </p>
      </div>

    </div>

  </div>
</section>

<section class="px-margin-mobile md:px-margin-desktop py-32 bg-primary text-on-primary">
  <div class="max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-2 gap-gutter items-center">

    <h2 class="font-headline-lg text-headline-lg md:text-[72px] leading-tight">
      Focus is easier when it has a doorway.
    </h2>

    <div class="space-y-8">
      <p class="text-body-lg opacity-80">
        Blokkr is designed around the idea that physical rituals can help the mind transition into focused work.
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="/pages/store" class="bg-surface text-on-surface px-7 py-3 rounded-full">
          Reserve Hardware
        </a>

        <a href="/pages/philosophy" class="border border-white/30 px-7 py-3 rounded-full">
          Read Philosophy
        </a>
      </div>
    </div>

  </div>
</section>

