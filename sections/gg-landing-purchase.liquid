<section class="gg-ad-landing">
  <div class="gg-container">
    <div class="gg-ad-hero">
      <span class="gg-kicker">Support Goal Grower</span>
      <h1>Help bring Goal Grower to life.</h1>
      <p>
        Every purchase supports development, testing, design improvements, and launch
        preparation. You are helping build a better way for people to grow meaningful goals.
      </p>

      <div class="gg-hero-actions">
        <a href="/collections/all" class="gg-btn">Support Goal Grower</a>
        <a href="/pages/contact" class="gg-btn-soft">Join Beta Testing</a>
      </div>
    </div>

    <div class="gg-purchase-grid">
      <div class="gg-purchase-card">
        <span>🧪</span>
        <h2>Improve testing</h2>
        <p>More beta testing means a more polished experience.</p>
      </div>

      <div class="gg-purchase-card">
        <span>🎨</span>
        <h2>Improve design</h2>
        <p>Better visuals, smoother screens, and more enjoyable goal tracking.</p>
      </div>

      <div class="gg-purchase-card">
        <span>🚀</span>
        <h2>Accelerate launch</h2>
        <p>Support new features, improvements, and future releases.</p>
      </div>
    </div>

    <div class="gg-ad-section">
      <span class="gg-kicker">Current stage</span>
      <h2>Goal Grower is in beta testing.</h2>
      <p>
        Every order helps move Goal Grower one step closer to launch.
      </p>
      <a href="/collections/all" class="gg-btn">Shop to Support</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Goal Grower Purchase",
  "settings": [],
  "presets": [{ "name": "Goal Grower Purchase" }]
}
{% endschema %}