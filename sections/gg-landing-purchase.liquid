<section class="gg-ad-landing">
  <div class="gg-container">
    <div class="gg-ad-hero">
      <span class="gg-kicker">Support Goal Grower</span>
      <h1>Help build the app by shopping now.</h1>
      <p>
        Every order funds development, testing, and the launch experience. Support today and make Goal Grower more polished for everyone.
      </p>

      <div class="gg-hero-actions">
        <a href="/collections/all" class="gg-btn">Shop to Support</a>
        <a href="/pages/support" class="gg-btn-soft">Learn how support helps</a>
      </div>
    </div>

    <div class="gg-purchase-grid">
      <div class="gg-purchase-card">
        <h2>Fund development</h2>
        <p>Support helps the team spend more time polishing screens, flows, and interactions.</p>
      </div>

      <div class="gg-purchase-card">
        <h2>Improve testing</h2>
        <p>Every purchase makes it easier to test the app with more people and fix issues sooner.</p>
      </div>

      <div class="gg-purchase-card">
        <h2>Launch sooner</h2>
        <p>Your support helps move Goal Grower closer to a better, more ready release.</p>
      </div>
    </div>

    <div class="gg-ad-section">
      <span class="gg-kicker">Take action</span>
      <h2>Shop now and help the app grow.</h2>
      <p>
        Choose anything from the store. Each order directly supports development and makes the product stronger.
      </p>
      <a href="/collections/all" class="gg-btn">Shop to Support</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Goal Grower Purchase",
  "settings": [],
  "presets": [{ "name": "Goal Grower Purchase" }]
}
{% endschema %}