<section class="gg-ad-landing gg-purchase-page">
  <div class="gg-container">
    <div class="gg-ad-hero">
      <span class="gg-kicker">Support Goal Grower</span>

      <h1>Help bring Goal Grower to launch.</h1>

      <p>
        Every purchase helps fund development, testing, design polish, and launch preparation
        for Goal Grower and future Ziyu Development projects.
      </p>

      <div class="gg-hero-actions">
        <a href="/collections/all" class="gg-btn">Shop Products</a>
        <a href="/pages/support" class="gg-btn-soft">Support the Build</a>
      </div>
    </div>

    <div class="gg-purchase-grid">
      <div class="gg-purchase-card">
        <span>🧪</span>
        <h2>Testing</h2>
        <p>Help cover beta testing, feedback improvements, and real user polish.</p>
      </div>

      <div class="gg-purchase-card">
        <span>🎨</span>
        <h2>Design</h2>
        <p>Support better visuals, smoother screens, and a more intentional experience.</p>
      </div>

      <div class="gg-purchase-card">
        <span>🚀</span>
        <h2>Launch</h2>
        <p>Help prepare Goal Grower for a stronger public release.</p>
      </div>
    </div>

    <div class="gg-ad-section">
      <span class="gg-kicker">Make it possible</span>
      <h2>Your support helps turn the app into something real.</h2>
      <p>
        Shop the store, support development, or join the beta. Each action helps move
        Goal Grower closer to launch.
      </p>

      <a href="/collections/all" class="gg-btn">Shop Now</a>
    </div>
  </div>
</section>

