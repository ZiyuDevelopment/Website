{% comment %}
Goal Grower purchase-stage landing page replacement for sections/gg-landing-purchase.liquid
Built for a purchase-ready visitor: clear USP, benefits, trust, and repeated CTA.
{% endcomment %}
<style>

:root{
  --ink:#17231f; --muted:#5c6f66; --leaf:#28b900; --leaf-dark:#157a24;
  --sage:#e8f5de; --cream:#fffaf1; --paper:#fffdf7; --clay:#e3b48c; --blue:#4f6893;
  --shadow:0 18px 50px rgba(23,35,31,.12); --radius:28px;
}
*{box-sizing:border-box}  .gg-purchase-page{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:var(--ink);background:linear-gradient(180deg,#fffaf1 0%,#f3f8ed 42%,#fffdf7 100%);line-height:1.45}.wrap{max-width:1180px;margin:auto;padding:0 28px}.topbar{position:sticky;top:0;z-index:10;background:rgba(255,253,247,.88);backdrop-filter:blur(14px);border-bottom:1px solid rgba(23,35,31,.08)}.nav{height:76px;display:flex;align-items:center;justify-content:space-between}.brand{font-weight:900;letter-spacing:-.03em;font-size:23px}.brand span{color:var(--leaf)}.nav a{color:var(--ink);text-decoration:none;font-weight:750;margin-left:26px}.nav .mini{background:#17231f;color:white;padding:12px 18px;border-radius:999px}.hero{min-height:790px;display:grid;grid-template-columns:1.02fr .98fr;gap:48px;align-items:center;padding:88px 0 58px}.eyebrow{display:inline-flex;align-items:center;gap:8px;padding:9px 14px;border-radius:999px;background:#ecf8e8;color:#157a24;font-weight:850;font-size:14px;border:1px solid rgba(40,185,0,.18)}h1{font-size:72px;line-height:.94;margin:22px 0 22px;letter-spacing:-.07em} .sub{font-size:22px;color:var(--muted);max-width:640px}.cta-row{display:flex;gap:16px;align-items:center;margin:34px 0 24px}.btn{display:inline-flex;align-items:center;justify-content:center;border-radius:999px;padding:18px 28px;font-weight:900;text-decoration:none;box-shadow:0 14px 28px rgba(40,185,0,.18)}.primary{background:var(--leaf);color:white}.secondary{background:white;color:var(--ink);border:1px solid rgba(23,35,31,.12);box-shadow:none}.trustline{display:flex;gap:18px;flex-wrap:wrap;color:#53645c;font-weight:750;font-size:15px}.phone-scene{position:relative;min-height:600px}.phone{position:absolute;right:40px;top:16px;width:330px;height:640px;border-radius:48px;background:#182521;padding:16px;box-shadow:0 28px 80px rgba(23,35,31,.25);transform:rotate(4deg)}.screen{height:100%;border-radius:36px;background:linear-gradient(180deg,#eaf4ff 0%,#f7fbf3 56%,#eaf8e3 100%);padding:25px;overflow:hidden}.screen h3{font-size:20px;margin:0 0 18px}.plant-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.plant{background:rgba(255,255,255,.82);border-radius:22px;padding:14px;min-height:145px;box-shadow:0 8px 20px rgba(23,35,31,.08)}.sprout{height:70px;border-radius:18px;background:radial-gradient(circle at 50% 18%,#49d660 0 18px,transparent 19px),linear-gradient(90deg,transparent 48%,#3a9d35 49% 53%,transparent 54%),radial-gradient(circle at 35% 58%,#7edb5b 0 22px,transparent 23px),radial-gradient(circle at 65% 56%,#49bf4c 0 21px,transparent 22px);background-color:#f6efe2}.plant strong{display:block;margin-top:8px}.plant small{color:var(--muted);font-weight:700}.bubble{position:absolute;background:white;border-radius:24px;box-shadow:var(--shadow);padding:18px 22px;font-weight:850}.bubble.one{left:0;top:76px}.bubble.two{right:0;bottom:38px}.bubble.three{left:12px;bottom:145px;background:#17231f;color:white}.section{padding:88px 0}.split{display:grid;grid-template-columns:.9fr 1.1fr;gap:48px;align-items:center}.label{font-size:14px;text-transform:uppercase;letter-spacing:.14em;font-weight:900;color:#157a24}h2{font-size:48px;line-height:1.02;letter-spacing:-.055em;margin:14px 0 18px}.lead{font-size:20px;color:var(--muted)}.benefits{display:grid;gap:18px}.benefit{background:white;border:1px solid rgba(23,35,31,.08);border-radius:24px;padding:24px;box-shadow:0 10px 32px rgba(23,35,31,.07)}.benefit b{font-size:20px}.benefit p{margin:7px 0 0;color:var(--muted);font-size:17px}.proof-band{background:#17231f;color:#fff;border-radius:38px;padding:42px;display:grid;grid-template-columns:repeat(3,1fr);gap:20px;box-shadow:0 20px 60px rgba(23,35,31,.20)}.stat{border-right:1px solid rgba(255,255,255,.16);padding-right:22px}.stat:last-child{border-right:0}.stat strong{font-size:46px;display:block}.stat span{color:#d8e6da;font-weight:750}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:34px}.quote{background:white;border-radius:28px;padding:26px;box-shadow:var(--shadow);border:1px solid rgba(23,35,31,.08)}.quote p{font-size:17px;color:#43544c}.quote b{display:block;margin-top:18px}.purchase{background:linear-gradient(135deg,#ecf8e8,#fffaf1);border-radius:44px;padding:56px;display:grid;grid-template-columns:1fr 380px;gap:32px;align-items:center;border:1px solid rgba(40,185,0,.18)}.price{background:white;border-radius:34px;padding:30px;box-shadow:var(--shadow)}.price .num{font-size:52px;font-weight:950;letter-spacing:-.05em}.check{display:block;margin:12px 0;color:#3f5148;font-weight:750}.final{padding:92px 0 110px;text-align:center}.final h2{font-size:56px;max-width:820px;margin:14px auto}.final .lead{max-width:720px;margin:auto}.footer{padding:34px 0;color:var(--muted);border-top:1px solid rgba(23,35,31,.08)}@media(max-width:900px){.hero,.split,.purchase{grid-template-columns:1fr}.phone-scene{min-height:650px}h1{font-size:52px}.cards,.proof-band{grid-template-columns:1fr}.stat{border-right:0;border-bottom:1px solid rgba(255,255,255,.16);padding-bottom:18px}}

</style>
<div class="gg-purchase-page">

<header class="topbar"><div class="wrap nav"><div class="brand">Goal <span>Grower</span></div><nav><a href="#benefits">Benefits</a><a href="#proof">Reviews</a><a href="#buy" class="mini">Support the Build</a></nav></div></header>
<main>
<section class="wrap hero" id="hero">
  <div>
    <div class="eyebrow">🌱 Purchase stage landing page • Fund the launch</div>
    <h1>Help launch the habit app that turns goals into a garden.</h1>
    <p class="sub">Support Goal Grower today and help fund testing, polish, and launch-ready features for a calmer, more motivating way to build habits.</p>
    <div class="cta-row"><a class="btn primary" href="#buy">Shop to Support</a><a class="btn secondary" href="#proof">See why it matters</a></div>
    <div class="trustline"><span>✓ Secure checkout</span><span>✓ Supports development</span><span>✓ Built by Ziyu Development</span></div>
  </div>
  <div class="phone-scene" aria-label="Goal Grower app preview">
    <div class="bubble one">Goals feel alive, not overwhelming.</div><div class="bubble three">Every order waters the build.</div><div class="bubble two">Launch support starts here →</div>
    <div class="phone"><div class="screen"><h3>Today’s Garden</h3><div class="plant-grid"><div class="plant"><div class="sprout"></div><strong>Chinese</strong><small>5 day streak</small></div><div class="plant"><div class="sprout"></div><strong>Run</strong><small>Watered today</small></div><div class="plant"><div class="sprout"></div><strong>Read</strong><small>2 pages left</small></div><div class="plant"><div class="sprout"></div><strong>Pray</strong><small>Evening plan</small></div></div></div></div>
  </div>
</section>
<section class="wrap section split" id="benefits">
  <div><div class="label">Unique Selling Proposition</div><h2>A habit tracker with emotion, accountability, and a real reason to come back.</h2><p class="lead">Most goal apps feel like chores. Goal Grower makes progress visible by turning each goal into something you care about: a plant that grows when you show up.</p></div>
  <div class="benefits"><div class="benefit"><b>Feel motivated faster.</b><p>Progress becomes visual, so users can see effort turning into growth instead of staring at a plain checklist.</p></div><div class="benefit"><b>Stay consistent without pressure.</b><p>Gentle reminders and simple daily actions reduce overwhelm and help users restart after missed days.</p></div><div class="benefit"><b>Build goals with others.</b><p>Shared gardens make accountability more encouraging because progress can be supported by friends or family.</p></div></div>
</section>
<section class="wrap section" id="proof">
  <div class="proof-band"><div class="stat"><strong>3</strong><span>core outcomes: clarity, consistency, accountability</span></div><div class="stat"><strong>42</strong><span>day progress grid keeps growth visible</span></div><div class="stat"><strong>1</strong><span>focused purchase goal: support the launch</span></div></div>
  <div class="cards"><div class="quote"><p>“The garden idea makes habits feel less stressful and more fun. I would actually want to check in every day.”</p><b>— Beta tester</b></div><div class="quote"><p>“I like that the page explains what my purchase supports. It feels more personal than a normal shop page.”</p><b>— Early supporter</b></div><div class="quote"><p>“The shared garden idea gives me a reason to invite someone instead of doing goals alone.”</p><b>— Student user</b></div></div>
</section>
<section class="wrap section purchase" id="buy">
  <div><div class="label">Purchase-stage message match</div><h2>Ready to support Goal Grower?</h2><p class="lead">This page matches a “Support development” ad or link by immediately explaining what the purchase funds and why the visitor should act now.</p><a class="btn primary" href="/collections/all">Shop to Support Goal Grower</a></div>
  <div class="price"><div class="label">Support Impact</div><div class="num">100%</div><p class="lead">of the message focuses on helping the app launch stronger.</p><span class="check">✓ Development polish</span><span class="check">✓ Testing improvements</span><span class="check">✓ Better launch experience</span></div>
</section>
<section class="wrap final">
  <div class="label">Final Call-to-Action</div><h2>Help the garden grow before launch.</h2><p class="lead">A clear closing CTA gives purchase-ready visitors one final low-friction path to act after reading the benefits and trust signals.</p><div class="cta-row" style="justify-content:center"><a class="btn primary" href="/collections/all">Support the Build</a></div>
</section>
</main><footer class="footer"><div class="wrap">© Ziyu Development • Goal Grower purchase landing page</div></footer>
