{% comment %}
Goal Grower Purchase Landing Page
Shopify section for a purchase-stage landing page.
Built for visitors who are ready to support Goal Grower / Ziyu Development.
{% endcomment %}

<div class="gg-purchase-page">

  <header class="gg-topbar">
    <div class="gg-wrap gg-nav">
      <div class="gg-brand">
        Goal <span>Grower</span>
      </div>

      <nav class="gg-nav-links">
        <a href="#gg-benefits">Benefits</a>
        <a href="#gg-proof">Reviews</a>
        <a href="#gg-buy" class="gg-mini">Support the Build</a>
      </nav>
    </div>
  </header>

  <main>

    <!-- HERO SECTION / ABOVE THE FOLD -->
    <section class="gg-wrap gg-hero" id="gg-hero">
      <div class="gg-hero-copy">
        <div class="gg-eyebrow">
          🌱 Purchase stage landing page • Fund the launch
        </div>

        <h1>
          Help launch the habit app that turns goals into a garden.
        </h1>

        <p class="gg-sub">
          Support Goal Grower today and help fund testing, polish, and launch-ready features for a calmer, more motivating way to build habits.
        </p>

        <div class="gg-cta-row">
          <a class="gg-btn gg-primary" href="#gg-buy">
            Shop to Support
          </a>

          <a class="gg-btn gg-secondary" href="#gg-proof">
            See why it matters
          </a>
        </div>

        <div class="gg-trustline">
          <span>✓ Secure checkout</span>
          <span>✓ Supports development</span>
          <span>✓ Built by Ziyu Development</span>
        </div>
      </div>

      <div class="gg-phone-scene" aria-label="Goal Grower app preview">
        <div class="gg-bubble gg-one">
          Goals feel alive, not overwhelming.
        </div>

        <div class="gg-bubble gg-three">
          Every order waters the build.
        </div>

        <div class="gg-bubble gg-two">
          Launch support starts here →
        </div>

        <div class="gg-phone">
          <div class="gg-screen">
            <h3>Today’s Garden</h3>

            <div class="gg-plant-grid">
              <div class="gg-plant">
                <div class="gg-sprout"></div>
                <strong>Chinese</strong>
                <small>5 day streak</small>
              </div>

              <div class="gg-plant">
                <div class="gg-sprout"></div>
                <strong>Run</strong>
                <small>Watered today</small>
              </div>

              <div class="gg-plant">
                <div class="gg-sprout"></div>
                <strong>Read</strong>
                <small>2 pages left</small>
              </div>

              <div class="gg-plant">
                <div class="gg-sprout"></div>
                <strong>Pray</strong>
                <small>Evening plan</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- USP + BENEFITS -->
    <section class="gg-wrap gg-section gg-split" id="gg-benefits">
      <div>
        <div class="gg-label">
          Unique Selling Proposition
        </div>

        <h2>
          A habit tracker with emotion, accountability, and a real reason to come back.
        </h2>

        <p class="gg-lead">
          Most goal apps feel like chores. Goal Grower makes progress visible by turning each goal into something you care about: a plant that grows when you show up.
        </p>
      </div>

      <div class="gg-benefits">
        <div class="gg-benefit">
          <b>Feel motivated faster.</b>
          <p>
            Progress becomes visual, so users can see effort turning into growth instead of staring at a plain checklist.
          </p>
        </div>

        <div class="gg-benefit">
          <b>Stay consistent without pressure.</b>
          <p>
            Gentle reminders and simple daily actions reduce overwhelm and help users restart after missed days.
          </p>
        </div>

        <div class="gg-benefit">
          <b>Build goals with others.</b>
          <p>
            Shared gardens make accountability more encouraging because progress can be supported by friends or family.
          </p>
        </div>
      </div>
    </section>

    <!-- TRUST + SOCIAL PROOF -->
    <section class="gg-wrap gg-section" id="gg-proof">
      <div class="gg-proof-band">
        <div class="gg-stat">
          <strong>3</strong>
          <span>core outcomes: clarity, consistency, accountability</span>
        </div>

        <div class="gg-stat">
          <strong>42</strong>
          <span>day progress grid keeps growth visible</span>
        </div>

        <div class="gg-stat">
          <strong>1</strong>
          <span>focused purchase goal: support the launch</span>
        </div>
      </div>

      <div class="gg-cards">
        <div class="gg-quote">
          <p>
            “The garden idea makes habits feel less stressful and more fun. I would actually want to check in every day.”
          </p>
          <b>— Beta tester</b>
        </div>

        <div class="gg-quote">
          <p>
            “I like that the page explains what my purchase supports. It feels more personal than a normal shop page.”
          </p>
          <b>— Early supporter</b>
        </div>

        <div class="gg-quote">
          <p>
            “The shared garden idea gives me a reason to invite someone instead of doing goals alone.”
          </p>
          <b>— Student user</b>
        </div>
      </div>
    </section>

    <!-- PURCHASE CTA -->
    <section class="gg-wrap gg-section gg-purchase" id="gg-buy">
      <div>
        <div class="gg-label">
          Purchase-stage message match
        </div>

        <h2>
          Ready to support Goal Grower?
        </h2>

        <p class="gg-lead">
          This page matches a “Support development” ad or link by immediately explaining what the purchase funds and why the visitor should act now.
        </p>

        <a class="gg-btn gg-primary" href="/collections/all">
          Shop to Support Goal Grower
        </a>
      </div>

      <div class="gg-price">
        <div class="gg-label">
          Support Impact
        </div>

        <div class="gg-num">
          100%
        </div>

        <p class="gg-lead">
          of the message focuses on helping the app launch stronger.
        </p>

        <span class="gg-check">✓ Development polish</span>
        <span class="gg-check">✓ Testing improvements</span>
        <span class="gg-check">✓ Better launch experience</span>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="gg-wrap gg-final">
      <div class="gg-label">
        Final Call-to-Action
      </div>

      <h2>
        Help the garden grow before launch.
      </h2>

      <p class="gg-lead">
        A clear closing CTA gives purchase-ready visitors one final low-friction path to act after reading the benefits and trust signals.
      </p>

      <div class="gg-cta-row">
        <a class="gg-btn gg-primary" href="/collections/all">
          Support the Build
        </a>
      </div>
    </section>

  </main>

  <footer class="gg-footer">
    <div class="gg-wrap">
      © Ziyu Development • Goal Grower purchase landing page
    </div>
  </footer>

</div>

